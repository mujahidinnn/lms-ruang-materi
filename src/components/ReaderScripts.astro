---
// Reading progress (the line in ReaderHeader) and the active entry in
// "Di bab ini" ([data-toc] links), both from the scroll position.
---

<script>
  const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const article = document.querySelector<HTMLElement>("[data-article]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a")];
  const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter((x): x is HTMLElement => !!x);
  let ticking = false;
  function update() {
    ticking = false;
    if (bar && article) {
      const r = article.getBoundingClientRect();
      const done = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / Math.max(1, r.height - innerHeight * 0.4)));
      bar.style.transform = `scaleX(${done})`;
    }
    // The last section whose top has passed a line a third down the screen.
    let current = targets[0]?.id;
    for (const t of targets) if (t.getBoundingClientRect().top < innerHeight / 3) current = t.id;
    // At the very bottom a short last section never reaches that line.
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = targets.at(-1)?.id ?? current;
    for (const a of links) {
      if (a.hash === `#${current}`) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener("resize", update);
  update();
</script>

<script>
  // Simulations embedded with ![judul](sim:nama): mount when scrolled near.
  import { createElement } from "react";
  import { createRoot } from "react-dom/client";
  import { sims } from "../../components/belajar/sim";

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const load = sims[el.dataset.sim ?? ""];
      if (!load) continue;
      load().then(({ default: Sim }) => {
        el.className = "block";
        createRoot(el).render(createElement(Sim, { title: el.dataset.title || "Simulasi" }));
      });
    }
  }, { rootMargin: "300px" });
  document.querySelectorAll("[data-sim]").forEach((el) => io.observe(el));
</script>
