---
// Reading progress (the line in ReaderHeader) and the active entry in
// "Di bab ini" ([data-toc] links), both from the scroll position.
---

<script>
  const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
  const article = document.querySelector<HTMLElement>("[data-article]");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a")];
  const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter((x): x is HTMLElement => !!x);
  let ticking = false;
  function update() {
    ticking = false;
    if (bar && article) {
      const r = article.getBoundingClientRect();
      const done = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / Math.max(1, r.height - innerHeight * 0.4)));
      bar.style.transform = `scaleX(${done})`;
    }
    // The last section whose top has passed a line a third down the screen.
    let current = targets[0]?.id;
    for (const t of targets) if (t.getBoundingClientRect().top < innerHeight / 3) current = t.id;
    for (const a of links) {
      if (a.hash === `#${current}`) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    }
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener("resize", update);
  update();
</script>
