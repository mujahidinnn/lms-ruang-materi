---
import { ChevronDown } from "lucide-react";

// One foldable editor section on /admin/topik/[slug], with its anchor id.
type Props = { id: string; title: string; note?: string; count?: number; open?: boolean };
const { id, title, note, count, open = false } = Astro.props;
---

<details id={id} open={open} class="group scroll-mt-6">
  <summary class="flex min-h-12 cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 border-b border-zinc-800/80 pb-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
    <ChevronDown aria-hidden className="size-5 shrink-0 text-zinc-500 transition-transform group-not-open:-rotate-90 motion-reduce:transition-none" />
    <h2 class="text-xl font-bold tracking-tight">{title}</h2>
    {count !== undefined && <span class="rounded-full bg-zinc-800 px-2 text-xs tabular-nums text-zinc-400">{count}</span>}
    {note && <p class="ml-auto text-sm text-zinc-500 max-sm:hidden">{note}</p>}
  </summary>
  <div class="pt-3"><slot /></div>
</details>

<script>
  // The side list and links like /admin/topik/x#ujian point at a section that
  // may be folded: open it, then scroll to it.
  const reveal = () => {
    const target = document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement && !target.open) {
      target.open = true;
      target.scrollIntoView();
    }
  };
  reveal();
  addEventListener("hashchange", reveal);
</script>
