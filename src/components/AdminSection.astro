---
// One editor section on /admin/topik/[slug], with its anchor id.
type Props = { id: string; title: string; note?: string };
const { id, title, note } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-judul`} class="scroll-mt-6">
  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 border-b border-zinc-800/80 pb-2">
    <h2 id={`${id}-judul`} class="text-xl font-bold tracking-tight">{title}</h2>
    {note && <p class="text-sm text-zinc-500">{note}</p>}
  </div>
  <slot />
</section>
