---
import Logo from "@/components/brand/Logo";
import SideNav, { type NavSet } from "@/components/app/SideNav";
import SignOutButton from "./SignOutButton.astro";
import ThemeButton from "./ThemeButton.astro";

// Signed-in screens: a white sidebar on the left from lg, a top bar with a
// scrolling link row on phones. The page passes the signed-in email.
type Props = { set: NavSet; email: string };
const { set, email } = Astro.props;
---

<div class="flex flex-1 flex-col lg:flex-row">
  <aside class="flex flex-wrap items-center gap-x-4 gap-y-3 bg-zinc-900 px-4 py-3 shadow-soft lg:sticky lg:top-0 lg:h-dvh lg:w-64 lg:shrink-0 lg:flex-col lg:flex-nowrap lg:items-stretch lg:gap-8 lg:px-4 lg:py-6">
    <a href="/" aria-label="Ruang Materi, beranda" class="flex items-center gap-2 rounded-full px-2 focus-visible:outline-2 focus-visible:outline-accent">
      <Logo />
      {set === "admin" && <span class="rounded-full bg-tile-lavender px-2.5 py-0.5 text-xs font-medium">admin</span>}
    </a>
    <div class="ml-auto flex items-center gap-2 lg:order-last lg:mt-auto lg:ml-0 lg:flex-col lg:items-stretch">
      <div class="flex items-center gap-2 text-sm lg:flex-col lg:items-stretch">
        <span class="hidden truncate px-4 text-zinc-500 lg:block">{email}</span>
        <SignOutButton class="min-h-11 w-full rounded-2xl px-4 text-left text-zinc-400 hover:bg-zinc-800 hover:text-zinc-50 focus-visible:outline-2 focus-visible:outline-accent" />
      </div>
      <div class="lg:px-2"><ThemeButton /></div>
    </div>
    {/* Second row on phones, under brand and Keluar. */}
    <div class="order-last w-full lg:order-none">
      <SideNav set={set} path={Astro.url.pathname} />
    </div>
  </aside>
  <main class="w-full min-w-0 flex-1 px-4 py-8 sm:px-8 lg:py-10"><slot /></main>
</div>
