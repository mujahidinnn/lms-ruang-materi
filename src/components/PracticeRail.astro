---
import { ArrowRight, BookOpen } from "lucide-react";

// Beside Latihan ujian and the simulation: what this mode is, and the next
// step (the final exam) with a way back to the class.
type Props = { slug: string; title: string; count: number; mode: "latihan" | "persiapan"; hasExam: boolean; passScore?: number | null };
const { slug, title, count, mode, hasExam, passScore } = Astro.props;
---

<aside class="grid gap-6 lg:sticky lg:top-6">
  <section class="rounded-[28px] bg-zinc-900 p-6 shadow-soft">
    <p class="flex items-center gap-2 text-sm text-zinc-400"><BookOpen aria-hidden className="size-4" />Kelas</p>
    <a href={`/belajar/${slug}`} class="mt-1 block text-xl font-bold tracking-tight hover:text-accent">{title}</a>
    <p class="mt-4 text-sm leading-relaxed text-zinc-300">
      {mode === "latihan"
        ? `${count} soal latihan. Kunci dan pembahasan muncul begitu kamu menjawab. Tanpa waktu, boleh diulang.`
        : `20 soal acak dari ${count} soal, dinilai seperti ujian${passScore ? ` dengan nilai lulus ${passScore}` : ""}. Tidak memakai jatah percobaan.`}
    </p>
  </section>
  {hasExam && (
    <a href={`/ujian/${slug}`} class="group flex items-end gap-4 overflow-hidden rounded-[28px] border-2 border-noir bg-matcha-300 px-6 pt-6 text-noir">
      <span class="pb-6">
        <span class="block text-sm font-semibold">Sudah siap?</span>
        <span class="mt-1 flex items-center gap-1 text-xl font-extrabold">Ujian akhir <ArrowRight aria-hidden className="size-5 transition-transform group-hover:translate-x-1" /></span>
      </span>
      <img src="/ilustrasi/ujian.svg" alt="" width="890" height="1220" loading="lazy" class="ml-auto h-32 w-auto" />
    </a>
  )}
</aside>
