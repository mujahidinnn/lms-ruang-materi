---
import { ChevronLeft } from "lucide-react";
import { LogoMark } from "@/components/brand/Logo";
import ThemeButton from "./ThemeButton.astro";

// The chapter page's slim sticky bar: back to the class, where you are, and
// a reading-progress line (driven by src/components/ReaderScripts.astro).
type Props = { topicSlug: string; topicTitle: string; label: string };
const { topicSlug, topicTitle, label } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-zinc-800 bg-zinc-950/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
    <a href="/" aria-label="Ruang Materi, beranda" class="shrink-0 rounded-xl focus-visible:outline-2 focus-visible:outline-accent"><LogoMark className="size-9 -rotate-6" /></a>
    <a href={`/belajar/${topicSlug}`} class="inline-flex min-h-11 min-w-0 items-center gap-1 rounded-full px-2 text-sm font-semibold text-zinc-300 hover:text-zinc-50">
      <ChevronLeft aria-hidden className="size-4 shrink-0" /><span class="truncate">{topicTitle}</span>
    </a>
    <p class="ml-auto hidden truncate text-sm text-zinc-400 md:block">{label}</p>
    <div class="ml-auto shrink-0 md:ml-2"><ThemeButton /></div>
  </div>
  <div aria-hidden="true" class="h-1 bg-transparent">
    <div data-reading-progress class="h-full w-full origin-left scale-x-0 bg-matcha-400"></div>
  </div>
</header>
