---
import { LogOut } from "lucide-react";

type Props = { class: string };
---

{/* Clears the service worker's page cache before signing out, so the next
    person on a shared phone sees nothing of this learner. */}
<form method="post" action="/rpc/keluar" data-sign-out>
  <button class:list={["inline-flex items-center gap-2", Astro.props.class]}>
    <LogOut aria-hidden className="size-4" />
    Keluar
  </button>
</form>

<script>
  document.querySelector("[data-sign-out]")?.addEventListener("submit", () => {
    navigator.serviceWorker?.controller?.postMessage("clear-pages");
  });
</script>
