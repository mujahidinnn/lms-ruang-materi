---
import { LogOut } from "lucide-react";

// label: keep the word visible on phones too (the admin drawer does).
type Props = { class: string; label?: boolean; all?: boolean };
const all = Astro.props.all;
---

{/* Clears the service worker's page cache before signing out, so the next
    person on a shared phone sees nothing of this learner. */}
<form
  method="post"
  action={all ? "/rpc/keluarSemua" : "/rpc/keluar"}
  data-sign-out
  data-confirm={all ? "Keluar dari semua perangkat?" : "Keluar dari akun?"}
  data-confirm-text={all ? "Semua perangkat dan browser yang masih masuk dengan akun ini ikut keluar, termasuk yang ini. Progresmu tetap aman." : "Progres yang sudah tersimpan tetap aman. Masuk lagi kapan saja dengan email yang sama."}
  data-confirm-action="Keluar"
>
  <button class:list={["inline-flex items-center gap-2", Astro.props.class]}>
    <LogOut aria-hidden className="size-4" />
    <span class:list={[!Astro.props.label && !all && "max-sm:sr-only"]}>{all ? "Keluar dari semua perangkat" : "Keluar"}</span>
  </button>
</form>

<script>
  document.querySelectorAll("[data-sign-out]").forEach((f) =>
    f.addEventListener("submit", () => {
      navigator.serviceWorker?.controller?.postMessage("clear-pages");
    }),
  );
</script>
