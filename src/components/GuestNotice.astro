---
import { CloudOff, LogIn, X } from "lucide-react";

// For guests on learning pages: progress, quiz answers and code passes are
// not saved until they sign in. Hidden for signed-in visitors by the
// signed-in: variant (cached pages), closable for the browser session.
// embedded: inside a header that is already sticky (ReaderHeader).
type Props = { embedded?: boolean };
const next = Astro.url.pathname + Astro.url.search;
---

<div data-guest-notice class:list={["px-3 signed-in:hidden", Astro.props.embedded ? "pb-2" : "sticky top-0 z-30 pt-2"]}>
  <div role="status" class="mx-auto flex max-w-5xl items-center gap-3 rounded-2xl border-2 border-noir bg-tile-butter px-4 py-2.5 text-sm text-noir shadow-soft">
    <CloudOff aria-hidden className="size-5 shrink-0" />
    <p class="min-w-0 flex-1 leading-snug"><strong>Belum masuk.</strong> Progresmu tidak tersimpan<span class="hidden sm:inline">: bab, kuis, dan latihan kode</span>.</p>
    <a href={`/masuk?next=${encodeURIComponent(next)}`} class="inline-flex min-h-10 shrink-0 items-center gap-1.5 rounded-full bg-noir px-4 font-bold text-on-noir"><LogIn aria-hidden className="size-4" />Masuk</a>
    <button type="button" data-guest-close aria-label="Tutup peringatan" class="grid size-9 shrink-0 place-items-center rounded-full hover:bg-black/10"><X aria-hidden className="size-4" /></button>
  </div>
</div>

<script>
  const KEY = "ruang-materi:tutup-peringatan-tamu";
  const box = document.querySelector<HTMLElement>("[data-guest-notice]");
  try { if (sessionStorage.getItem(KEY)) box?.remove(); } catch {}
  document.querySelector("[data-guest-close]")?.addEventListener("click", () => {
    box?.remove();
    try { sessionStorage.setItem(KEY, "1"); } catch {}
  });
</script>
