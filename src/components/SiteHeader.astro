---
import Logo from "@/components/brand/Logo";
import AccountLink from "./AccountLink.astro";
import MobileNav from "./MobileNav.astro";
import ThemeButton from "./ThemeButton.astro";

const LINKS = [
  { href: "/kelas", label: "Kelas" },
  { href: "/roadmap", label: "Roadmap" },
];
---

<header class="px-5 sm:px-10">
  <div class="mx-auto flex max-w-7xl items-center gap-3 py-5">
    <a href="/" aria-label="Ruang Materi, beranda" class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <Logo />
    </a>
    <nav aria-label="Utama" class="ml-auto hidden items-center gap-1 rounded-full bg-zinc-900 p-1.5 text-sm shadow-soft sm:flex">
      {LINKS.map((l) => (
        <a href={l.href} class="flex min-h-10 items-center rounded-full px-4 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-50">{l.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2 sm:ml-0">
      <ThemeButton />
      <AccountLink />
    </div>
  </div>
  <MobileNav />
</header>
