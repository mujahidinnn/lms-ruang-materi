---
import { Code2, Rocket, Search } from "lucide-react";
import Logo from "@/components/brand/Logo";
import AccountLink from "./AccountLink.astro";
import GuestNotice from "./GuestNotice.astro";
import InstallApp from "./InstallApp.astro";
import MobileMore from "./MobileMore.astro";
import MobileNav from "./MobileNav.astro";
import MusicButton from "./MusicButton.astro";
import ThemeButton from "./ThemeButton.astro";

// The one header for learners, signed in or not (GUIDELINE, Navigation).
// focus: a quiz or exam page, no phone nav competing with the answers.
// learning: a page where guests lose progress, so they get GuestNotice.
type Props = { focus?: boolean; learning?: boolean };
const { focus = false, learning = false } = Astro.props;
const path = Astro.url.pathname;
const LINKS = [
  { href: "/kelas", label: "Kelas", on: path.startsWith("/kelas") || path.startsWith("/belajar") },
  { href: "/roadmap", label: "Roadmap", on: path.startsWith("/roadmap") },
  { href: "/playground", label: "Playground", on: path.startsWith("/playground"), Icon: Code2 },
  { href: "/studio-proyek", label: "Studio Proyek", on: path.startsWith("/studio-proyek"), Icon: Rocket },
  { href: "/dasbor", label: "Dashboard", on: ["/dasbor", "/nilai", "/profil", "/flashcard"].some((p) => path.startsWith(p)), signedIn: true },
];
---

{learning && <GuestNotice />}
<header class="px-5 sm:px-10">
  <div class="mx-auto flex max-w-7xl items-center gap-2 py-5 lg:gap-3">
    <a href="/" aria-label="Ruang Materi, beranda" class="rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <Logo />
    </a>
    <nav aria-label="Utama" class="ml-auto hidden items-center gap-1 rounded-full bg-zinc-900 p-1 text-sm shadow-soft min-[840px]:flex lg:p-1.5">
      {LINKS.map((l) => (
        <a
          href={l.href}
          aria-current={l.on ? "page" : undefined}
          class:list={[
            "min-h-10 items-center justify-center whitespace-nowrap rounded-full px-2 text-[0.8125rem] font-medium lg:px-4 lg:text-sm",
            l.signedIn ? "hidden signed-in:flex" : "flex",
            l.on ? "bg-primary text-on-primary" : "text-zinc-400 hover:bg-zinc-800 hover:text-zinc-50",
          ]}
        >{l.Icon ? (<><l.Icon aria-hidden className="size-4 xl:hidden" /><span class="max-xl:sr-only">{l.label}</span></>) : l.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2 min-[840px]:ml-0">
      <a href="/cari" aria-label="Cari materi" class="grid size-11 place-items-center rounded-full bg-zinc-900 text-zinc-300 shadow-soft hover:bg-zinc-800 hover:text-zinc-50 focus-visible:outline-2 focus-visible:outline-accent"><Search aria-hidden className="size-5" /></a>
      <div class="flex items-center gap-2 max-sm:hidden">
        <InstallApp />
        <MusicButton />
        <ThemeButton />
      </div>
      <MobileMore />
      <AccountLink />
    </div>
  </div>
  {!focus && <MobileNav />}
</header>
