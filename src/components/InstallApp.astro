---
import { Download } from "lucide-react";

// "Pasang aplikasi": Chrome and Edge offer the PWA install prompt; iOS
// Safari has none, so it explains Share > Add to Home Screen. Hidden when
// the app is already installed or the browser cannot install it.
---

<button type="button" data-install hidden class="inline-flex min-h-11 items-center gap-2 rounded-full bg-zinc-900 px-4 text-sm font-semibold shadow-soft hover:bg-zinc-800">
  <Download aria-hidden className="size-4" /><span class="hidden lg:inline">Pasang aplikasi</span><span class="sr-only lg:hidden">Pasang aplikasi</span>
</button>

<script>
  import { confirmDialog } from "@/lib/confirm";

  type InstallPrompt = Event & { prompt(): Promise<void>; userChoice: Promise<{ outcome: string }> };
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-install]")];
  const standalone = matchMedia("(display-mode: standalone)").matches || (navigator as { standalone?: boolean }).standalone;
  const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);
  let deferred: InstallPrompt | null = null;
  const show = (on: boolean) => buttons.forEach((b) => (b.hidden = !on));

  if (!standalone) {
    show(ios);
    addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferred = e as InstallPrompt;
      show(true);
    });
    addEventListener("appinstalled", () => show(false));
    buttons.forEach((b) =>
      b.addEventListener("click", async () => {
        if (deferred) {
          await deferred.prompt();
          if ((await deferred.userChoice).outcome === "accepted") show(false);
          deferred = null;
          return;
        }
        await confirmDialog({
          title: "Pasang di iPhone atau iPad",
          text: "Ketuk tombol Bagikan di Safari, lalu pilih Tambahkan ke Layar Utama. Ruang Materi terbuka seperti aplikasi, tanpa bilah browser.",
          action: "Mengerti",
          cancel: "Tutup",
        });
      })
    );
  }
</script>
