---
import { BookOpen, Home, LogIn, Route, UserRound } from "lucide-react";

// Phones: the same places as the header, labelled, within thumb reach.
// globals.css pads the body while it is on screen. The last item is Masuk
// or Saya, picked by the signed-in: variant.
const path = Astro.url.pathname;
const items = [
  { href: "/", label: "Beranda", Icon: Home, on: path === "/", show: "flex" },
  { href: "/kelas", label: "Kelas", Icon: BookOpen, on: path.startsWith("/kelas") || path.startsWith("/belajar"), show: "flex" },
  { href: "/roadmap", label: "Jalur", Icon: Route, on: path.startsWith("/roadmap"), show: "flex" },
  { href: "/dasbor", label: "Saya", Icon: UserRound, on: ["/dasbor", "/nilai", "/profil", "/flashcard"].some((p) => path.startsWith(p)), show: "hidden signed-in:flex" },
  { href: "/masuk", label: "Masuk", Icon: LogIn, on: path.startsWith("/masuk"), show: "flex signed-in:hidden" },
];
---

<nav
  aria-label="Navigasi utama"
  data-mobile-nav
  class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-50 mx-auto flex max-w-md justify-around gap-1 rounded-[28px] bg-zinc-900/95 p-1.5 shadow-soft ring-1 ring-zinc-800 backdrop-blur md:hidden"
>
  {items.map(({ href, label, Icon, on, show }) => (
    <a
      href={href}
      aria-current={on ? "page" : undefined}
      class={`${show} min-h-14 flex-1 flex-col items-center justify-center gap-0.5 rounded-[22px] text-[11px] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-accent ${on ? "bg-primary text-on-primary" : "text-zinc-400 hover:text-zinc-50"}`}
    >
      <Icon aria-hidden className="size-5" />{label}
    </a>
  ))}
</nav>
