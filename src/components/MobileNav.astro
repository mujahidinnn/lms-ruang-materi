---
import { BookOpen, Home, Layers, LayoutDashboard, LogIn, Route } from "lucide-react";

// Phones: the main links as a floating pill at the bottom, within thumb reach.
// globals.css pads the body while it is on screen. The last item is Masuk or
// Dasbor, picked by the signed-in: variant.
const path = Astro.url.pathname;
const items = [
  { href: "/", label: "Beranda", Icon: Home, on: path === "/", show: "grid" },
  { href: "/kelas", label: "Kelas", Icon: BookOpen, on: path.startsWith("/kelas") || path.startsWith("/belajar"), show: "grid" },
  { href: "/roadmap", label: "Roadmap", Icon: Route, on: path.startsWith("/roadmap"), show: "grid" },
  { href: "/flashcard", label: "Flashcard", Icon: Layers, on: path.startsWith("/flashcard"), show: "grid" },
  { href: "/dasbor", label: "Dasbor", Icon: LayoutDashboard, on: ["/dasbor", "/nilai", "/profil"].some((p) => path.startsWith(p)), show: "hidden signed-in:grid" },
  { href: "/masuk", label: "Masuk", Icon: LogIn, on: path.startsWith("/masuk"), show: "grid signed-in:hidden" },
];
---

<nav
  aria-label="Navigasi utama"
  data-mobile-nav
  class="fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 mx-auto flex w-fit gap-2 rounded-full bg-zinc-900/90 p-2 shadow-soft backdrop-blur sm:hidden"
>
  {items.map(({ href, label, Icon, on, show }) => (
    <a
      href={href}
      aria-label={label}
      aria-current={on ? "page" : undefined}
      class={`${show} size-12 place-items-center rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-accent ${on ? "bg-primary text-on-primary" : "bg-zinc-800 text-zinc-400 hover:text-zinc-50"}`}
    >
      <Icon aria-hidden className="size-5" />
    </a>
  ))}
</nav>
