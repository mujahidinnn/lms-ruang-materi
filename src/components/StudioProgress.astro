---
// Overall progress bar, updated by the checklists through an event.
const { total, done } = Astro.props as { total: number; done: number };
---

<div data-studio-progress data-total={total} data-done={done}>
  <div class="flex items-baseline justify-between gap-3 text-sm">
    <span class="font-semibold">Progres proyek</span>
    <span class="tabular-nums text-zinc-400"><span data-count>{done}</span> dari {total} butir</span>
  </div>
  <span aria-hidden="true" class="mt-2 block h-2.5 rounded-full bg-zinc-800"><span data-bar class="block h-full rounded-full bg-brand transition-[width] duration-500 motion-reduce:transition-none" style={{ width: `${Math.round((done / total) * 100)}%` }}></span></span>
</div>

<script>
  const box = document.querySelector<HTMLElement>("[data-studio-progress]");
  if (box) {
    const total = Number(box.dataset.total);
    let done = Number(box.dataset.done);
    addEventListener("studio-centang", (e) => {
      done += (e as CustomEvent<{ on: boolean }>).detail.on ? 1 : -1;
      box.querySelector("[data-count]")!.textContent = String(done);
      box.querySelector<HTMLElement>("[data-bar]")!.style.width = `${Math.round((done / total) * 100)}%`;
    });
  }
</script>
