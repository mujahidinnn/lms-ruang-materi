---
import { Moon, Sun } from "lucide-react";
---

{/* Light is the design; dark is a choice. The choice lives in localStorage
    and on <html data-theme="dark">, applied before first paint by Base.astro. */}
<button
  type="button"
  data-theme-toggle
  aria-label="Pakai tema gelap"
  aria-pressed="false"
  class="group grid size-11 place-items-center rounded-full bg-zinc-900 text-zinc-300 shadow-soft hover:text-zinc-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <Moon aria-hidden className="size-5 group-aria-pressed:hidden" />
  <Sun aria-hidden className="hidden size-5 group-aria-pressed:block" />
</button>

<script>
  const KEY = "ruang-materi:tema";
  const root = document.documentElement;
  function show(button: Element) {
    const dark = root.dataset.theme === "dark";
    button.setAttribute("aria-pressed", String(dark));
    button.setAttribute("aria-label", dark ? "Pakai tema terang" : "Pakai tema gelap");
  }
  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    show(button);
    button.addEventListener("click", () => {
      const dark = root.dataset.theme !== "dark";
      const apply = () => {
        if (dark) root.dataset.theme = "dark";
        else delete root.dataset.theme;
        show(button);
      };
      try {
        if (dark) localStorage.setItem(KEY, "dark");
        else localStorage.removeItem(KEY);
      } catch {}

      // The new theme spreads out as a circle from the button (View
      // Transitions). Without the API, or with reduced motion, it just switches.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || reduce) return apply();
      const r = button.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document.startViewTransition(apply).ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 550, easing: "cubic-bezier(0.22, 1, 0.36, 1)", pseudoElement: "::view-transition-new(root)" },
        );
      });
    });
  }
</script>
