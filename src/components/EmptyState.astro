---
// Fallback saat data kosong: stiker ilustrasi (components/illustrations) + judul + teks/aksi di slot.
import { Empty, Missing, NothingDue } from "@/components/illustrations";
interface Props {
  art?: "kosong" | "cari" | "beres";
  title?: string;
  small?: boolean;
  class?: string;
  [attr: `data-${string}`]: unknown;
  id?: string;
  hidden?: boolean;
}
const { art = "kosong", title, small = false, class: cls, ...attrs } = Astro.props;
const Art = { kosong: Empty, cari: Missing, beres: NothingDue }[art];
---
<div {...attrs} class:list={["flex flex-col items-center gap-4 text-center sm:flex-row sm:gap-5 sm:text-left", cls]}>
  <Art className={`shrink-0 ${small ? "size-16" : "size-24"}`} />
  <div class="min-w-0 max-w-md">
    {title && <p class="font-bold text-zinc-50">{title}</p>}
    <div class:list={["text-sm text-zinc-400", title && "mt-1"]}><slot /></div>
  </div>
</div>
