---
// Fallback saat data kosong: ikon garis tenang (components/illustrations) + judul + teks/aksi di slot.
import { AllDone, Empty, NoAwards, NoMaterial, NoResults, NoStats } from "@/components/illustrations";
interface Props {
  art?: "kosong" | "cari" | "beres" | "grafik" | "buku" | "piala";
  title: string;
  small?: boolean;
  class?: string;
  [attr: `data-${string}`]: unknown;
  id?: string;
  hidden?: boolean;
}
const { art = "kosong", title, small = false, class: cls, ...attrs } = Astro.props;
const Art = { kosong: Empty, cari: NoResults, beres: AllDone, grafik: NoStats, buku: NoMaterial, piala: NoAwards }[art];
---
<div {...attrs} class:list={["flex flex-col items-center text-center", small ? "gap-2 py-2" : "gap-3 py-4", cls]}>
  <Art className={`shrink-0 ${small ? "size-14" : "size-20"}`} />
  <div class="min-w-0 max-w-sm">
    <p class:list={["font-semibold text-zinc-200", small ? "text-sm" : "text-base"]}>{title}</p>
    <div class:list={"mt-1 text-sm text-zinc-500"}><slot /></div>
  </div>
</div>
