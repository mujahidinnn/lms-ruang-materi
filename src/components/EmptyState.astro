---
// Fallback saat data kosong: ikon garis tenang (components/illustrations) + judul + teks/aksi di slot.
import { Empty, Missing, NothingDue } from "@/components/illustrations";
interface Props {
  art?: "kosong" | "cari" | "beres";
  title?: string;
  small?: boolean;
  class?: string;
  [attr: `data-${string}`]: unknown;
  id?: string;
  hidden?: boolean;
}
const { art = "kosong", title, small = false, class: cls, ...attrs } = Astro.props;
const Art = { kosong: Empty, cari: Missing, beres: NothingDue }[art];
---
<div {...attrs} class:list={["flex flex-col items-center text-center", small ? "gap-2 py-2" : "gap-3 py-4", cls]}>
  <Art className={`shrink-0 ${small ? "size-8" : "size-10"}`} />
  <div class="min-w-0 max-w-sm">
    {title && <p class="text-sm font-semibold text-zinc-300">{title}</p>}
    <div class:list={["text-sm text-zinc-500", title && "mt-1"]}><slot /></div>
  </div>
</div>
