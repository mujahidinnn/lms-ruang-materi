---
import { Award, ChevronDown, LayoutDashboard, LogIn, UserRound } from "lucide-react";
import SignOutButton from "./SignOutButton.astro";

const pill = "min-h-11 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-on-primary hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const item = "flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm text-zinc-300 hover:bg-zinc-800 hover:text-zinc-50";
---

{/* Guests get Masuk, signed-in learners a menu; the signed-in: variant picks
    one, so cached public pages still show the right thing. */}
<a href="/masuk" class="hidden min-h-11 items-center rounded-full px-4 text-sm font-semibold text-zinc-300 hover:text-zinc-50 sm:flex signed-in:hidden"><LogIn aria-hidden className="mr-2 size-4" />Masuk</a>
<a href="/daftar" class={`flex signed-in:hidden ${pill}`}>Daftar</a>
<details class="relative hidden signed-in:block" data-account-menu>
  <summary aria-label="Akun" class={`flex cursor-pointer list-none ${pill} max-sm:px-3.5 [&::-webkit-details-marker]:hidden`}>
    <UserRound aria-hidden className="size-4" /><span class="max-sm:hidden">Akun</span><ChevronDown aria-hidden className="size-4 max-sm:hidden" />
  </summary>
  <div class="absolute right-0 z-50 mt-2 w-56 rounded-2xl bg-zinc-900 p-2 shadow-soft ring-1 ring-zinc-800">
    <a href="/dasbor" class={item}><LayoutDashboard aria-hidden className="size-4" />Dashboard</a>
    <a href="/nilai" class={item}><Award aria-hidden className="size-4" />Pencapaian</a>
    <a href="/profil" class={item}><UserRound aria-hidden className="size-4" />Profil</a>
    <div class="my-1 border-t border-zinc-800"></div>
    <SignOutButton class={`w-full ${item}`} />
  </div>
</details>

<script>
  // Close the menu on a click outside it or on Escape.
  const menu = document.querySelector<HTMLDetailsElement>("[data-account-menu]");
  document.addEventListener("click", (e) => { if (menu?.open && !menu.contains(e.target as Node)) menu.open = false; });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu) menu.open = false; });
</script>
