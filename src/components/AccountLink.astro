---
import { LayoutDashboard, LogIn } from "lucide-react";

const link = "min-h-11 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-on-primary hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

{/* Both links are in the HTML; the signed-in: variant picks one. */}
<a href="/masuk" class={`flex signed-in:hidden ${link}`}><LogIn aria-hidden className="size-4" />Masuk</a>
<a href="/dasbor" class={`hidden signed-in:flex ${link}`}><LayoutDashboard aria-hidden className="size-4" />Dasbor</a>
