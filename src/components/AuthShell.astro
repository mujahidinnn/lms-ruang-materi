---
import { Award, Check, Flame, Save } from "lucide-react";
import { sticker } from "@/components/ui/styles";
import SiteHeader from "./SiteHeader.astro";

// The frame shared by /masuk and /daftar: why an account helps on the
// left, the two tabs and the form on the right.
type Props = { current: "masuk" | "daftar"; next: string };
const { current, next } = Astro.props;
const q = next && next !== "/" ? `?next=${encodeURIComponent(next)}` : "";
const PERKS = [
  { Icon: Save, text: "Progres bab, kuis, dan latihan kode tersimpan" },
  { Icon: Award, text: "Sertifikat dengan namamu setelah lulus" },
  { Icon: Flame, text: "Streak harian dan flashcard yang dijadwalkan" },
];
const tab = "flex min-h-11 items-center justify-center rounded-full text-sm font-bold";
---

<div class="relative flex flex-1 flex-col">
  <SiteHeader />
  <main class="flex flex-1 items-center px-5 pb-20 sm:px-10">
    <div class="mx-auto grid w-full max-w-5xl items-stretch gap-6 lg:grid-cols-[1fr_1.05fr]">
      <section class="relative hidden overflow-hidden rounded-[32px] bg-noir p-6 text-on-noir ring-1 ring-zinc-800 sm:p-10 lg:block">
        <span aria-hidden="true" class={`${sticker} inline-flex -rotate-3 bg-matcha-300 text-noir shadow-[3px_3px_0_0_var(--color-on-noir)]`}>gratis</span>
        <p class="mt-5 text-4xl leading-tight font-extrabold">{current === "daftar" ? "Mulai belajar, simpan progresmu" : "Selamat datang kembali"}</p>
        <p class="mt-3 max-w-xs text-on-noir/75">Semua materi bisa dibaca tanpa akun. Akun membuat progresmu tersimpan.</p>
        <ul class="mt-6 grid max-w-xs gap-3 pr-28 xl:pr-0">
          {PERKS.map(({ Icon, text }) => (
            <li class="flex items-center gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-matcha-300 text-noir"><Icon aria-hidden className="size-4" /></span>
              <span class="text-sm">{text}</span>
            </li>
          ))}
        </ul>
        <div aria-hidden="true" class="absolute right-6 -bottom-2 flex h-56 w-36 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-4">
          <img src="/ilustrasi/kode.svg" alt="" width="890" height="1220" class="h-full w-auto" />
        </div>
      </section>
      <div class="flex flex-col rounded-[32px] bg-zinc-900 p-6 shadow-soft sm:p-8">
        <nav aria-label="Masuk atau daftar" class="mb-6 grid grid-cols-2 gap-1 rounded-full bg-zinc-800 p-1">
          <a href={`/masuk${q}`} aria-current={current === "masuk" ? "page" : undefined} class:list={[tab, current === "masuk" ? "bg-primary text-on-primary" : "text-zinc-400 hover:text-zinc-50"]}>Masuk</a>
          <a href={`/daftar${q}`} aria-current={current === "daftar" ? "page" : undefined} class:list={[tab, current === "daftar" ? "bg-primary text-on-primary" : "text-zinc-400 hover:text-zinc-50"]}>Daftar</a>
        </nav>
        <slot />
        <p class="mt-6 flex items-center gap-2 border-t border-zinc-800 pt-4 text-sm text-zinc-400">
          <Check aria-hidden className="size-4 shrink-0 text-accent" />
          <span>{current === "daftar" ? <>Sudah punya akun? <a href={`/masuk${q}`} class="font-semibold text-accent hover:underline">Masuk</a></> : <>Belum punya akun? <a href={`/daftar${q}`} class="font-semibold text-accent hover:underline">Daftar gratis</a></>}</span>
        </p>
      </div>
    </div>
  </main>
</div>
