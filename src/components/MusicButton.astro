---
import { Music } from "lucide-react";
import { iconButton } from "@/components/ui/styles";
---

{/* Opens /musik in its own small window, so a page change here never stops
    the music; a second click brings the same window back. */}
<a href="/musik" target="ruang-materi-musik" data-music-open aria-label="Musik belajar" class={iconButton}>
  <Music aria-hidden className="size-5" />
</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-music-open]")) {
    link.addEventListener("click", (e) => {
      const win = window.open(link.href, link.target, "popup,width=380,height=620");
      if (win) { e.preventDefault(); win.focus(); }
    });
  }
</script>
