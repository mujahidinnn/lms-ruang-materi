---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/geist-mono";
import "@fontsource/babylonica";
import "../styles/globals.css";
import Analytics from "@vercel/analytics/astro";
import SignupNudge from "../components/SignupNudge.astro";
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from "@/lib/site";

// The document shell for every page (was app/layout.tsx and Next metadata).
// title: the page's own name, shown as "<title> · Ruang Materi"; leave it
// out on the landing. noindex for signed-in and admin screens.
type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  jsonLd?: object;
};
const { title, description = SITE_DESCRIPTION, noindex = false, canonical: canonicalProp, ogType = "website", jsonLd } = Astro.props;
// Every page names itself as canonical, so ?utm_ and ?next= variants fold in.
const canonical = canonicalProp ?? new URL(Astro.url.pathname, SITE_URL).href;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Ruang Belajar Interaktif`;
const ogImage = new URL("/opengraph-image.png", SITE_URL).href;
---

<!doctype html>
<html lang="id" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f4ee" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content="Mujahidin" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="RuangMateri" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Before first paint, so there is no flash: the saved theme (the key is
        also in src/components/ThemeButton.astro), and data-auth when a
        Supabase session cookie exists (the signed-in: variant). The cookie
        only picks a link; pages check the session on the server. */}
    <script is:inline>
      try{var t=localStorage.getItem("ruang-materi:tema");if(t==="dark")document.documentElement.dataset.theme=t}catch(e){}
      if(document.cookie.indexOf("-auth-token")>-1)document.documentElement.dataset.auth="";
      if(document.cookie.indexOf("rm-admin=1")>-1)document.documentElement.dataset.admin="";
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <slot name="head" />
  </head>
  {/* At least one screen tall and the full width, so short pages still fill
      the canvas. min-w-full, not 100dvw: viewport units include the
      scrollbar and would add a sideways scroll on desktop. */}
  <body class="flex min-h-dvh w-full min-w-full flex-col overflow-x-clip bg-zinc-950 text-zinc-50">
    <slot />
    {/* Production only: in dev a cached page would hide fresh changes. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(function () {});
      </script>
    )}
    <script>
      import { installConfirmForms } from "@/lib/confirm";
      import { encodeArgs } from "@/lib/rpc-wire";
      import { installTips } from "@/lib/tip";
      installConfirmForms();
      installTips();
      // "Last seen" for the admin Pengguna list: cached pages never reach the
      // server, and a learner can stay on one lesson page for an hour, so a
      // signed-in browser pings on load and then while the tab is visible,
      // at most every 4 minutes (inside the 6 minute "Online" window).
      if ("auth" in document.documentElement.dataset) {
        const k = "ruang-materi:ping";
        const ping = () => {
          try {
            if (document.hidden || Date.now() - Number(localStorage.getItem(k) ?? 0) < 24e4) return;
            localStorage.setItem(k, String(Date.now()));
            fetch("/rpc/ping", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(encodeArgs([])) });
          } catch {}
        };
        ping();
        setInterval(ping, 6e4);
        document.addEventListener("visibilitychange", ping);
      }
      // Uncaught errors from our own scripts go to /admin/error (lib/actions/
      // error.ts), five per page at most. Extension and cross-origin errors
      // arrive without a file of ours or as "Script error." and are skipped.
      let sent = 0;
      const report = (message: string, stack = "") => {
        if (sent++ >= 5 || !message || message === "Script error." || /ResizeObserver loop/.test(message)) return;
        fetch("/rpc/laporError", { method: "POST", keepalive: true, headers: { "content-type": "application/json" }, body: JSON.stringify(encodeArgs([{ path: location.pathname, message: message.slice(0, 500), stack: stack.slice(0, 4000) }])) }).catch(() => {});
      };
      addEventListener("error", (e) => {
        if (e.filename && !e.filename.startsWith(location.origin)) return;
        report(String(e.message), e.error?.stack);
      });
      addEventListener("unhandledrejection", (e) => {
        const r = e.reason;
        if (r?.stack && !String(r.stack).includes(location.origin)) return;
        report(r instanceof Error ? `${r.name}: ${r.message}` : String(r), r?.stack);
      });
      // Work done before signing in (lib/pending.ts) is sent once there is a
      // session; loaded only when something is waiting.
      try {
        if ("auth" in document.documentElement.dataset && localStorage.getItem("ruang-materi:progres-tertunda")) import("@/lib/pending").then((m) => m.flushPending());
      } catch {}
    </script>
    <SignupNudge />
    {/* Cookieless page views (GUIDELINE, Privacy); no-op outside Vercel. */}
    <Analytics />
  </body>
</html>
