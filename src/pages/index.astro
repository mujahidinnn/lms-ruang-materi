---
import { ArrowRight, BookOpen, Route } from "lucide-react";
import { LogoMark } from "@/components/brand/Logo";
import HeroRoom from "@/components/landing/HeroRoom";
import TopicCard from "@/components/landing/TopicCard";
import TrackCard from "@/components/landing/TrackCard";
import { primaryButton } from "@/components/ui/styles";
import { getTopics, getTracks } from "@/lib/content";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { publicPage } from "../lib/cdn";

publicPage(Astro);

const heroChip = "inline-flex min-h-8 items-center rounded-full bg-on-noir/10 px-3 text-xs font-semibold";
// A four-point sparkle, the reference shots' star.
const SPARK = "M12 0c.9 6.4 4.7 10.6 12 12-7.3 1.4-11.1 5.6-12 12-.9-6.4-4.7-10.6-12-12C7.3 10.6 11.1 6.4 12 0Z";
// Hand-placed, a few per screen size so the heading stays clear.
const stickers = [
  { text: "HTML", place: "inline-flex top-4 left-6 -rotate-6 bg-matcha-300 text-noir" },
  { text: "Git", place: "hidden sm:inline-flex top-5 left-32 rotate-3 bg-matcha-50 text-noir" },
  { text: "React", place: "inline-flex top-5 right-6 rotate-6 bg-matcha-100 text-noir sm:right-12" },
  { text: "SQL", place: "hidden sm:inline-flex bottom-6 right-10 -rotate-3 bg-matcha-600 text-matcha-50" },
  { text: "Node.js", place: "hidden lg:inline-flex top-8 left-[45%] -rotate-2 bg-matcha-200 text-noir" },
];

const [topics, tracks] = await Promise.all([getTopics(), getTracks()]);
const totalSlides = topics.reduce((sum, t) => sum + t.slideCount, 0);
---

<Base>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    {/* Signed-in learners see the same landing, plus a way back to their work. */}
    <div class="hidden px-3 pb-3 signed-in:block sm:px-6">
      <a href="/dasbor" class="mx-auto flex max-w-7xl items-center justify-between gap-3 rounded-2xl border-2 border-noir bg-matcha-200 px-5 py-3 font-semibold text-noir hover:bg-matcha-300">
        <span>Lanjutkan belajar di Beranda saya</span><ArrowRight aria-hidden className="size-5" />
      </a>
    </div>

    <main class="flex-1 px-3 sm:px-6">
      <div class="mx-auto max-w-7xl">
        {/* The one loud surface: a black panel with sticker labels, like the
            reference shots. Stickers are decoration; the chips below carry the
            same facts as text. */}
        <section class="relative grid grid-cols-1 items-center gap-10 overflow-hidden rounded-[40px] bg-noir ring-1 ring-zinc-800 px-6 pt-16 pb-10 text-on-noir sm:px-12 sm:py-16 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
            {stickers.map((st) => (
              <span class={`absolute items-center rounded-full border-2 border-noir px-4 py-1.5 font-(family-name:--font-bricolage) text-sm font-extrabold tracking-tight uppercase shadow-[3px_3px_0_0_var(--color-on-noir)] ${st.place}`}>{st.text}</span>
            ))}
            <svg viewBox="0 0 24 24" class="absolute top-10 right-[46%] hidden size-9 fill-primary lg:block"><path d={SPARK} /></svg>
            <svg viewBox="0 0 24 24" class="absolute bottom-8 left-[42%] size-6 fill-matcha-200"><path d={SPARK} /></svg>
          </div>
          <div class="relative">
            <h1 class="max-w-xl text-[2.7rem] leading-[0.98] font-extrabold text-balance sm:text-6xl lg:text-7xl">
              Belajar ngoding, <span class="inline-block -rotate-2 rounded-2xl border-2 border-on-noir bg-matcha-300 px-3 text-noir">langkah</span> demi langkah
            </h1>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-on-noir/75">
              Materi pemrograman berbahasa Indonesia yang bisa kamu buka
              langsung di browser: bacaan, latihan, kuis, dan ujian. Tanpa unduh,
              tanpa daftar.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="/kelas" class={primaryButton}>
                <BookOpen aria-hidden className="size-4" />
                Jelajahi kelas
              </a>
              <a href="#roadmap" class="inline-flex min-h-12 items-center gap-2 rounded-full px-6 font-semibold ring-2 ring-on-noir/30 transition-colors hover:bg-on-noir/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                <Route aria-hidden className="size-4" />
                Atau ikuti jalur belajar
              </a>
            </div>
            <ul aria-label="Isi Ruang Materi" class="mt-10 flex flex-wrap gap-2">
              <li class={`${heroChip} tabular-nums`}>{tracks.length} jalur belajar</li>
              <li class={`${heroChip} tabular-nums`}>{topics.length} kelas</li>
              <li class={`${heroChip} tabular-nums`}>{totalSlides} slide</li>
              <li class={`${heroChip} bg-primary text-on-primary`}>gratis</li>
            </ul>
          </div>
          {/* Every topic is filed in the folder; only its cover slide crosses to the client. */}
          <div class="relative text-zinc-50"><HeroRoom client:load topics={topics.map((t) => ({ slug: t.slug, title: t.title, description: "", slideCount: t.slideCount, slides: t.slides.slice(0, 1) }))} /></div>
        </section>

        <section id="roadmap" aria-labelledby="roadmap-judul" class="scroll-mt-6 py-12 sm:py-16">
          <h2 id="roadmap-judul" class="text-3xl font-bold tracking-tight sm:text-4xl">Jalur belajar</h2>
          <p class="mt-2 max-w-xl text-zinc-400">Urutan kelas yang disarankan, dari dasar sampai mahir. Lulus ujian akhir tiap kelas untuk naik level.</p>
          <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {tracks.map((t) => <TrackCard track={t} />)}
          </ul>
        </section>

        <section id="materi" aria-labelledby="materi-judul" class="scroll-mt-6 py-12 sm:py-16">
          <h2 id="materi-judul" class="text-3xl font-bold tracking-tight sm:text-4xl">Semua kelas</h2>
          <p class="mt-2 max-w-xl text-zinc-400">Mulai dari mana saja. Setiap kelas berdiri sendiri.</p>
          <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {topics.map((t, i) => <TopicCard topic={t} index={i} />)}
          </ul>
        </section>

      </div>
    </main>

    <footer class="px-5 py-8 sm:px-10">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-3 text-sm text-zinc-500">
        <span class="flex items-center gap-2">
          <LogoMark className="size-5" />
          &copy; {new Date().getFullYear()} Ruang Materi
        </span>
        <a href="/privasi" class="hover:text-zinc-300">Privasi</a>
        <a
          href="https://mujahidin.my.id"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="mujahidin.my.id"
          class="ml-auto font-(family-name:--font-signature) text-2xl text-zinc-500 transition-colors hover:text-zinc-300"
        >
          Mujahidin
        </a>
      </div>
    </footer>
  </div>
</Base>
