---
import { BadgeCheck, Download, Printer } from "lucide-react";
import { primaryButton, secondaryButton } from "@/components/ui/styles";
import { loadCertificate } from "@/lib/certificate-svg";
import { getCertificate } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import Base from "../../layouts/Base.astro";

// The verify page: the certificate image (drawn on the server, so it looks
// the same everywhere and is not page text) and the record it comes from.
const c = await loadCertificate(Astro.params.kode ?? "", Astro.url.searchParams.get("kelas"), Astro.url.searchParams.get("nama"), getCertificate, SITE_URL);
if (!c) return Astro.rewrite("/404");
const src = `/sertifikat/${c.sample ? "contoh" : c.code}.svg${c.sample ? `?kelas=${encodeURIComponent(c.topicTitle)}&nama=${encodeURIComponent(c.name)}` : ""}`;
// The class the sample was opened from, for the way back to it.
const slug = c.sample ? Astro.url.searchParams.get("slug")?.match(/^[a-z0-9-]{1,60}$/)?.[0] : undefined;
const file = `sertifikat-${c.sample ? "contoh" : c.code}`;
---

{/* Public and shareable, but not indexed: it carries a learner's name. */}
<Base title={c.sample ? "Contoh sertifikat" : `Sertifikat ${c.topicTitle}`} description={`Sertifikat kelas ${c.topicTitle} di Ruang Materi atas nama ${c.name}.`} noindex>
  <style is:global>
    @page { size: A4 landscape; margin: 0; }
    @media print {
      html, body { min-height: 0 !important; height: auto; background: white; }
      main { padding: 0 !important; display: block !important; }
      .no-print { display: none !important; }
      .sheet { width: 297mm !important; height: 209.5mm !important; max-width: none !important; box-shadow: none !important; border-radius: 0 !important; }
    }
  </style>
  <main class="flex flex-1 flex-col items-center px-4 py-8 sm:py-12">
    <div class="no-print mb-6 flex w-full max-w-5xl flex-wrap items-center justify-between gap-3">
      <a href="/" class="font-(family-name:--font-bricolage) text-lg font-extrabold">Ruang Materi</a>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-unduh class={secondaryButton}><Download aria-hidden className="size-4" />Unduh PNG</button>
        <button type="button" onclick="window.print()" class={secondaryButton}><Printer aria-hidden className="size-4" />Cetak atau simpan PDF</button>
      </div>
    </div>
    <img src={src} data-file={file} alt={`Sertifikat kelas ${c.topicTitle} atas nama ${c.name}, kode ${c.code}`} width="1123" height="794" class="sheet aspect-[1123/794] h-auto w-full max-w-5xl rounded-md shadow-soft" />
    <section class={`no-print mt-6 flex w-full max-w-5xl items-start gap-3 rounded-[24px] p-5 ${c.sample ? "bg-tile-butter" : "bg-matcha-100 text-noir"}`}>
      <BadgeCheck aria-hidden className="mt-0.5 size-5 shrink-0" />
      {c.sample ? (
        <div class="flex flex-1 flex-wrap items-center justify-between gap-3">
          <p class="text-sm">Ini contoh. Sertifikat asli menjadi bukti kamu menguasai kelasnya: memakai namamu, punya kode unik, dan halaman ini yang membuktikan keasliannya.</p>
          {slug && <a href={`/belajar/${slug}#jalur`} class={primaryButton}>Lanjutkan kelasnya</a>}
        </div>
      ) : (
        <p class="text-sm"><strong>Sertifikat asli.</strong> Diterbitkan Ruang Materi untuk <strong>{c.name}</strong> pada {c.date}, kelas {c.topicTitle}, kode <span class="font-mono font-semibold">{c.code}</span>. Data ini dibaca langsung dari server, bukan dari gambar.</p>
      )}
    </section>
  </main>
  <script>
    // PNG at twice the sheet size, drawn from the same SVG.
    const img = document.querySelector<HTMLImageElement>("img.sheet")!;
    document.querySelector("[data-unduh]")?.addEventListener("click", async () => {
      const pic = new Image();
      pic.src = img.src;
      await pic.decode();
      const canvas = Object.assign(document.createElement("canvas"), { width: 2246, height: 1588 });
      canvas.getContext("2d")!.drawImage(pic, 0, 0, canvas.width, canvas.height);
      canvas.toBlob((blob) => {
        if (!blob) return;
        const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(blob), download: `${img.dataset.file}.png` });
        a.click();
        URL.revokeObjectURL(a.href);
      }, "image/png");
    });
  </script>
</Base>
