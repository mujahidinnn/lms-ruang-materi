---
import { Printer } from "lucide-react";
import { LogoMark } from "@/components/brand/Logo";
import { Passed } from "@/components/illustrations";
import { secondaryButton, sticker } from "@/components/ui/styles";
import { getCertificate } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import Base from "../../layouts/Base.astro";

// /sertifikat/contoh: what learners earn, with sample data and a clear label.
const sample = Astro.params.kode === "contoh";
const kelas = Astro.url.searchParams.get("kelas")?.slice(0, 80);
const cert = sample
  ? { code: "CONTOH", name: "Nama Kamu", topicTitle: kelas || "Pemrograman Python: Dari Nol sampai Proyek Mini", issuedAt: new Date().toISOString() }
  : await getCertificate(Astro.params.kode ?? "");
if (!cert) return Astro.rewrite("/404");
const date = new Date(cert.issuedAt).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Jakarta" });
const verify = `${SITE_URL}/sertifikat/${cert.code}`;
---

{/* Public and shareable, but not indexed: it carries a learner's name. */}
<Base title={sample ? "Contoh sertifikat" : `Sertifikat ${cert.topicTitle}`} description={`Sertifikat kelas ${cert.topicTitle} di Ruang Materi atas nama ${cert.name}.`} noindex>
  <style is:global>
    @page { size: A4 landscape; margin: 0; }
    @media print {
      html, body { min-height: 0 !important; height: auto; background: white; }
      main { padding: 0 !important; display: block !important; }
      .no-print { display: none !important; }
      /* Exactly one A4 page, nothing around it. */
      .sheet { box-shadow: none; margin: 0; width: 297mm; max-width: none; height: 209.5mm; aspect-ratio: auto; border-radius: 0; break-inside: avoid; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
  <main class="flex flex-1 flex-col items-center px-4 py-8 sm:py-12">
    <div class="no-print mb-6 flex w-full max-w-5xl flex-wrap items-center justify-between gap-3">
      <a href="/" class="font-(family-name:--font-bricolage) text-lg font-extrabold">Ruang Materi</a>
      <button type="button" onclick="window.print()" class={secondaryButton}><Printer aria-hidden className="size-4" />Cetak atau simpan PDF</button>
    </div>
    <article class="sheet relative w-full max-w-5xl overflow-hidden rounded-[32px] bg-noir p-6 text-on-noir shadow-soft sm:aspect-[297/210] sm:p-[5%]">
      {sample && <span class="absolute bottom-[7%] right-[5%] z-10 rotate-[-8deg] rounded-xl border-4 border-matcha-300 px-4 py-1 font-(family-name:--font-bricolage) text-xl font-extrabold tracking-widest text-matcha-300 uppercase sm:text-3xl">Contoh</span>}
      <div aria-hidden="true" class="pointer-events-none select-none">
        <span class={`${sticker} absolute top-[7%] right-[24%] hidden rotate-6 bg-matcha-300 text-noir sm:inline-flex`}>lulus</span>
        <Passed className="absolute top-4 right-4 size-16 rotate-12 sm:top-[5%] sm:right-[5%] sm:size-[16%]" />
      </div>
      <div class="relative flex h-full flex-col">
        <div class="flex items-center gap-3"><LogoMark className="size-10 -rotate-6" /><span class="font-(family-name:--font-bricolage) text-xl font-extrabold">Ruang Materi</span></div>
        <p class="mt-[6%] text-sm font-semibold tracking-wide text-matcha-200 sm:text-base">Sertifikat kelas</p>
        <h1 class="mt-2 max-w-[85%] text-3xl leading-[1.02] font-extrabold text-balance sm:text-6xl">{cert.topicTitle}</h1>
        <p class="mt-[4%] text-sm text-on-noir/70 sm:text-base">diberikan kepada</p>
        <p class="mt-1 font-(family-name:--font-bricolage) text-2xl font-extrabold sm:text-5xl"><span class="inline-block -rotate-1 rounded-2xl bg-matcha-300 px-3 text-noir">{cert.name}</span></p>
        <p class="mt-[3%] max-w-[60%] text-xs text-on-noir/70 sm:text-sm">karena menyelesaikan semua bab, lulus ujian akhir, dan menyelesaikan proyek akhir bila kelasnya punya.</p>
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-2 text-xs sm:mt-auto sm:text-sm">
          <div><dt class="text-on-noir/60">Tanggal</dt><dd class="font-semibold">{date}</dd></div>
          <div><dt class="text-on-noir/60">Kode</dt><dd class="font-mono font-semibold">{cert.code}</dd></div>
          <div><dt class="text-on-noir/60">Cek keaslian</dt><dd class="font-semibold break-all">{verify.replace(/^https?:\/\//, "")}</dd></div>
        </dl>
      </div>
    </article>
  </main>
</Base>
