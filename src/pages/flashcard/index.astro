---
import FlashcardDeck, { type Card } from "@/components/flashcard/FlashcardDeck";
import { NothingDue } from "@/components/illustrations";
import { createClient } from "@/lib/supabase/server";
import FlashcardGuide from "../../components/FlashcardGuide.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { signedIn } from "../../lib/guard";

const user = await signedIn(Astro);
if (user instanceof Response) return user;
const { data, error } = await (await createClient()).rpc("flashcard_queue");
if (error) throw new Error(`flashcard_queue: ${error.message}`);
const cards = data as Card[];
---

<Base title="Flashcard" description="Flashcard yang jatuh tempo hari ini dari semua kelas yang sudah kamu buka." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
    <div class="mx-auto max-w-7xl">
      <h1 class="mb-8 text-4xl font-bold tracking-tight sm:text-5xl">Flashcard</h1>
      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div>
      {cards.length === 0 ? (
        <div class="flex flex-col items-center py-10 text-center">
          <NothingDue className="size-24" />
          <p class="mt-6 max-w-sm text-zinc-400">
            Belum ada kartu jatuh tempo. Buka <a href="/kelas" class="text-accent hover:underline">kelas</a> untuk mulai topik baru.
          </p>
        </div>
      ) : (
        <FlashcardDeck client:load cards={cards} masukHref="/masuk?next=/flashcard">
          <p slot="end" class="text-zinc-400">Kartu berikutnya muncul lagi sesuai jadwalnya.</p>
        </FlashcardDeck>
      )}
      </div>
      <FlashcardGuide count={cards.length} />
      </div>
    </div>
  </main>
  </div>
</Base>
