---
import FlashcardDeck from "@/components/flashcard/FlashcardDeck";
import { getDeck } from "@/lib/content";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { publicPage } from "../../lib/cdn";

const slug = Astro.params.slug!;
const deck = await getDeck(slug);
if (!deck) return Astro.rewrite("/404");
publicPage(Astro);
---

<Base title={`Flashcard ${deck.title}`} description={`Kartu hafalan ${deck.title}: balik kartunya, lalu nilai seberapa ingat kamu.`} noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader learning />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-2xl">
        <a href={`/belajar/${slug}`} class="text-sm text-zinc-400 hover:text-zinc-50">{deck.title}</a>
        <h1 class="mt-2 mb-8 text-4xl font-bold tracking-tight">Kartu hafalan</h1>
        {deck.cards.length === 0 ? (
          <p class="text-zinc-400">
            Flashcard untuk topik ini belum tersedia.{" "}
            <a href={`/belajar/${slug}`} class="text-accent hover:underline">Kembali ke materi</a>
          </p>
        ) : (
          <FlashcardDeck client:load cards={deck.cards} masukHref={`/masuk?next=/flashcard/${slug}`}>
            <a slot="end" href="/flashcard" class="text-accent hover:underline">Lihat semua kartu jatuh tempo</a>
          </FlashcardDeck>
        )}
      </div>
    </main>
  </div>
</Base>
