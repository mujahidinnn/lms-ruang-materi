---
import EmptyState from "../components/EmptyState.astro";
import { TrackIcon } from "@/components/ui/icons";
import TrackProgress from "@/components/dashboard/TrackProgress";
import { card, chip } from "@/components/ui/styles";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { signedIn } from "../lib/guard";

type AttemptRow = { score: number | null; passed: boolean | null; exam_id: string; exams: { max_attempts: number; topics: { slug: string; title: string } | null } | null };
type TrackRow = { id: string; slug: string; icon: string | null; title: string };

const user = await signedIn(Astro);
if (user instanceof Response) return user;
const db = await createClient();
const [{ data: attempts }, { data: tracks }, { data: levels }, { data: badges }, { data: streak }, { data: certs }] = await Promise.all([
  db.from("exam_attempts").select("score, passed, exam_id, exams(max_attempts, topics(slug, title))").eq("user_id", user.id).order("created_at"),
  db.from("tracks").select("id, slug, icon, title").order("created_at"),
  db.from("track_levels").select("slug, core_passed, core_total"),
  db.from("badges").select("track_id").eq("user_id", user.id),
  db.from("learning_streaks").select("best_days").eq("user_id", user.id).maybeSingle(),
  db.from("certificates").select("code, issued_at, topics(title)").eq("user_id", user.id).order("issued_at"),
]);
const certificates = (certs ?? []) as unknown as { code: string; issued_at: string; topics: { title: string } | null }[];

const levelBySlug = new Map((levels ?? []).map((l) => [l.slug, l]));
const earned = new Set((badges ?? []).map((b) => b.track_id));
const exams = new Map<string, { slug: string; title: string; best: number | null; tries: number; max: number; passed: boolean }>();
for (const a of (attempts ?? []) as unknown as AttemptRow[]) {
  // Exams of unpublished topics come back as null embeds.
  if (!a.exams?.topics) continue;
  const e = exams.get(a.exam_id) ?? { ...a.exams.topics, best: null, tries: 0, max: a.exams.max_attempts, passed: false };
  e.tries += 1;
  e.passed ||= !!a.passed;
  if (a.score !== null) e.best = Math.max(e.best ?? 0, a.score);
  exams.set(a.exam_id, e);
}
---

<Base title="Pencapaian" description="Sertifikat, badge, nilai ujian terbaik, dan kemajuan setiap roadmap." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
    <div class="mx-auto grid max-w-7xl gap-4 sm:gap-6">
      <header class="relative overflow-hidden rounded-[18px] bg-noir p-5 text-on-noir ring-1 ring-zinc-800 sm:p-10">
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl">Pencapaian</h1>
        <p class="mt-2 max-w-md text-on-noir/70">Sertifikat, badge roadmap, streak, dan nilai ujian terbaikmu.</p>
        <ul class="mt-4 flex flex-wrap gap-1.5 text-sm font-semibold sm:mt-6 sm:gap-2">
          <li class="rounded-full bg-on-noir/10 px-3 py-1 tabular-nums">{certificates.length} sertifikat</li>
          <li class="rounded-full bg-on-noir/10 px-3 py-1 tabular-nums">{earned.size} badge</li>
          <li class="rounded-full bg-on-noir/10 px-3 py-1 tabular-nums">{exams.size} ujian dikerjakan</li>
        </ul>
        <div aria-hidden="true" class="absolute right-8 bottom-0 hidden h-48 w-36 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-4 sm:flex">
          <img src="/ilustrasi/sertifikat.svg" alt="" width="890" height="1220" class="h-full w-auto -scale-x-100" />
        </div>
      </header>
      <div class="grid items-start gap-4 sm:gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
        <div class="grid gap-4 sm:gap-6">
      <section aria-labelledby="roadmap" class={`p-5 sm:p-6 ${card}`}>
        <h2 id="roadmap" class="text-xl font-bold tracking-tight">Roadmap</h2>
        <ul class="mt-4 space-y-5">
          {((tracks ?? []) as TrackRow[]).map((t) => {
            const l = levelBySlug.get(t.slug);
            return (
              <li>
                <TrackProgress slug={t.slug} title={t.title} passed={l?.core_passed ?? 0} total={l?.core_total ?? 0} />
              </li>
            );
          })}
        </ul>
      </section>
      <section aria-labelledby="ujian" class={`p-5 sm:p-6 ${card}`}>
        <h2 id="ujian" class="text-xl font-bold tracking-tight">Ujian</h2>
        {exams.size === 0 ? (
          <EmptyState title="Belum ada nilai" class="mt-4">
            Belum ada ujian yang kamu kerjakan. Buka <a href="/kelas" class="text-accent hover:underline">kelas</a> dan pilih kelas untuk diuji.
          </EmptyState>
        ) : (
          <table class="mt-4 w-full text-left text-sm">
            <thead class="border-b border-zinc-800/80 text-zinc-500">
              <tr>
                <th class="py-2 font-normal">Kelas</th>
                <th class="py-2 text-right font-normal">Nilai terbaik</th>
                <th class="hidden py-2 text-right font-normal sm:table-cell">Percobaan</th>
                <th class="py-2 text-right font-normal">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/80">
              {[...exams.values()].map((e) => (
                <tr>
                  <td class="py-3"><a href={`/ujian/${e.slug}`} class="hover:text-accent">{e.title}</a></td>
                  <td class="py-3 text-right font-semibold tabular-nums">{e.best ?? "-"}</td>
                  <td class="hidden py-3 text-right text-zinc-400 tabular-nums sm:table-cell">{e.tries}</td>
                  <td class="py-3 text-right"><span class={`${chip} ${e.passed ? "bg-tile-mint" : "bg-zinc-800"}`}>{e.passed ? "lulus" : "belum"}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
        </div>
        <aside class="grid gap-6">
      {certificates.length > 0 && (
        <section aria-labelledby="sertifikat" class="rounded-[18px] bg-noir p-6 text-on-noir ring-1 ring-zinc-800">
          <h2 id="sertifikat" class="text-xl font-bold tracking-tight">Sertifikat</h2>
          <ul class="mt-4 grid gap-2 ">
            {certificates.map((c) => (
              <li>
                <a href={`/sertifikat/${c.code}`} class="flex min-h-14 items-center justify-between gap-3 rounded-xl border-2 border-on-noir/20 px-4 py-2 hover:border-matcha-300">
                  <span class="font-semibold">{c.topics?.title ?? "Kelas"}</span>
                  <span class="rounded-full bg-matcha-300 px-2.5 py-0.5 font-mono text-xs font-bold text-noir">{c.code}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {certificates.length === 0 && (
        <section aria-labelledby="sertifikat" class={`p-5 sm:p-6 ${card}`}>
          <h2 id="sertifikat" class="text-xl font-bold tracking-tight">Sertifikat</h2>
          <EmptyState title="Belum ada sertifikat" class="mt-4">Selesaikan semua bab, lulus ujian akhir, dan proyek akhir sebuah kelas untuk menerbitkannya.</EmptyState>
        </section>
      )}
        <div class="api-tile relative overflow-hidden rounded-[18px] bg-matcha-300 p-6 text-noir">
          <h2 class="text-sm font-medium text-noir/80">Streak terbaik</h2>
          <p class="mt-2 text-5xl font-bold tracking-tight tabular-nums">{streak?.best_days ?? 0}<span class="ml-1.5 text-base font-medium text-noir/80">hari</span></p>
          <span aria-hidden="true" class="api absolute top-1/2 right-6 grid -translate-y-1/2 place-items-center">
            <span class="api-glow absolute size-28 rounded-full bg-white/80 blur-2xl"></span>
            <span class="api-bara api-bara-1"></span><span class="api-bara api-bara-2"></span><span class="api-bara api-bara-3"></span>
            <svg viewBox="0 0 100 120" class="api-svg relative h-28 w-24 overflow-visible" data-api>
              <g><path class="api-luar" d="M55 2C53 20 62 30 66 38C68 34 72 30 74 22C78 36 87 56 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 18 60 26 50C27 58 31 63 36 64C32 48 40 34 47 22C51 15 54 9 55 2Z"><animate attributeName="d" dur="5.6s" repeatCount="indefinite" calcMode="spline" keyTimes="0;.33;.66;1" keySplines=".45 0 .55 1;.45 0 .55 1;.45 0 .55 1" values="M55 2C53 20 62 30 66 38C68 34 72 30 74 22C78 36 87 56 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 18 60 26 50C27 58 31 63 36 64C32 48 40 34 47 22C51 15 54 9 55 2Z;M58 0C56 18 64 28 68 36C70 30 73 26 72 18C80 32 87 54 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 20 58 30 48C28 56 32 64 38 66C30 50 40 32 50 22C55 16 57 8 58 0Z;M52 3C54 22 60 30 64 40C67 36 74 32 77 26C79 38 87 58 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 72 16 62 24 52C26 58 30 62 35 62C34 46 38 36 44 20C48 14 50 8 52 3Z;M55 2C53 20 62 30 66 38C68 34 72 30 74 22C78 36 87 56 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 18 60 26 50C27 58 31 63 36 64C32 48 40 34 47 22C51 15 54 9 55 2Z"/></path></g>
              <g transform="translate(14 30) scale(.72)"><path class="api-tengah" d="M58 0C56 18 64 28 68 36C70 30 73 26 72 18C80 32 87 54 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 20 58 30 48C28 56 32 64 38 66C30 50 40 32 50 22C55 16 57 8 58 0Z"><animate attributeName="d" dur="4.4s" repeatCount="indefinite" calcMode="spline" keyTimes="0;.33;.66;1" keySplines=".45 0 .55 1;.45 0 .55 1;.45 0 .55 1" values="M58 0C56 18 64 28 68 36C70 30 73 26 72 18C80 32 87 54 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 20 58 30 48C28 56 32 64 38 66C30 50 40 32 50 22C55 16 57 8 58 0Z;M52 3C54 22 60 30 64 40C67 36 74 32 77 26C79 38 87 58 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 72 16 62 24 52C26 58 30 62 35 62C34 46 38 36 44 20C48 14 50 8 52 3Z;M55 2C53 20 62 30 66 38C68 34 72 30 74 22C78 36 87 56 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 18 60 26 50C27 58 31 63 36 64C32 48 40 34 47 22C51 15 54 9 55 2Z;M58 0C56 18 64 28 68 36C70 30 73 26 72 18C80 32 87 54 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 20 58 30 48C28 56 32 64 38 66C30 50 40 32 50 22C55 16 57 8 58 0Z"/></path></g>
              <g transform="translate(27.5 62) scale(.45)"><path class="api-inti" d="M52 3C54 22 60 30 64 40C67 36 74 32 77 26C79 38 87 58 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 72 16 62 24 52C26 58 30 62 35 62C34 46 38 36 44 20C48 14 50 8 52 3Z"><animate attributeName="d" dur="3.6s" repeatCount="indefinite" calcMode="spline" keyTimes="0;.33;.66;1" keySplines=".45 0 .55 1;.45 0 .55 1;.45 0 .55 1" values="M52 3C54 22 60 30 64 40C67 36 74 32 77 26C79 38 87 58 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 72 16 62 24 52C26 58 30 62 35 62C34 46 38 36 44 20C48 14 50 8 52 3Z;M55 2C53 20 62 30 66 38C68 34 72 30 74 22C78 36 87 56 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 18 60 26 50C27 58 31 63 36 64C32 48 40 34 47 22C51 15 54 9 55 2Z;M58 0C56 18 64 28 68 36C70 30 73 26 72 18C80 32 87 54 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 70 20 58 30 48C28 56 32 64 38 66C30 50 40 32 50 22C55 16 57 8 58 0Z;M52 3C54 22 60 30 64 40C67 36 74 32 77 26C79 38 87 58 86 82C84 104 69 118 50 118C31 118 16 104 14 84C13 72 16 62 24 52C26 58 30 62 35 62C34 46 38 36 44 20C48 14 50 8 52 3Z"/></path></g>
            </svg>
          </span>
        </div>
        <section aria-labelledby="badge" class={`p-5 sm:p-6 ${card}`}>
          <h2 id="badge" class="text-xl font-bold tracking-tight">Badge</h2>
          <ul class="mt-3 grid gap-2">
            {((tracks ?? []) as TrackRow[]).map((t) => {
              const got = earned.has(t.id);
              return (
                <li
                  class={`flex min-h-11 items-center gap-2 rounded-full px-4 text-sm font-medium ${got ? "bg-tile-butter text-zinc-50" : "border border-dashed border-zinc-600 text-zinc-400"}`}
                >
                  <TrackIcon slug={t.slug} icon={t.icon} className={`size-7 ${got ? "" : "opacity-60"}`} />
                  {t.title}
                  <span class="sr-only">{got ? ", didapat" : ", belum"}</span>
                </li>
              );
            })}
          </ul>
          <p class="mt-2 text-xs text-zinc-500">Badge didapat setelah lulus ujian akhir semua kelas inti satu roadmap.</p>
        </section>
        </aside>
      </div>
    </div>
  </main>
  </div>
</Base>

<style>
  .api-svg { transform-origin: 50% 100%; animation: api-ayun 7s ease-in-out infinite; }
  .api-luar { fill: #111; }
  .api-tengah { fill: #fff; }
  .api-inti { fill: var(--color-matcha-300); }
  .api-glow { animation: api-nyala 4.4s ease-in-out infinite; }
  .api-bara { position: absolute; bottom: 45%; left: 50%; width: 5px; height: 5px; border-radius: 9999px; background: #111; opacity: 0; animation: api-naik 6s ease-out infinite; }
  .api-bara-1 { margin-left: -8px; }
  .api-bara-2 { margin-left: 6px; width: 4px; height: 4px; animation-delay: 2s; }
  .api-bara-3 { margin-left: -1px; width: 3px; height: 3px; animation-delay: 4s; }
  @keyframes api-ayun { 0%, 100% { transform: rotate(-1.5deg); } 50% { transform: rotate(1.5deg); } }
  @keyframes api-nyala { 0%, 100% { opacity: 0.5; transform: scale(0.92); } 50% { opacity: 0.9; transform: scale(1.08); } }
  @keyframes api-naik { 0% { transform: translateY(0) scale(1); opacity: 0; } 15% { opacity: 0.7; } 100% { transform: translateY(-60px) translateX(6px) scale(0.3); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .api-svg, .api-glow, .api-bara { animation: none; } .api-bara { display: none; } }
</style>
<script>
  // SMIL ignores prefers-reduced-motion, so stop it by hand.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.querySelectorAll<SVGSVGElement>("[data-api]").forEach((s) => s.pauseAnimations());
</script>
