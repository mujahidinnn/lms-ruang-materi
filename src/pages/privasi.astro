---
import { Ban, Database, Download, Globe, ShieldAlert, UserCheck } from "lucide-react";
import { card } from "@/components/ui/styles";
import { SITE_NAME, SITE_URL } from "@/lib/site";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { publicPage } from "../lib/cdn";

publicPage(Astro);

const UPDATED = "21 Oktober 2026";

const stored = [
  ["Email", "Mengirim tautan masuk dan menjadi identitas akunmu."],
  ["Nama tampilan", "Ditampilkan di sertifikat. Boleh nama panggilan."],
  ["Zona waktu", "Menghitung streak harian dengan benar."],
  ["Kelompok usia dan persetujuan", "18 tahun ke atas, atau di bawah 18 dengan izin orang tua atau wali."],
  ["Aktivitas belajar", "Bab yang selesai, kuis, kode latihan yang lolos, review flashcard, nilai ujian, proyek, dan sertifikat."],
];

const never = ["Nomor telepon", "Tanggal lahir", "Sekolah", "Alamat", "Iklan", "Pelacak pihak ketiga"];

const processors = [
  ["Supabase", "Database akun, progres belajar, dan materi", "Korea Selatan"],
  ["Vercel", "Hosting situs (server di Korea Selatan) dan statistik kunjungan anonim tanpa cookie", "Global"],
  ["GitHub", "Kode situs dan pemrosesan file materi yang diunggah admin", "Amerika Serikat"],
  ["Anthropic, Google, OpenAI, OpenRouter", "Membantu admin menyusun draf materi dari slide. Tidak pernah menerima data pelajar", "Amerika Serikat"],
];

const rights = [
  ["Lihat dan unduh", "Unduh semua data belajarmu sebagai JSON di Profil."],
  ["Perbaiki", "Ubah nama tampilan, zona waktu, dan pilihan usia di Profil."],
  ["Cabut persetujuan", "Pilih \"Cabut persetujuan\" di Profil. Progres berhenti tersimpan."],
  ["Hapus akun", "Hapus akun di Profil. Semua data belajarmu ikut terhapus dan tidak bisa dibatalkan."],
];

const H2 = "flex items-center gap-3 text-2xl font-bold tracking-tight text-zinc-50";
const ICON = "grid size-11 shrink-0 -rotate-6 place-items-center rounded-2xl border-2 border-noir bg-matcha-200 text-noir";
---

<Base title="Privasi" description="Data apa yang disimpan Ruang Materi, untuk apa, di mana, dan cara mengekspor atau menghapusnya sesuai UU PDP." canonical={`${SITE_URL}/privasi`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto grid max-w-7xl items-start gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">
        <nav aria-label="Isi halaman" class="hidden lg:sticky lg:top-6 lg:block">
          <p class="px-3 text-sm font-bold text-zinc-50">Di halaman ini</p>
          <ol class="mt-3 grid gap-1 text-sm">
            {[["disimpan", "Data yang disimpan"], ["tidak", "Yang tidak ada di sini"], ["usia", "Usia dan persetujuan"], ["pemroses", "Siapa yang memproses"], ["hak", "Hakmu"], ["bocor", "Jika terjadi kebocoran"]].map(([id, label]) => (
              <li><a href={`#${id}`} class="block rounded-xl px-3 py-2 text-zinc-400 hover:bg-zinc-900 hover:text-zinc-50">{label}</a></li>
            ))}
          </ol>
        </nav>
      <div class="grid gap-6 text-zinc-300">
        <header class="relative overflow-hidden rounded-[32px] bg-noir p-6 text-on-noir sm:p-10">
          <p class="text-sm text-on-noir/60">Diperbarui {UPDATED}</p>
          <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Privasi</h1>
          <p class="mt-3 max-w-xl text-on-noir/75">
            {SITE_NAME} menyimpan data sesedikit mungkin, hanya untuk menyimpan progres belajarmu,
            sesuai Undang-Undang Pelindungan Data Pribadi (UU 27/2022).
          </p>
          <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">
            {["Tanpa iklan", "Tanpa pelacak", "Bisa diunduh", "Bisa dihapus"].map((t) => (
              <li class="rounded-full border-2 border-on-noir/20 px-3 py-1">{t}</li>
            ))}
          </ul>
        </header>

        <section aria-labelledby="disimpan" class={`scroll-mt-6 p-6 sm:p-8 ${card}`}>
          <h2 id="disimpan" class={H2}><span class={ICON}><Database aria-hidden className="size-5" /></span>Data yang disimpan</h2>
          <p class="mt-3 text-sm text-zinc-400">Hanya setelah kamu masuk. Tamu bisa membaca semua materi tanpa akun, dan tidak ada yang disimpan.</p>
          <dl class="mt-5 divide-y divide-zinc-800">
            {stored.map(([what, why]) => (
              <div class="grid gap-1 py-3 sm:grid-cols-[13rem_1fr] sm:gap-4">
                <dt class="font-semibold text-zinc-50">{what}</dt>
                <dd class="text-sm leading-relaxed">{why}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 rounded-2xl bg-matcha-50 px-4 py-3 text-sm text-noir">
            Sertifikat bisa dicek siapa saja lewat kodenya. Yang terlihat hanya nama tampilan, nama kelas, dan tanggal terbit.
          </p>
        </section>

        <section aria-labelledby="tidak" class={`scroll-mt-6 p-6 sm:p-8 ${card}`}>
          <h2 id="tidak" class={H2}><span class={ICON}><Ban aria-hidden className="size-5" /></span>Yang tidak ada di sini</h2>
          <ul class="mt-5 flex flex-wrap gap-2">
            {never.map((n) => <li class="rounded-full bg-zinc-800 px-3 py-1.5 text-sm line-through decoration-zinc-500">{n}</li>)}
          </ul>
        </section>

        <section aria-labelledby="usia" class={`scroll-mt-6 p-6 sm:p-8 ${card}`}>
          <h2 id="usia" class={H2}><span class={ICON}><UserCheck aria-hidden className="size-5" /></span>Usia dan persetujuan</h2>
          <p class="mt-3 leading-relaxed">
            Saat pertama masuk, kamu memilih salah satu: berusia 18 tahun ke atas dan setuju dengan kebijakan ini,
            atau di bawah 18 tahun dan orang tua atau wali sudah mengizinkan. Tanpa pilihan ini progres tidak disimpan,
            karena UU PDP mewajibkan izin orang tua untuk data anak.
          </p>
        </section>

        <section aria-labelledby="pemroses" class={`scroll-mt-6 p-6 sm:p-8 ${card}`}>
          <h2 id="pemroses" class={H2}><span class={ICON}><Globe aria-hidden className="size-5" /></span>Siapa yang memproses</h2>
          <p class="mt-3 text-sm text-zinc-400">Data disimpan dan diproses di luar Indonesia oleh layanan berikut.</p>
          <ul class="mt-5 grid gap-3">
            {processors.map(([name, use, region]) => (
              <li class="grid gap-1 rounded-2xl bg-zinc-800/50 p-4 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-4">
                <span>
                  <span class="block font-semibold text-zinc-50">{name}</span>
                  <span class="text-sm leading-relaxed">{use}</span>
                </span>
                <span class="justify-self-start rounded-full bg-zinc-900 px-3 py-1 text-xs font-semibold text-zinc-400 sm:justify-self-end">{region}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="hak" class={`scroll-mt-6 p-6 sm:p-8 ${card}`}>
          <h2 id="hak" class={H2}><span class={ICON}><Download aria-hidden className="size-5" /></span>Hakmu</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {rights.map(([title, text]) => (
              <li class="rounded-2xl bg-zinc-800/50 p-4">
                <span class="block font-semibold text-zinc-50">{title}</span>
                <span class="text-sm leading-relaxed">{text}</span>
              </li>
            ))}
          </ul>
          <a href="/profil" class="mt-5 inline-flex min-h-11 items-center rounded-full border-2 border-noir bg-primary px-5 font-bold text-on-primary">Buka Profil</a>
        </section>

        <section aria-labelledby="bocor" class={`scroll-mt-6 p-6 sm:p-8 ${card}`}>
          <h2 id="bocor" class={H2}><span class={ICON}><ShieldAlert aria-hidden className="size-5" /></span>Jika terjadi kebocoran</h2>
          <p class="mt-3 leading-relaxed">
            Kami memberi tahu pengguna yang terdampak dan otoritas pelindungan data dalam 3x24 jam, lewat email
            dan pengumuman di halaman ini. Isinya: data apa yang terdampak dan langkah yang perlu kamu ambil.
          </p>
        </section>
      </div>
      </div>
    </main>
  </div>
</Base>
