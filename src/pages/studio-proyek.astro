---
import { ArrowRight, Rocket } from "lucide-react";
import { card, secondaryButton } from "@/components/ui/styles";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { publicPage } from "../lib/cdn";

publicPage(Astro);

// A real sequence, so the numbers mean something.
const STAGES = [
  { title: "Brief", text: "Baca kebutuhan klien atau pengguna, lalu tentukan apa yang akan dibuat dan apa yang tidak." },
  { title: "Brainstorming", text: "Kumpulkan ide fitur, pilih yang paling berguna, dan gambar sketsa alurnya." },
  { title: "Memilih teknologi", text: "Pilih bahasa, framework, dan database dengan alasan yang bisa kamu jelaskan di wawancara." },
  { title: "Ngoding", text: "Bangun fiturnya selangkah demi selangkah, dengan commit yang rapi di Git." },
  { title: "Memecahkan masalah", text: "Baca error, telusuri penyebabnya, dan perbaiki bug seperti yang dilakukan di pekerjaan nyata." },
  { title: "Uji end-to-end", text: "Pastikan alur utama jalan dari awal sampai akhir sebelum dirilis." },
  { title: "Deploy dan online", text: "Rilis ke internet dengan alamat sendiri, lalu pasang di portofoliomu." },
];
---

<Base title="Studio Proyek" description="Bangun proyek nyata untuk portofolio, dipandu dari brief sampai online. Segera hadir di Ruang Materi." canonical={`${SITE_URL}/studio-proyek`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-3xl">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="flex items-center gap-3 text-3xl font-extrabold sm:text-5xl"><Rocket aria-hidden className="size-8 sm:size-10" />Studio Proyek</h1>
          <span class="rounded-full bg-matcha-300 px-3 py-1.5 text-xs leading-none font-extrabold tracking-wider text-noir uppercase">Segera</span>
        </div>
        <p class="mt-3 max-w-xl text-lg text-zinc-400">Tempat membangun proyek nyata dari nol sampai online, supaya kamu punya karya untuk portofolio. Kami sedang menyiapkannya.</p>

        <h2 class="mt-10 text-xl font-extrabold">Yang akan kamu lalui</h2>
        <ol class="mt-4 grid gap-3">
          {STAGES.map((s, i) => (
            <li class={`flex items-start gap-4 p-4 sm:p-5 ${card}`}>
              <span aria-hidden class="grid size-9 shrink-0 place-items-center rounded-full bg-noir font-(family-name:--font-bricolage) text-sm font-extrabold text-on-noir">{i + 1}</span>
              <div class="min-w-0">
                <h3 class="font-(family-name:--font-bricolage) text-lg font-extrabold tracking-tight">{s.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-400">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class={`mt-10 flex flex-wrap items-center justify-between gap-4 p-5 ${card}`}>
          <p class="max-w-md text-sm text-zinc-400">Sambil menunggu, kerjakan proyek akhir di setiap kelas atau coba kodemu bebas di Playground.</p>
          <span class="flex flex-wrap gap-2">
            <a href="/kelas" class={secondaryButton}>Pilih kelas</a>
            <a href="/playground" class={secondaryButton}>Buka Playground<ArrowRight aria-hidden className="size-4" /></a>
          </span>
        </div>
      </div>
    </main>
  </div>
</Base>
