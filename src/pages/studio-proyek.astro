---
import { ArrowRight, Rocket } from "lucide-react";
import { StudioAlur, StudioBrief, StudioBug, StudioDeploy, StudioIde, StudioNgoding, StudioTeknologi } from "@/components/ui/icons";
import { card, secondaryButton } from "@/components/ui/styles";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { publicPage } from "../lib/cdn";

publicPage(Astro);

// A real sequence, so the numbers mean something.
const STAGES = [
  { Icon: StudioBrief, title: "Brief", text: "Baca kebutuhan klien atau pengguna, lalu tentukan apa yang akan dibuat dan apa yang tidak." },
  { Icon: StudioIde, title: "Brainstorming", text: "Kumpulkan ide fitur, pilih yang paling berguna, dan gambar sketsa alurnya." },
  { Icon: StudioTeknologi, title: "Memilih teknologi", text: "Pilih bahasa, framework, dan database dengan alasan yang bisa kamu jelaskan di wawancara." },
  { Icon: StudioNgoding, title: "Ngoding", text: "Bangun fiturnya selangkah demi selangkah, dengan commit yang rapi di Git." },
  { Icon: StudioBug, title: "Memecahkan masalah", text: "Baca error, telusuri penyebabnya, dan perbaiki bug seperti yang dilakukan di pekerjaan nyata." },
  { Icon: StudioAlur, title: "Uji end-to-end", text: "Pastikan alur utama jalan dari awal sampai akhir sebelum dirilis." },
  { Icon: StudioDeploy, title: "Deploy dan online", text: "Rilis ke internet dengan alamat sendiri, lalu pasang di portofoliomu." },
];
---

<Base title="Studio Proyek" description="Bangun proyek nyata untuk portofolio, dipandu dari brief sampai online. Segera hadir di Ruang Materi." canonical={`${SITE_URL}/studio-proyek`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="flex items-center gap-3 text-3xl font-extrabold sm:text-5xl"><Rocket aria-hidden className="size-8 sm:size-10" />Studio Proyek</h1>
          <span class="inline-flex items-center gap-2 rounded-full border-2 border-noir bg-matcha-300 px-4 py-2 text-sm leading-none font-extrabold tracking-wider text-noir uppercase shadow-[3px_3px_0_0_var(--color-noir)] sm:text-base"><span aria-hidden class="size-2.5 animate-pulse rounded-full bg-noir motion-reduce:animate-none"></span>Segera</span>
        </div>
        <p class="mt-3 max-w-2xl text-lg text-zinc-400">Tempat membangun proyek nyata dari nol sampai online, supaya kamu punya karya untuk portofolio. Kami sedang menyiapkannya.</p>

        <h2 class="mt-10 text-xl font-extrabold sm:text-2xl">Yang akan kamu lalui</h2>
        <ol class="mt-4 grid gap-3 sm:gap-4 md:grid-cols-2 xl:grid-cols-4">
          {STAGES.map((s, i) => (
            <li class={`flex flex-col gap-3 p-5 sm:p-6 ${card}`}>
              <div class="flex items-center justify-between">
                <span aria-hidden class="grid size-16 place-items-center rounded-2xl bg-matcha-100"><s.Icon className="size-11 text-noir" /></span>
                <span aria-hidden class="grid size-8 place-items-center rounded-full bg-noir font-(family-name:--font-bricolage) text-sm font-extrabold text-on-noir">{i + 1}</span>
              </div>
              <h3 class="font-(family-name:--font-bricolage) text-xl font-extrabold tracking-tight">{s.title}</h3>
              <p class="text-sm leading-relaxed text-zinc-400">{s.text}</p>
            </li>
          ))}
          <li class="flex flex-col justify-between gap-4 rounded-[18px] border-2 border-dashed border-zinc-700 p-5 sm:p-6">
            <p class="text-sm leading-relaxed text-zinc-400">Sambil menunggu, kerjakan proyek akhir di setiap kelas atau coba kodemu bebas di Playground.</p>
            <span class="flex flex-wrap gap-2">
              <a href="/kelas" class={secondaryButton}>Pilih kelas</a>
              <a href="/playground" class={secondaryButton}>Buka Playground<ArrowRight aria-hidden className="size-4" /></a>
            </span>
          </li>
        </ol>
      </div>
    </main>
  </div>
</Base>
