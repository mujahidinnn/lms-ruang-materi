---
import { ArrowRight, Rocket } from "lucide-react";
import { StudioAlur, StudioBrief, StudioDeploy, StudioDokumen, StudioIde, StudioNgoding, StudioRancang, StudioTeknologi } from "@/components/ui/icons";
import { card, secondaryButton } from "@/components/ui/styles";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { getCurrentUser } from "@/lib/dal";
import { doneItems, getDef, listDefs } from "@/lib/studio/data";
import { coverFor } from "@/lib/studio/covers";
import { LEVELS, STUDIO_FEATURE } from "@/lib/studio/stages";
import { createClient } from "@/lib/supabase/server";

// Early access: accounts in feature_access see the first project here. The
// page is per-visitor now, so it is not cached publicly.
const user = await getCurrentUser();
const early = user ? (await (await createClient()).rpc("has_feature", { p_feature: STUDIO_FEATURE })).data === true : false;
// Published projects with this learner's progress; empty for everyone else.
const projects = user && early
  ? await Promise.all((await listDefs()).filter((d) => d.status === "published").map(async (d) => {
      const [full, done] = await Promise.all([getDef(d.slug), doneItems(user.id, d.slug)]);
      const total = (full?.steps ?? []).reduce((n, s) => n + s.checks.length, 0);
      const count = (full?.steps ?? []).reduce((n, s) => n + s.checks.filter((c) => done.has(c.id)).length, 0);
      return { cover: coverFor(d.slug), slug: d.slug, title: d.title, summary: d.summary, level: d.level, hours: d.est_hours, total, done: count, pct: total ? Math.round((count / total) * 100) : 0 };
    }))
  : [];

// A real sequence, so the numbers mean something.
const STAGES = [
  { Icon: StudioBrief, title: "Brief", text: "Baca kebutuhan klien atau pengguna, lalu tentukan apa yang akan dibuat dan apa yang tidak." },
  { Icon: StudioIde, title: "Brainstorming", text: "Kumpulkan ide fitur, pilih yang paling berguna, dan gambar sketsa alurnya." },
  { Icon: StudioTeknologi, title: "Memilih teknologi", text: "Pilih bahasa, framework, dan database dengan alasan yang bisa kamu jelaskan di wawancara." },
  { Icon: StudioRancang, title: "Merancang", text: "Gambar alur layar dan susun struktur datanya, supaya saat ngoding kamu tahu apa yang dibuat lebih dulu." },
  { Icon: StudioNgoding, title: "Ngoding dan debugging", text: "Bangun fitur selangkah demi selangkah dengan commit rapi di Git, dan baca error untuk menelusuri bug seperti di pekerjaan nyata." },
  { Icon: StudioAlur, title: "Uji end-to-end", text: "Pastikan alur utama jalan dari awal sampai akhir sebelum dirilis." },
  { Icon: StudioDeploy, title: "Deploy dan online", text: "Rilis ke internet dengan alamat sendiri, lalu cek di HP dan pastikan semua tautan hidup." },
  { Icon: StudioDokumen, title: "Dokumentasi dan portofolio", text: "Tulis README yang jelas dengan tangkapan layar dan akun demo, lalu pasang proyek di portofoliomu." },
];
---

<Base title="Studio Proyek" description="Bangun proyek nyata untuk portofolio, dipandu dari brief sampai online. Segera hadir di Ruang Materi." canonical={`${SITE_URL}/studio-proyek`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="flex items-center gap-3 text-3xl font-extrabold sm:text-5xl"><Rocket aria-hidden className="size-8 sm:size-10" />Studio Proyek</h1>
          <span class="inline-flex items-center gap-2 rounded-full border-2 border-noir bg-matcha-300 px-4 py-2 text-sm leading-none font-extrabold tracking-wider text-noir uppercase shadow-[3px_3px_0_0_var(--color-noir)] sm:text-base"><span aria-hidden class="size-2.5 animate-pulse rounded-full bg-noir motion-reduce:animate-none"></span>{projects.length ? "Akses awal" : "Segera"}</span>
        </div>
        <p class="mt-3 max-w-2xl text-lg text-zinc-400">Tempat membangun proyek nyata dari nol sampai online, supaya kamu punya karya untuk portofolio.{projects.length ? ` Ada ${projects.length} proyek dari tingkat pemula sampai pro.` : " Kami sedang menyiapkannya."}</p>

        {early && projects.length > 0 && (
          <section aria-labelledby="proyek-judul" class="mt-8">
            <h2 id="proyek-judul" class="text-xl font-extrabold sm:text-2xl">Proyek yang bisa kamu kerjakan</h2>
            <p class="mt-1 text-sm text-zinc-400">Akses awal, hanya untuk akunmu.</p>
            <ul class="mt-4 grid gap-4 md:grid-cols-2">
              {projects.map((p) => (
                <li>
                  <a href={`/studio-proyek/${p.slug}`} class="group flex h-full flex-col gap-3 rounded-[18px] border-2 border-noir bg-matcha-100 p-5 text-noir shadow-[4px_4px_0_0_var(--color-noir)] sm:p-6">
                    {p.cover
                      ? <span class="relative block"><img src={p.cover} alt="" width="800" height="597" loading="lazy" decoding="async" class="aspect-[2/1] w-full rounded-xl border-2 border-noir bg-[#f2f1e9] object-contain" /><span class="absolute top-3 right-3 rounded-full border-2 border-noir bg-matcha-300 px-3 py-1 text-xs font-bold">{LEVELS[p.level]}{p.hours ? ` · ${p.hours} jam` : ""}</span></span>
                      : <span class="flex items-center justify-between gap-3">
                          <span aria-hidden class="grid size-12 place-items-center rounded-2xl bg-noir text-on-noir"><Rocket className="size-6" /></span>
                          <span class="rounded-full bg-noir/10 px-3 py-1 text-xs font-bold">{LEVELS[p.level]}{p.hours ? ` · ${p.hours} jam` : ""}</span>
                        </span>}
                    <span class="font-(family-name:--font-bricolage) text-xl font-extrabold tracking-tight sm:text-2xl">{p.title}</span>
                    {p.summary && <span class="text-sm leading-relaxed text-noir/80">{p.summary}</span>}
                    <span class="mt-auto pt-2">
                      <span aria-hidden="true" class="block h-2 rounded-full bg-noir/15"><span class="block h-full rounded-full bg-noir" style={{ width: `${p.pct}%` }}></span></span>
                      <span class="mt-1.5 flex items-center justify-between text-xs font-bold tabular-nums"><span>{p.done} dari {p.total} butir</span><span class="inline-flex items-center gap-1">{p.done === 0 ? "Mulai" : "Lanjutkan"}<ArrowRight aria-hidden className="size-3.5 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" /></span></span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <h2 class="mt-10 text-xl font-extrabold sm:text-2xl">Yang akan kamu lalui</h2>
        <ol class="mt-4 grid gap-3 sm:gap-4 md:grid-cols-2 xl:grid-cols-4">
          {STAGES.map((s, i) => (
            <li class={`flex flex-col gap-3 p-5 sm:p-6 ${card}`}>
              <div class="flex items-center justify-between">
                <span aria-hidden class="grid size-16 place-items-center rounded-2xl bg-matcha-100"><s.Icon className="size-11 text-noir" /></span>
                <span aria-hidden class="grid size-8 place-items-center rounded-full bg-noir font-(family-name:--font-bricolage) text-sm font-extrabold text-on-noir">{i + 1}</span>
              </div>
              <h3 class="font-(family-name:--font-bricolage) text-xl font-extrabold tracking-tight">{s.title}</h3>
              <p class="text-sm leading-relaxed text-zinc-400">{s.text}</p>
            </li>
          ))}
        </ol>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-[18px] border-2 border-dashed border-zinc-700 p-5 sm:p-6">
          <p class="max-w-xl text-sm leading-relaxed text-zinc-400">{projects.length ? "Butuh dasar dulu? Pelajari kelasnya atau coba kodemu bebas di Playground." : "Sambil menunggu, kerjakan proyek akhir di setiap kelas atau coba kodemu bebas di Playground."}</p>
          <span class="flex flex-wrap gap-2">
            <a href="/kelas" class={secondaryButton}>Pilih kelas</a>
            <a href="/playground" class={secondaryButton}>Buka Playground<ArrowRight aria-hidden className="size-4" /></a>
          </span>
        </div>
      </div>
    </main>
  </div>
</Base>
