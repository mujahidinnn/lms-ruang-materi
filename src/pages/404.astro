---
import { BookOpen } from "lucide-react";
import { primaryButton } from "@/components/ui/styles";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Halaman tidak ditemukan" noindex>
  <SiteHeader />
  <main class="flex flex-1 flex-col items-center justify-center px-6 py-20 text-center">
    <div class="flex items-end justify-center overflow-hidden rounded-[28px] border-2 border-noir bg-matcha-100 px-6 pt-4 h-60 w-48"><img src="/ilustrasi/hilang.svg" alt="" width="890" height="1220" loading="lazy" decoding="async" class="h-full w-auto" /></div>
    <h1 class="mt-6 text-3xl font-bold tracking-tight">Halaman tidak ditemukan</h1>
    <p class="mt-2 max-w-sm text-zinc-400">Mungkin materinya sudah dipindah atau alamatnya salah ketik.</p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
      <a href="/kelas" class={primaryButton}><BookOpen aria-hidden className="size-4" />Lihat semua kelas</a>
      <a href="/" class="text-zinc-400 hover:text-zinc-50">Ke beranda</a>
    </div>
  </main>
</Base>
