---
import { ArrowLeft, ArrowRight, Check, Clock } from "lucide-react";
import SubmitUrl from "@/components/studio/SubmitUrl";
import { StudioAlur, StudioBrief, StudioDeploy, StudioDokumen, StudioIde, StudioNgoding, StudioRancang, StudioTeknologi } from "@/components/ui/icons";
import { card, primaryButton } from "@/components/ui/styles";
import { getCurrentUser } from "@/lib/dal";
import { doneItems, getDef } from "@/lib/studio/data";
import { LEVELS, STAGES } from "@/lib/studio/stages";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../../../components/SiteHeader.astro";
import StudioProgress from "../../../components/StudioProgress.astro";
import Base from "../../../layouts/Base.astro";

const user = await getCurrentUser();
if (!user) return Astro.rewrite("/404");
const { slug } = Astro.params as { slug: string };
const data = await getDef(slug);
if (!data || (data.def.status !== "published" && user.role !== "admin")) return Astro.rewrite("/404");
const { def, steps } = data;
const db = await createClient();
const [done, { data: proj }, { data: me }] = await Promise.all([
  doneItems(user.id, def.slug),
  db.from("studio_projects").select("url").eq("user_id", user.id).eq("project", def.slug).maybeSingle(),
  db.from("profiles").select("public_handle").eq("user_id", user.id).single(),
]);
const total = steps.reduce((n, s) => n + s.checks.length, 0);
const doneCount = steps.reduce((n, s) => n + s.checks.filter((c) => done.has(c.id)).length, 0);
const stepDone = (s: (typeof steps)[number]) => s.checks.filter((c) => done.has(c.id)).length;
const finished = (s: (typeof steps)[number]) => s.checks.length > 0 && stepDone(s) === s.checks.length;
const resume = steps.find((s) => !finished(s)) ?? steps[0];
const ICON = { brief: StudioBrief, brainstorming: StudioIde, teknologi: StudioTeknologi, merancang: StudioRancang, ngoding: StudioNgoding, uji: StudioAlur, deploy: StudioDeploy, dokumentasi: StudioDokumen };
---

<Base title={def.title} description={def.summary || `Panduan proyek ${def.title}.`} noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-3xl">
        <a href="/studio-proyek" class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-zinc-400 hover:text-zinc-50"><ArrowLeft aria-hidden className="size-4" />Studio Proyek</a>
        {def.status === "draft" && <p class="mt-2 inline-block rounded-full bg-tile-butter px-3 py-1 text-xs font-bold text-zinc-50">Draf, hanya admin yang melihat ini</p>}
        <h1 class="mt-1 text-3xl font-extrabold text-balance sm:text-5xl">{def.title}</h1>
        <ul class="mt-3 flex flex-wrap gap-2 text-xs font-bold">
          <li class="rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 shadow-soft">{LEVELS[def.level]}</li>
          {def.est_hours && <li class="inline-flex items-center gap-1 rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 shadow-soft"><Clock aria-hidden className="size-3.5" />sekitar {def.est_hours} jam</li>}
          <li class="rounded-full bg-zinc-900 px-3 py-1 tabular-nums text-zinc-300 shadow-soft">{steps.length} langkah</li>
        </ul>
        {def.summary && <p class="mt-4 max-w-xl text-lg text-zinc-400">{def.summary}</p>}

        {steps.length > 0 && (
          <div class={`mt-6 flex flex-wrap items-center gap-4 p-5 ${card}`}>
            <div class="min-w-0 flex-1 basis-56"><StudioProgress total={total} done={doneCount} /></div>
            <a href={`/studio-proyek/${def.slug}/${resume.slug}`} class={primaryButton}>{doneCount === 0 ? "Mulai" : doneCount === total ? "Tinjau lagi" : "Lanjutkan"}<ArrowRight aria-hidden className="size-4" /></a>
          </div>
        )}

        <ol class="mt-8 grid gap-4">
          {STAGES.filter((st) => steps.some((s) => s.stage === st.id)).map((st, n) => {
            const Icon = ICON[st.id];
            return (
              <li>
                <section aria-labelledby={`tahap-${st.id}`} class={`p-5 sm:p-6 ${card}`}>
                  <div class="flex items-center gap-4">
                    <span aria-hidden class="grid size-14 shrink-0 place-items-center rounded-2xl bg-matcha-100"><Icon className="size-10 text-noir" /></span>
                    <div>
                      <p class="text-xs font-semibold text-zinc-400">Tahap {STAGES.findIndex((x) => x.id === st.id) + 1} dari {STAGES.length}</p>
                      <h2 id={`tahap-${st.id}`} class="font-(family-name:--font-bricolage) text-xl font-extrabold tracking-tight sm:text-2xl">{st.title}</h2>
                    </div>
                  </div>
                  <ul class="mt-3 grid gap-1">
                    {steps.filter((s) => s.stage === st.id).map((s) => (
                      <li>
                        <a href={`/studio-proyek/${def.slug}/${s.slug}`} class="flex min-h-12 items-center gap-3 rounded-xl px-2 hover:bg-zinc-800/60">
                          <span aria-hidden class:list={["grid size-7 shrink-0 place-items-center rounded-full border-2 border-noir text-xs font-bold tabular-nums", finished(s) ? "bg-matcha-300 text-noir" : "bg-zinc-900"]}>{finished(s) ? <Check className="size-4" strokeWidth={3} /> : steps.indexOf(s) + 1}</span>
                          <span class="min-w-0 flex-1 font-medium">{s.title}</span>
                          {s.est_minutes && <span class="text-xs text-zinc-500 max-sm:hidden">{s.est_minutes} menit</span>}
                          {s.checks.length > 0 && <span class="text-xs tabular-nums text-zinc-400">{stepDone(s)}/{s.checks.length}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              </li>
            );
          })}
        </ol>

        <section id="hasil" aria-labelledby="hasil-judul" class={`mt-8 scroll-mt-6 p-5 sm:p-6 ${card}`}>
          <h2 id="hasil-judul" class="text-xl font-extrabold">Kirim hasil akhir</h2>
          <p class="mt-1 mb-4 text-sm text-zinc-400">Tempel alamat proyekmu yang sudah online. Kalau profil publikmu aktif, alamat ini tampil di sana sebagai karyamu.</p>
          <SubmitUrl client:load project={def.slug} saved={proj?.url ?? null} handle={me?.public_handle ?? null} />
        </section>
      </div>
    </main>
  </div>
</Base>
