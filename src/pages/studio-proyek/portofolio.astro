---
import { ArrowLeft } from "lucide-react";
import Checklist from "@/components/studio/Checklist";
import SubmitUrl from "@/components/studio/SubmitUrl";
import { StudioAlur, StudioBrief, StudioDeploy, StudioDokumen, StudioIde, StudioNgoding, StudioRancang, StudioTeknologi } from "@/components/ui/icons";
import { card, secondaryButton } from "@/components/ui/styles";
import { getCurrentUser } from "@/lib/dal";
import { PORTOFOLIO_STEPS, STUDIO_FEATURE, STUDIO_PROJECT, STUDIO_TITLES } from "@/lib/studio/portofolio";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../../components/SiteHeader.astro";
import StudioProgress from "../../components/StudioProgress.astro";
import Base from "../../layouts/Base.astro";

// Early access: signed-in accounts listed in feature_access only. Anyone else
// gets the same 404 as a page that does not exist.
const user = await getCurrentUser();
if (!user) return Astro.rewrite("/404");
const db = await createClient();
const { data: allowed } = await db.rpc("has_feature", { p_feature: STUDIO_FEATURE });
if (allowed !== true) return Astro.rewrite("/404");

const [{ data: checks }, { data: proj }, { data: me }] = await Promise.all([
  db.from("studio_checks").select("item").eq("user_id", user.id).eq("project", STUDIO_PROJECT),
  db.from("studio_projects").select("url").eq("user_id", user.id).eq("project", STUDIO_PROJECT).maybeSingle(),
  db.from("profiles").select("public_handle").eq("user_id", user.id).single(),
]);
const done = new Set((checks ?? []).map((c) => c.item));
const total = PORTOFOLIO_STEPS.reduce((n, s) => n + s.items.length, 0);
const doneCount = PORTOFOLIO_STEPS.reduce((n, s) => n + s.items.filter((x) => done.has(x.id)).length, 0);
const ICONS = [StudioBrief, StudioIde, StudioTeknologi, StudioRancang, StudioNgoding, StudioAlur, StudioDeploy, StudioDokumen];
---

<Base title={STUDIO_TITLES[STUDIO_PROJECT]} description="Panduan membangun website portofolio pribadi dari brief sampai online." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-3xl">
        <a href="/studio-proyek" class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-zinc-400 hover:text-zinc-50"><ArrowLeft aria-hidden className="size-4" />Studio Proyek</a>
        <h1 class="mt-1 text-3xl font-extrabold text-balance sm:text-5xl">{STUDIO_TITLES[STUDIO_PROJECT]}</h1>
        <p class="mt-3 max-w-xl text-lg text-zinc-400">Bangun situs portofolio pertamamu, dari menentukan siapa pembacanya sampai alamatnya bisa dibuka siapa saja. Centang tiap butir setelah selesai.</p>
        <div class={`mt-6 p-5 ${card}`}><StudioProgress total={total} done={doneCount} /></div>

        <ol class="mt-8 grid gap-4">
          {PORTOFOLIO_STEPS.map((s, n) => {
            const Icon = ICONS[n];
            return (
              <li>
                <section aria-labelledby={`tahap-${s.id}`} class={`p-5 sm:p-6 ${card}`}>
                  <div class="flex items-center gap-4">
                    <span aria-hidden class="grid size-14 shrink-0 place-items-center rounded-2xl bg-matcha-100"><Icon className="size-10 text-noir" /></span>
                    <div class="min-w-0 flex-1">
                      <p class="text-xs font-semibold text-zinc-400">Tahap {n + 1} dari {PORTOFOLIO_STEPS.length}</p>
                      <h2 id={`tahap-${s.id}`} class="font-(family-name:--font-bricolage) text-xl font-extrabold tracking-tight sm:text-2xl">{s.title}</h2>
                    </div>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-zinc-400">{s.intro}</p>
                  <div class="mt-3"><Checklist client:load project={STUDIO_PROJECT} items={s.items} done={s.items.filter((x) => done.has(x.id)).map((x) => x.id)} /></div>
                  {s.links && (
                    <p class="mt-3 flex flex-wrap gap-2">
                      {s.links.map((l) => <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined} class={secondaryButton}>{l.label}</a>)}
                    </p>
                  )}
                  {s.id === "dokumentasi" && (
                    <div class="mt-5 border-t border-zinc-800 pt-5">
                      <h3 class="font-bold">Pasang di profilmu</h3>
                      <p class="mt-1 mb-3 text-sm text-zinc-400">Tempel alamat situsmu. Kalau profil publikmu aktif, alamat ini tampil di sana sebagai karyamu.</p>
                      <SubmitUrl client:load project={STUDIO_PROJECT} saved={proj?.url ?? null} handle={me?.public_handle ?? null} />
                    </div>
                  )}
                </section>
              </li>
            );
          })}
        </ol>
      </div>
    </main>
  </div>
</Base>
