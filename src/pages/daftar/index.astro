---
import DaftarForm from "@/components/auth/DaftarForm";
import { safeNext } from "@/lib/safe-next";
import AuthShell from "../../components/AuthShell.astro";
import GoogleButton from "../../components/GoogleButton.astro";
import Base from "../../layouts/Base.astro";

const next = safeNext(Astro.url.searchParams.get("next"), "/dasbor");
---

<Base title="Daftar" description="Buat akun Ruang Materi gratis untuk menyimpan progres belajar dan mendapat sertifikat." noindex>
  <AuthShell current="daftar" next={next}>
    <GoogleButton next={next} label="Daftar dengan Google" />
    <DaftarForm client:load next={next} />
  </AuthShell>
</Base>
