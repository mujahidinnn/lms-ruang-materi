---
import Celebrate from "@/components/exam/Celebrate";
import ExamReview, { type Review } from "@/components/exam/ExamReview";
import ExamRunner, { type ExamQuestion } from "@/components/exam/ExamRunner";
import { secondsLeft, timedOut } from "@/lib/exam";
import { createClient } from "@/lib/supabase/server";
import Base from "../../../layouts/Base.astro";
import { signedIn } from "../../../lib/guard";

// No site header while an exam runs: fewer ways to leave by accident.
const { slug, attempt } = Astro.params as { slug: string; attempt: string };
const user = await signedIn(Astro);
if (user instanceof Response) return user;
if (!/^[0-9a-f-]{36}$/.test(attempt)) return Astro.rewrite("/404");
const db = await createClient();

const { data: a } = await db.from("exam_attempts").select("id, deadline, submitted_at").eq("id", attempt).maybeSingle();
if (!a) return Astro.rewrite("/404");

const review = a.submitted_at ? ((await db.rpc("exam_attempt_review", { p_attempt: a.id })).data as Review) : null;
const late = !review && timedOut(a.deadline);
const questions = review || late ? null : ((await db.rpc("exam_attempt_questions", { p_attempt: a.id })).data as ExamQuestion[]);
---

<Base title="Ujian" description="Kerjakan ujian atau lihat pembahasan percobaanmu." noindex>
  <main class="flex-1 px-5 pt-0 pb-20 sm:px-10">
    <div class="mx-auto max-w-2xl">
      {review ? (
        <div class="pt-10">
          <a href={`/ujian/${slug}`} class="text-sm text-zinc-400 hover:text-zinc-50">Kembali ke ujian</a>
          <h1 class="sr-only">Hasil ujian</h1>
          {review.passed && <Celebrate client:load />}
          <div class="mt-6"><ExamReview review={review} slug={slug} /></div>
        </div>
      ) : late ? (
        <div class="pt-10">
          <a href={`/ujian/${slug}`} class="text-sm text-zinc-400 hover:text-zinc-50">Kembali ke ujian</a>
          <h1 class="mt-6 text-3xl font-bold tracking-tight">Waktu habis</h1>
          <p class="mt-2 text-zinc-400">Jawaban percobaan ini tidak sempat terkumpul, jadi tidak dinilai. Percobaan ini tetap terhitung.</p>
        </div>
      ) : (
        <>
          <h1 class="sr-only">Ujian</h1>
          <ExamRunner client:load attemptId={a.id} secondsLeft={secondsLeft(a.deadline)} questions={questions!} />
        </>
      )}
    </div>
  </main>
</Base>
