---
import { Bookmark, BookOpen, Check, Target, Trophy, ClipboardCheck, Code2, Megaphone, Play, Presentation, ShieldCheck, X } from "lucide-react";
import { Api, Kartu, Medali } from "@/components/ui/icons";
import { card, chip, primaryButton, secondaryButton, tile } from "@/components/ui/styles";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { signedIn } from "../lib/guard";

// Dashboard: the one next step, then the classes the learner follows.
// The next step reads certificate_status(), the same rule as the class page.
const user = await signedIn(Astro);
if (user instanceof Response) return user;

const db = await createClient();
const { data: me } = await db.from("profiles").select("display_name, guardian_consent, weekly_goal").eq("user_id", user.id).single();
// A name and the guardian consent come first (/mulai), so progress saves.
if (!me?.display_name?.trim() || (user.role !== "admin" && !me.guardian_consent)) return Astro.redirect("/mulai?next=/dasbor");
const name = me.display_name.trim();

type Row = {
  state: string;
  last_slide: number;
  topics: { id: string; slug: string; title: string; slides: { count: number }[]; chapters: { id: string; slug: string; title: string; position: number }[] } | null;
};
const [{ data: progress }, { data: doneRows }, { data: streak }, { data: queue }, { data: notices }, { data: saved }, { data: weekDone }] = await Promise.all([
  db.from("progress").select("state, last_slide, topics(id, slug, title, slides(count), chapters(id, slug, title, position))").eq("user_id", user.id).order("updated_at", { ascending: false }),
  db.from("chapter_progress").select("chapter_id").eq("user_id", user.id),
  db.from("learning_streaks").select("current_days").eq("user_id", user.id).maybeSingle(),
  db.rpc("flashcard_queue"),
  db.from("announcements").select("id, title, body, link_url").eq("on_web", true).gte("created_at", new Date(Date.now() - 30 * 864e5).toISOString()).order("created_at", { ascending: false }).limit(1),
  db.from("chapter_notes").select("note, bookmarked, chapters(slug, title, topics(slug, title))").eq("user_id", user.id).order("updated_at", { ascending: false }).limit(6),
  db.rpc("my_week_chapters"),
]);
type Saved = { note: string; bookmarked: boolean; chapters: { slug: string; title: string; topics: { slug: string; title: string } } | null };
const keep = ((saved ?? []) as unknown as Saved[]).filter((n) => n.chapters);
const notice = notices?.[0];
const done = new Set((doneRows ?? []).map((r) => r.chapter_id));
// RLS returns only published chapters; a pulled topic comes back null.
const classes = ((progress ?? []) as unknown as Row[])
  .filter((r) => r.topics && r.state !== "dilewati")
  .map((r) => {
    const t = r.topics!;
    const chapters = t.chapters.toSorted((a, b) => a.position - b.position);
    return { ...t, state: r.state, lastSlide: r.last_slide, chapters, chaptersDone: chapters.filter((c) => done.has(c.id)).length, slideCount: t.slides[0]?.count ?? 0 };
  });

// The class to continue: the most recent one that is not finished.
const current = classes.find((c) => c.state !== "selesai");
type Status = { chapters_done: number; chapters_total: number; exam_passed: boolean; project_required: boolean; project_passed: boolean; eligible: boolean; code: string | null };
const [{ data: status }, { data: exam }] = current
  ? await Promise.all([db.rpc("certificate_status", { p_topic: current.id }), db.from("exams").select("id").eq("topic_id", current.id).maybeSingle()])
  : [{ data: null }, { data: null }];
const s = status as Status | null;

// One step, in the order of the class path.
let step: { label: string; title: string; href: string; icon: (p: { class?: string; className?: string }) => unknown } | null = null;
if (current && s) {
  const nextChapter = current.chapters.find((c) => !done.has(c.id));
  if (current.chapters.length === 0) step = { label: "Lanjutkan slide", title: current.title, href: `/belajar/${current.slug}`, icon: Presentation };
  else if (nextChapter) step = { label: `Bab ${current.chapters.indexOf(nextChapter) + 1} dari ${current.chapters.length}`, title: nextChapter.title, href: `/belajar/${current.slug}/${nextChapter.slug}`, icon: Play };
  else if (exam && !s.exam_passed) step = { label: "Semua bab selesai", title: `Ujian akhir ${current.title}`, href: `/ujian/${current.slug}`, icon: ClipboardCheck };
  else if (s.project_required && !s.project_passed) step = { label: "Tinggal satu langkah", title: "Proyek akhir", href: `/belajar/${current.slug}/proyek`, icon: Code2 };
  else if (s.eligible && !s.code) step = { label: "Semua syarat terpenuhi", title: "Klaim sertifikat", href: `/belajar/${current.slug}`, icon: Medali };
}
const due = ((queue ?? []) as unknown[]).length;
const days = streak?.current_days ?? 0;
---

<Base title="Dashboard" description="Langkah belajarmu berikutnya dan kelas yang sedang kamu ikuti." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto grid max-w-7xl gap-5 sm:gap-8">
        {user.role === "admin" && (
          <a href="/admin" class={`${secondaryButton} w-fit`}><ShieldCheck aria-hidden className="size-4" />Buka panel admin</a>
        )}
        {notice && (
          <section data-pengumuman={notice.id} aria-label="Pengumuman" class="relative rounded-[18px] bg-tile-butter p-5 pr-14 ring-1 ring-zinc-800">
            <p class="flex items-center gap-2 text-sm font-semibold"><Megaphone aria-hidden className="size-4" />Pengumuman</p>
            <h2 class="mt-2 text-lg font-bold tracking-tight">{notice.title}</h2>
            <p class="mt-1 max-w-prose text-sm leading-relaxed whitespace-pre-line">{notice.body}</p>
            {notice.link_url && <a href={notice.link_url} class={`${secondaryButton} mt-4`}>Buka</a>}
            <button type="button" data-tutup aria-label="Tutup pengumuman" class="absolute top-3 right-3 grid size-11 cursor-pointer place-items-center rounded-full hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-accent"><X aria-hidden className="size-4" /></button>
          </section>
          <script>
            // Closing hides this announcement for this browser only.
            const box = document.querySelector<HTMLElement>("[data-pengumuman]");
            const key = "ruang-materi:pengumuman";
            if (box) {
              try { if (localStorage.getItem(key) === box.dataset.pengumuman) box.hidden = true; } catch {}
              box.querySelector("[data-tutup]")?.addEventListener("click", () => {
                box.hidden = true;
                try { localStorage.setItem(key, box.dataset.pengumuman ?? ""); } catch {}
              });
            }
          </script>
        )}
        <section aria-labelledby="sapa" class="relative overflow-hidden rounded-[18px] bg-noir p-5 text-on-noir sm:rounded-[18px] ring-1 ring-zinc-800 sm:p-8">
          <div aria-hidden="true" class="absolute right-8 bottom-0 hidden h-56 w-40 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-4 lg:flex"><img src="/ilustrasi/kode.svg" alt="" width="890" height="1220" class="h-full w-auto -scale-x-100" /></div>
          <h1 id="sapa" class="relative text-3xl font-extrabold sm:text-5xl">
            Hai, <span class="inline-block -rotate-2 rounded-xl border-2 border-on-noir bg-matcha-300 px-3 text-noir">{name}</span>
          </h1>
          {step ? (
            <a href={step.href} class="group relative mt-4 flex max-w-2xl flex-wrap items-center gap-3 rounded-[18px] bg-on-noir/10 p-3 sm:mt-6 sm:gap-4 sm:p-4 hover:bg-on-noir/15 sm:p-5">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-matcha-300 text-noir [--icon-tint:var(--color-matcha-600)]"><step.icon aria-hidden className="size-6" /></span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold text-matcha-200">Langkah berikutnya: {step.label}</span>
                <span class="mt-0.5 block text-lg leading-snug font-bold">{step.title}</span>
                {current && step.title !== current.title && <span class="block text-sm text-on-noir/60">{current.title}</span>}
              </span>
              <span class={`${primaryButton} max-sm:w-full shrink-0`}>Mulai</span>
            </a>
          ) : (
            <div class="relative mt-4 max-w-xl">
              <p class="text-on-noir/75">{classes.length ? "Semua kelas yang kamu ikuti sudah selesai. Pilih kelas berikutnya." : "Pilih kelas pertamamu. Kamu bebas mulai dari mana saja."}</p>
              <a href="/kelas" class={`${primaryButton} mt-5`}><BookOpen aria-hidden className="size-4" />Jelajahi kelas</a>
            </div>
          )}
          <ul class="relative mt-3 flex flex-wrap gap-1.5 text-sm sm:mt-6 sm:gap-2">
            <li class="inline-flex items-center gap-1.5 rounded-full bg-on-noir/10 px-3 py-1"><Api className="size-6 text-on-noir [--icon-paper:var(--noir)]" />{days ? `Streak ${days} hari` : "Belajar hari ini untuk mulai streak"}</li>
            <li class="max-sm:order-last"><a href="/flashcard" class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-on-noir/10 px-3 sm:min-h-11 sm:px-4 hover:bg-on-noir/20"><Kartu className="size-6 text-on-noir [--icon-paper:var(--noir)]" />{due > 0 ? `${due} flashcard siap diulang` : "Flashcard"}</a></li>
            <li><a href="/nilai" class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-on-noir/10 px-3 sm:min-h-11 sm:px-4 hover:bg-on-noir/20"><Medali className="size-6 text-on-noir [--icon-paper:var(--noir)]" />Pencapaian</a></li>
          </ul>
        </section>

        <section aria-labelledby="target" class={`flex flex-wrap items-center gap-4 p-4 sm:p-5 ${card}`}>
          <span aria-hidden class="grid size-12 shrink-0 place-items-center rounded-xl bg-tile-mint text-zinc-50"><Target className="size-6" /></span>
          {me.weekly_goal ? (
            <div class="min-w-0 flex-1 basis-56">
              <h2 id="target" class="font-bold">Target minggu ini: <span class="tabular-nums">{Math.min(weekDone ?? 0, me.weekly_goal)} dari {me.weekly_goal} bab</span>{(weekDone ?? 0) >= me.weekly_goal && " 🎉"}</h2>
              <span aria-hidden="true" class="mt-2 block h-2 rounded-full bg-zinc-800"><span class="block h-full rounded-full bg-brand" style={{ width: `${Math.min(100, Math.round(((weekDone ?? 0) / me.weekly_goal) * 100))}%` }} /></span>
            </div>
          ) : (
            <div class="min-w-0 flex-1 basis-56">
              <h2 id="target" class="font-bold">Belum punya target belajar</h2>
              <p class="text-sm text-zinc-400">Atur berapa bab per minggu yang ingin kamu selesaikan.</p>
            </div>
          )}
          <span class="flex flex-wrap gap-2">
            <a href="/profil" class={secondaryButton}>{me.weekly_goal ? "Ubah target" : "Atur target"}</a>
            <a href="/peringkat" class={secondaryButton}><Trophy aria-hidden className="size-4" />Peringkat</a>
          </span>
        </section>

        <section aria-labelledby="kelasku">
          <div class="flex items-center justify-between gap-3">
            <h2 id="kelasku" class="text-xl sm:text-2xl font-extrabold">Kelas yang kamu ikuti</h2>
            <a href="/kelas" class="inline-flex min-h-9 items-center text-sm font-semibold text-accent sm:min-h-11 hover:underline">Lihat semua<span class="max-sm:hidden">&nbsp;kelas</span></a>
          </div>
          {classes.length ? (
            <ul class="mt-2 grid gap-3 sm:mt-4 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
              {classes.map((c, i) => {
                const total = c.chapters.length || c.slideCount;
                const at = c.chapters.length ? c.chaptersDone : Math.min(c.lastSlide + 1, c.slideCount);
                const pct = total ? Math.round((at / total) * 100) : 0;
                return (
                  <li>
                    <a href={`/belajar/${c.slug}`} class={`flex h-full flex-col rounded-[18px] p-4 sm:rounded-[18px] sm:p-5 sm:transition-transform hover:-translate-y-0.5 motion-reduce:transition-none ${tile(i)}`}>
                      <span class="flex items-start justify-between gap-3">
                        <span class="text-lg leading-snug font-bold text-zinc-50">{c.title}</span>
                        {c.state === "selesai" && <span class={`${chip} shrink-0 border-2 border-noir bg-matcha-300 font-bold text-noir`}><Check aria-hidden className="size-3.5" />Selesai</span>}
                      </span>
                      <span class="mt-auto pt-3 text-xs sm:pt-6 font-semibold text-zinc-300 tabular-nums">{c.chapters.length ? `${at} dari ${total} bab` : `Slide ${at} dari ${total}`}</span>
                      <span aria-hidden="true" class="mt-1.5 h-2 rounded-full bg-zinc-900/60"><span class="block h-full rounded-full bg-zinc-50" style={{ width: `${pct}%` }} /></span>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class={`mt-4 flex items-center gap-6 p-6 ${card}`}>
              <div class="flex items-end justify-center overflow-hidden rounded-[18px] border-2 border-noir bg-matcha-100 pt-4 h-36 w-28 shrink-0 px-2"><img src="/ilustrasi/baca.svg" alt="" width="890" height="1220" loading="lazy" decoding="async" class="h-full w-auto" /></div>
              <div>
                <p class="text-zinc-400">Belum ada. Kelas yang kamu buka akan muncul di sini dengan progresnya.</p>
                <a href="/kelas" class={`${primaryButton} mt-4`}><BookOpen aria-hidden className="size-4" />Pilih kelas pertama</a>
              </div>
            </div>
          )}
        </section>

        {keep.length > 0 && (
          <section aria-labelledby="simpanan">
            <h2 id="simpanan" class="text-xl sm:text-2xl font-extrabold">Bab ditandai dan catatanmu</h2>
            <ul class="mt-2 grid gap-3 sm:mt-4 sm:grid-cols-2 sm:gap-4">
              {keep.map((n) => (
                <li>
                  <a href={`/belajar/${n.chapters!.topics.slug}/${n.chapters!.slug}`} class={`flex h-full flex-col gap-1 p-4 hover:bg-zinc-800 sm:p-5 ${card}`}>
                    <span class="flex items-center gap-2 text-xs font-semibold text-zinc-400">{n.bookmarked && <Bookmark aria-hidden className="size-3.5 fill-current text-accent" />}{n.chapters!.topics.title}</span>
                    <span class="font-bold">{n.chapters!.title}</span>
                    {n.note && <span class="line-clamp-2 text-sm text-zinc-400">{n.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </main>
  </div>
</Base>
