---
import { Award, BookOpen, Check, ClipboardCheck, Code2, Flame, Layers, Play, Presentation } from "lucide-react";
import { Welcome } from "@/components/illustrations";
import { card, chip, primaryButton, tile } from "@/components/ui/styles";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { signedIn } from "../lib/guard";

// Dashboard: the one next step, then the classes the learner follows.
// The next step reads certificate_status(), the same rule as the class page.
const user = await signedIn(Astro);
if (user instanceof Response) return user;

const db = await createClient();
const { data: me } = await db.from("profiles").select("display_name, guardian_consent").eq("user_id", user.id).single();
// A name and the guardian consent come first (/mulai), so progress saves.
if (!me?.display_name?.trim() || (user.role !== "admin" && !me.guardian_consent)) return Astro.redirect("/mulai?next=/dasbor");
const name = me.display_name.trim();

type Row = {
  state: string;
  last_slide: number;
  topics: { id: string; slug: string; title: string; slides: { count: number }[]; chapters: { id: string; slug: string; title: string; position: number }[] } | null;
};
const [{ data: progress }, { data: doneRows }, { data: streak }, { data: queue }] = await Promise.all([
  db.from("progress").select("state, last_slide, topics(id, slug, title, slides(count), chapters(id, slug, title, position))").eq("user_id", user.id).order("updated_at", { ascending: false }),
  db.from("chapter_progress").select("chapter_id").eq("user_id", user.id),
  db.from("learning_streaks").select("current_days").eq("user_id", user.id).maybeSingle(),
  db.rpc("flashcard_queue"),
]);
const done = new Set((doneRows ?? []).map((r) => r.chapter_id));
// RLS returns only published chapters; a pulled topic comes back null.
const classes = ((progress ?? []) as unknown as Row[])
  .filter((r) => r.topics && r.state !== "dilewati")
  .map((r) => {
    const t = r.topics!;
    const chapters = t.chapters.toSorted((a, b) => a.position - b.position);
    return { ...t, state: r.state, lastSlide: r.last_slide, chapters, chaptersDone: chapters.filter((c) => done.has(c.id)).length, slideCount: t.slides[0]?.count ?? 0 };
  });

// The class to continue: the most recent one that is not finished.
const current = classes.find((c) => c.state !== "selesai");
type Status = { chapters_done: number; chapters_total: number; exam_passed: boolean; project_required: boolean; project_passed: boolean; eligible: boolean; code: string | null };
const [{ data: status }, { data: exam }] = current
  ? await Promise.all([db.rpc("certificate_status", { p_topic: current.id }), db.from("exams").select("id").eq("topic_id", current.id).maybeSingle()])
  : [{ data: null }, { data: null }];
const s = status as Status | null;

// One step, in the order of the class path.
let step: { label: string; title: string; href: string; icon: typeof Play } | null = null;
if (current && s) {
  const nextChapter = current.chapters.find((c) => !done.has(c.id));
  if (current.chapters.length === 0) step = { label: "Lanjutkan slide", title: current.title, href: `/belajar/${current.slug}`, icon: Presentation };
  else if (nextChapter) step = { label: `Bab ${current.chapters.indexOf(nextChapter) + 1} dari ${current.chapters.length}`, title: nextChapter.title, href: `/belajar/${current.slug}/${nextChapter.slug}`, icon: Play };
  else if (exam && !s.exam_passed) step = { label: "Semua bab selesai", title: `Ujian akhir ${current.title}`, href: `/ujian/${current.slug}`, icon: ClipboardCheck };
  else if (s.project_required && !s.project_passed) step = { label: "Tinggal satu langkah", title: "Proyek akhir", href: `/belajar/${current.slug}/proyek`, icon: Code2 };
  else if (s.eligible && !s.code) step = { label: "Semua syarat terpenuhi", title: "Terbitkan sertifikat", href: `/belajar/${current.slug}`, icon: Award };
}
const due = ((queue ?? []) as unknown[]).length;
const days = streak?.current_days ?? 0;
---

<Base title="Dashboard" description="Langkah belajarmu berikutnya dan kelas yang sedang kamu ikuti." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto grid max-w-6xl gap-8">
        <section aria-labelledby="sapa" class="relative overflow-hidden rounded-[32px] bg-noir p-6 text-on-noir ring-1 ring-zinc-800 sm:p-8">
          <Welcome className="absolute -top-3 -right-3 hidden size-36 rotate-12 sm:block" />
          <h1 id="sapa" class="relative text-3xl font-extrabold sm:text-5xl">
            Hai, <span class="inline-block -rotate-2 rounded-2xl border-2 border-on-noir bg-matcha-300 px-3 text-noir">{name}</span>
          </h1>
          {step ? (
            <a href={step.href} class="group relative mt-6 flex max-w-2xl items-center gap-4 rounded-[24px] bg-on-noir/10 p-4 hover:bg-on-noir/15 sm:p-5">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-matcha-300 text-noir"><step.icon aria-hidden className="size-6" /></span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold text-matcha-200">Langkah berikutnya: {step.label}</span>
                <span class="mt-0.5 block text-lg leading-snug font-bold">{step.title}</span>
                {current && step.title !== current.title && <span class="block text-sm text-on-noir/60">{current.title}</span>}
              </span>
              <span class={`${primaryButton} hidden shrink-0 sm:inline-flex`}>Mulai</span>
            </a>
          ) : (
            <div class="relative mt-4 max-w-xl">
              <p class="text-on-noir/75">{classes.length ? "Semua kelas yang kamu ikuti sudah selesai. Pilih kelas berikutnya." : "Pilih kelas pertamamu. Kamu bebas mulai dari mana saja."}</p>
              <a href="/kelas" class={`${primaryButton} mt-5`}><BookOpen aria-hidden className="size-4" />Jelajahi kelas</a>
            </div>
          )}
          <ul class="relative mt-6 flex flex-wrap gap-2 text-sm">
            <li class="inline-flex items-center gap-1.5 rounded-full bg-on-noir/10 px-3 py-1.5"><Flame aria-hidden className="size-4 text-matcha-300" />{days ? `Streak ${days} hari` : "Belajar hari ini untuk mulai streak"}</li>
            {due > 0 && <li><a href="/flashcard" class="inline-flex items-center gap-1.5 rounded-full bg-on-noir/10 px-3 py-1.5 hover:bg-on-noir/20"><Layers aria-hidden className="size-4 text-matcha-300" />{due} flashcard siap diulang</a></li>}
            <li><a href="/nilai" class="inline-flex items-center gap-1.5 rounded-full bg-on-noir/10 px-3 py-1.5 hover:bg-on-noir/20"><Award aria-hidden className="size-4 text-matcha-300" />Pencapaian</a></li>
          </ul>
        </section>

        <section aria-labelledby="kelasku">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 id="kelasku" class="text-2xl font-extrabold">Kelas yang kamu ikuti</h2>
            <a href="/kelas" class="text-sm font-semibold text-accent hover:underline">Lihat semua kelas</a>
          </div>
          {classes.length ? (
            <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {classes.map((c, i) => {
                const total = c.chapters.length || c.slideCount;
                const at = c.chapters.length ? c.chaptersDone : Math.min(c.lastSlide + 1, c.slideCount);
                const pct = total ? Math.round((at / total) * 100) : 0;
                return (
                  <li>
                    <a href={`/belajar/${c.slug}`} class={`flex h-full flex-col rounded-[28px] p-5 transition-transform hover:-translate-y-0.5 motion-reduce:transition-none ${tile(i)}`}>
                      <span class="flex items-start justify-between gap-3">
                        <span class="text-lg leading-snug font-bold text-noir">{c.title}</span>
                        {c.state === "selesai" && <span class={`${chip} shrink-0 border-2 border-noir bg-matcha-300 font-bold text-noir`}><Check aria-hidden className="size-3.5" />Selesai</span>}
                      </span>
                      <span class="mt-auto pt-6 text-xs font-semibold text-matcha-800 tabular-nums">{c.chapters.length ? `${at} dari ${total} bab` : `Slide ${at} dari ${total}`}</span>
                      <span aria-hidden="true" class="mt-1.5 h-2 rounded-full bg-zinc-900/60"><span class="block h-full rounded-full bg-noir" style={{ width: `${pct}%` }} /></span>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class={`mt-4 flex items-center gap-6 p-6 ${card}`}>
              <div class="flex items-end justify-center overflow-hidden rounded-[28px] border-2 border-noir bg-matcha-100 pt-4 h-36 w-28 shrink-0 px-2"><img src="/ilustrasi/baca.svg" alt="" width="890" height="1220" loading="lazy" decoding="async" class="h-full w-auto" /></div>
              <div>
                <p class="text-zinc-400">Belum ada. Kelas yang kamu buka akan muncul di sini dengan progresnya.</p>
                <a href="/kelas" class={`${primaryButton} mt-4`}><BookOpen aria-hidden className="size-4" />Pilih kelas pertama</a>
              </div>
            </div>
          )}
        </section>
      </div>
    </main>
  </div>
</Base>
