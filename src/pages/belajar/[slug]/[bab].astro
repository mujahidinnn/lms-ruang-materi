---
import { ChevronLeft, ChevronRight, Clock, Code2, ListChecks, Target } from "lucide-react";
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";
import ChapterMarkdown from "@/components/belajar/markdown";
import ChapterQuiz from "@/components/belajar/ChapterQuiz";
import ChapterSyllabus from "@/components/belajar/ChapterSyllabus";
import PresentationViewer from "@/components/PresentationViewer";
import { primaryButton } from "@/components/ui/styles";
import { neighbors } from "@/lib/chapters";
import { sections as splitSections } from "@/lib/toc";
import { getChapter, getTopic } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import CopyCode from "../../../components/CopyCode.astro";
import ReaderHeader from "../../../components/ReaderHeader.astro";
import ReaderScripts from "../../../components/ReaderScripts.astro";
import Base from "../../../layouts/Base.astro";
import { publicPage } from "../../../lib/cdn";

const { slug, bab } = Astro.params as { slug: string; bab: string };
const [topic, chapter] = await Promise.all([getTopic(slug), getChapter(slug, bab)]);
if (!topic || !chapter) return Astro.rewrite("/404");
publicPage(Astro);
const { prev, next } = neighbors(topic.chapters, bab);
const index = topic.chapters.findIndex((c) => c.slug === bab);
// Exercise prompts go into the quiz island as plain HTML, rendered here so
// shiki stays on the server.
const parts = splitSections(chapter.body);
const toc = parts.filter((p) => p.id);
// The deck slides this chapter covers, for the "Slide" mode.
const chapterSlides = chapter.slideFrom && chapter.slideTo ? topic.slides.filter((s) => s.index >= chapter.slideFrom! && s.index <= chapter.slideTo!) : [];
const prompts = chapter.exercises.map((ex) => renderToStaticMarkup(createElement(ChapterMarkdown, { body: ex.prompt, slides: topic.slides })));
---

<Base
  title={`${chapter.title} · ${topic.title}`}
  description={chapter.body.replace(/[#*`>!\[\]()]/g, "").slice(0, 155)}
  canonical={`${SITE_URL}/belajar/${slug}/${bab}`}
>
  <div class="relative flex flex-1 flex-col">
    <ReaderHeader topicSlug={slug} topicTitle={topic.title} label={`Bab ${index + 1}/${topic.chapters.length} · ${chapter.title}`} />
    <main class="flex-1 px-4 pt-8 pb-28 sm:px-6 lg:pb-20">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_14rem]">
        <aside class="hidden lg:block">
          <ChapterSyllabus client:load topicId={topic.id} topicSlug={slug} chapters={topic.chapters} current={bab} />
        </aside>

        <article data-article class="mx-auto w-full max-w-[68ch] min-w-0">
          <ul class="flex flex-wrap gap-2 text-xs font-bold tabular-nums">
            <li class="rounded-full border-2 border-noir bg-matcha-300 px-3 py-1 text-noir">Bab {index + 1} dari {topic.chapters.length}</li>
            <li class="inline-flex items-center gap-1 rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 shadow-soft"><Clock aria-hidden className="size-3.5" />{chapter.estMinutes} menit</li>
            {chapter.exercises.length > 0 && <li class="inline-flex items-center gap-1 rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 shadow-soft"><Code2 aria-hidden className="size-3.5" />{chapter.exercises.length} latihan kode</li>}
            <li class="inline-flex items-center gap-1 rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 shadow-soft"><ListChecks aria-hidden className="size-3.5" />{chapter.questions.length} soal kuis</li>
          </ul>
          <h1 class="mt-4 text-4xl leading-[1.05] font-extrabold text-balance sm:text-5xl">{chapter.title}</h1>

          {/* On narrower screens the contents list sits here, folded. */}
          {toc.length > 1 && (
            <details class="mt-6 rounded-2xl bg-zinc-900 p-4 shadow-soft xl:hidden">
              <summary class="cursor-pointer text-sm font-bold">Di bab ini ({toc.length} bagian)</summary>
              <ol class="mt-3 space-y-1 text-sm">{toc.map((t) => <li><a href={`#${t.id}`} class="block rounded-lg px-2 py-1 text-zinc-300 hover:bg-zinc-800">{t.title}</a></li>)}</ol>
            </details>
          )}

          {chapterSlides.length > 0 && (
            <div role="tablist" aria-label="Cara belajar" class="mt-6 inline-flex rounded-full border-2 border-noir bg-zinc-900 p-1 text-sm font-bold">
              <button type="button" role="tab" data-mode="baca" aria-selected="true" class="min-h-10 rounded-full px-4 aria-selected:bg-noir aria-selected:text-on-noir">Bacaan</button>
              <button type="button" role="tab" data-mode="slide" aria-selected="false" class="min-h-10 rounded-full px-4 aria-selected:bg-noir aria-selected:text-on-noir">Versi slide ({chapterSlides.length})</button>
            </div>
          )}

          <div data-mode-panel="baca">
          <div class="mt-8">
              {parts.map((p) =>
                !p.id ? (
                  p.body.trim() && <ChapterMarkdown body={p.body} slides={topic.slides} />
                ) : p.title === "Tujuan" ? (
                  <section id={p.id} aria-labelledby={`${p.id}-judul`} class="mb-10 scroll-mt-24 rounded-[28px] border-2 border-noir bg-matcha-100 p-6 text-noir **:text-noir">
                    <h2 id={`${p.id}-judul`} class="flex items-center gap-2 text-xl font-extrabold"><Target aria-hidden className="size-5" />Tujuan bab ini</h2>
                    <div class="mt-3 [&_.prose-chapter]:text-noir [&_code]:bg-noir/10"><ChapterMarkdown body={p.body} slides={topic.slides} /></div>
                  </section>
                ) : p.title === "Rangkuman" ? (
                  <section id={p.id} aria-labelledby={`${p.id}-judul`} class="mt-12 scroll-mt-24 rounded-[28px] bg-noir p-6 text-on-noir ring-1 ring-zinc-800 sm:p-8">
                    <h2 id={`${p.id}-judul`} class="text-2xl font-extrabold"><span class="inline-block -rotate-2 rounded-xl bg-matcha-300 px-2 text-noir">Rangkuman</span></h2>
                    <div class="mt-4"><ChapterMarkdown body={p.body} slides={topic.slides} className="prose-on-noir" /></div>
                  </section>
                ) : (
                  <section id={p.id} aria-labelledby={`${p.id}-judul`} class="mt-12 scroll-mt-24">
                    <h2 id={`${p.id}-judul`} class="flex items-start gap-3 text-2xl leading-tight font-extrabold sm:text-[1.75rem]">
                      <span aria-hidden="true" class="mt-1 h-6 w-1.5 shrink-0 rounded-full bg-matcha-400"></span>{p.title}
                    </h2>
                    <div class="mt-4"><ChapterMarkdown body={p.body} slides={topic.slides} /></div>
                  </section>
                ),
              )}
            </div>
          </div>
          {chapterSlides.length > 0 && (
            <div data-mode-panel="slide" hidden class="mt-8">
              <p class="mb-3 text-sm text-zinc-400">Slide {chapter.slideFrom} sampai {chapter.slideTo} dari deck {topic.title}. Penjelasan lengkapnya ada di Bacaan.</p>
              <div class="overflow-hidden rounded-[28px] bg-zinc-900 shadow-soft">
                <PresentationViewer client:visible embedded presentation={{ slug, title: chapter.title, description: "", slideCount: chapterSlides.length, slides: chapterSlides }} />
              </div>
            </div>
          )}

          {/* What finishing this chapter takes, before the quiz island does it. */}
          <section aria-labelledby="ceklis" class="mt-14 rounded-[28px] border-2 border-noir bg-matcha-50 p-6 text-noir">
            <h2 id="ceklis" class="text-xl font-extrabold">Selesaikan bab ini</h2>
            <ol class="mt-3 flex flex-wrap gap-2 text-sm font-semibold">
              <li class="rounded-full border-2 border-noir bg-matcha-100 px-3 py-1">1. Baca materi</li>
              {chapter.exercises.length > 0 && <li class="rounded-full border-2 border-noir bg-matcha-200 px-3 py-1">2. Latihan kode ({chapter.exercises.length})</li>}
              <li class="rounded-full border-2 border-noir bg-matcha-300 px-3 py-1">{chapter.exercises.length > 0 ? 3 : 2}. Kuis ({chapter.questions.length} soal)</li>
            </ol>
          </section>
          <ChapterQuiz client:load chapterId={chapter.id} slug={slug} questions={chapter.questions} exercises={chapter.exercises} prompts={prompts} />

          <nav aria-label="Bab lain" class="mt-10 grid gap-3 sm:grid-cols-2">
            {prev ? (
              <a href={`/belajar/${slug}/${prev.slug}`} class="group flex min-h-20 flex-col justify-center rounded-[24px] bg-zinc-900 px-5 py-3 shadow-soft hover:bg-zinc-800">
                <span class="flex items-center gap-1 text-xs text-zinc-400"><ChevronLeft aria-hidden className="size-3.5" />Sebelumnya</span>
                <span class="mt-1 font-bold">{prev.title}</span>
              </a>
            ) : <span class="hidden sm:block" />}
            {next ? (
              <a href={`/belajar/${slug}/${next.slug}`} data-lanjut class="group flex min-h-20 flex-col justify-center rounded-[24px] border-2 border-noir bg-noir px-5 py-3 text-right text-on-noir">
                <span class="flex items-center justify-end gap-1 text-xs text-matcha-200">Bab berikutnya<ChevronRight aria-hidden className="size-3.5" /></span>
                <span class="mt-1 font-bold">{next.title}</span>
              </a>
            ) : topic.practiceCount > 0 ? (
              <a href={`/latihan/${slug}`} data-lanjut class={`${primaryButton} min-h-20 rounded-[24px]`}><ListChecks aria-hidden className="size-4" />Lanjut ke latihan akhir</a>
            ) : (
              <a href={`/belajar/${slug}`} class={`${primaryButton} min-h-20 rounded-[24px]`}>Kembali ke silabus</a>
            )}
          </nav>
        </article>

        {toc.length > 1 && (
          <aside class="hidden xl:block">
            <nav data-toc aria-labelledby="di-bab-ini" class="sticky top-24">
              <h2 id="di-bab-ini" class="text-sm font-extrabold">Di bab ini</h2>
              <ol class="mt-3 space-y-0.5 border-l-2 border-zinc-800 text-sm">
                {toc.map((t) => (
                  <li><a href={`#${t.id}`} class="-ml-0.5 block border-l-2 border-transparent py-1.5 pl-3 text-zinc-400 hover:text-zinc-50 aria-[current]:border-matcha-500 aria-[current]:font-semibold aria-[current]:text-zinc-50">{t.title}</a></li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </main>

    {/* Phones: chapter navigation within thumb reach, instead of the site nav. */}
    <nav aria-label="Pindah bab" class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-40 flex items-center justify-between gap-2 rounded-full bg-zinc-900/95 p-2 shadow-soft backdrop-blur lg:hidden">
      {prev ? <a href={`/belajar/${slug}/${prev.slug}`} aria-label={`Sebelumnya: ${prev.title}`} class="grid size-11 place-items-center rounded-full bg-zinc-800"><ChevronLeft aria-hidden className="size-5" /></a> : <span class="size-11" />}
      <ChapterSyllabus client:load topicId={topic.id} topicSlug={slug} chapters={topic.chapters} current={bab} variant="button" />
      {next ? <a href={`/belajar/${slug}/${next.slug}`} data-lanjut aria-label={`Berikutnya: ${next.title}`} class="grid size-11 place-items-center rounded-full border-2 border-noir bg-matcha-300 text-noir"><ChevronRight aria-hidden className="size-5" /></a> : <span class="size-11" />}
    </nav>
  </div>
  <script>
    import { confirmDialog } from "@/lib/confirm";

    // Moving on before the quiz and exercises are done asks once, and says
    // why they help; Lewati saja still goes. ChapterQuiz and ChapterSyllabus
    // set data-bab-tuntas when there is nothing left to do.
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-lanjut]")) {
      link.addEventListener("click", async (e) => {
        if ("babTuntas" in document.documentElement.dataset || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        const skip = await confirmDialog({
          title: "Cek pemahamanmu belum selesai",
          text: "Menjawab kuis dan latihan di akhir bab bikin materinya lebih nempel, dan langsung kelihatan bagian mana yang belum paham sebelum lanjut. Bab ini juga baru tercatat selesai setelah semuanya beres.",
          action: "Lewati saja",
          cancel: "Coba dulu",
          nudge: true,
        });
        if (skip) location.href = link.href;
        else document.getElementById("ceklis")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }
  </script>
  <CopyCode />
  <ReaderScripts />
  <script>
    // Every chapter opens on the written text; the slides are a second
    // view for this visit only, so the text is never hidden by an old choice.
    try { localStorage.removeItem("ruang-materi:mode-bab"); } catch {}
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-mode]")];
    function show(mode: string) {
      for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.mode === mode));
      for (const p of document.querySelectorAll<HTMLElement>("[data-mode-panel]")) p.hidden = p.dataset.modePanel !== mode;
    }
    for (const t of tabs) t.addEventListener("click", () => show(t.dataset.mode!));
  </script>
</Base>
