---
import BelajarViewer from "@/components/belajar/BelajarViewer";
import { getTopic } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import Base from "../../../layouts/Base.astro";
import { publicPage } from "../../../lib/cdn";

const slug = Astro.params.slug!;
const topic = await getTopic(slug);
if (!topic) return Astro.rewrite("/404");
publicPage(Astro);
---

<Base title={`Slide ${topic.title}`} description={topic.description} canonical={`${SITE_URL}/belajar/${slug}/slide`}>
  <main><BelajarViewer client:load presentation={topic} /></main>
</Base>
