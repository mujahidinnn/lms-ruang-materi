---
import { ChevronLeft, Layers, ListChecks, PanelRight } from "lucide-react";
import BelajarViewer from "@/components/belajar/BelajarViewer";
import CourseView from "@/components/belajar/CourseView";
import { primaryButton, secondaryButton } from "@/components/ui/styles";
import { getTopic } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../../../components/SiteHeader.astro";
import Base from "../../../layouts/Base.astro";
import { publicPage } from "../../../lib/cdn";

const slug = Astro.params.slug!;
const presentation = await getTopic(slug);
if (!presentation) return Astro.rewrite("/404");
publicPage(Astro);
const { title, description } = presentation;
---

<Base title={title} description={description} canonical={`${SITE_URL}/belajar/${slug}`} ogType="article">
  {presentation.chapters.length > 0 ? (
    <div class="relative flex flex-1 flex-col">
      <SiteHeader learning />
      <CourseView client:load topic={presentation} />
    </div>
  ) : (
    <div class="relative flex flex-1 flex-col">
      <SiteHeader learning />
      <main class="flex-1 px-5 pb-20 sm:px-10">
        <div class="mx-auto max-w-7xl">
          <header class="mt-4 flex flex-wrap items-end justify-between gap-4">
            <div class="min-w-0">
              <a href="/kelas" class="inline-flex items-center gap-1 text-sm font-semibold text-zinc-400 hover:text-zinc-50"><ChevronLeft aria-hidden className="size-4" />Semua kelas</a>
              <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">{title}</h1>
              {description && <p class="mt-2 max-w-3xl text-zinc-400">{description}</p>}
            </div>
            <ul class="flex flex-wrap gap-2 text-xs font-bold">
              <li class="rounded-full border-2 border-noir bg-matcha-300 px-3 py-1 text-noir">Slide saja</li>
              <li class="rounded-full bg-zinc-900 px-3 py-1 text-zinc-300 shadow-soft tabular-nums">{presentation.slideCount} slide</li>
            </ul>
          </header>
          {/* The deck takes the full width; Ringkasan and Tips open beside it
              on demand (a checkbox, so no script). */}
          <div class="group">
          <div class="mt-6 flex flex-wrap items-center gap-2">
            {presentation.practiceCount > 0 && <a href={`/latihan/${slug}`} class={primaryButton}><ListChecks aria-hidden className="size-4" />Latihan ujian</a>}
            {presentation.cardCount > 0 && <a href={`/flashcard/${slug}`} class={secondaryButton}><Layers aria-hidden className="size-4" />Flashcard ({presentation.cardCount})</a>}
            {(presentation.summary || presentation.tips.length > 0) && (
              <label class={`${secondaryButton} cursor-pointer has-checked:bg-noir has-checked:text-on-noir has-focus-visible:outline-2 has-focus-visible:outline-accent`}>
                <input id="info" type="checkbox" class="sr-only" />
                <PanelRight aria-hidden className="size-4" />Ringkasan dan tips
              </label>
            )}
          </div>
          <div class="mt-4 grid items-start gap-6 lg:group-has-[#info:checked]:grid-cols-[minmax(0,1fr)_340px]">
            <div class="overflow-hidden rounded-[28px] shadow-soft"><BelajarViewer client:load embedded presentation={presentation} /></div>
            <aside class="hidden gap-4 group-has-[#info:checked]:grid lg:sticky lg:top-6">
              {presentation.summary && (
                <details open class="rounded-[28px] bg-zinc-900 p-6 shadow-soft">
                  <summary class="cursor-pointer list-none text-xl font-bold tracking-tight">Ringkasan</summary>
                  <div class="mt-3 max-h-80 space-y-3 overflow-y-auto pr-1 text-sm leading-relaxed text-zinc-300 scrollbar-thin">
                    {presentation.summary.split(/\n\s*\n/).map((p) => <p>{p}</p>)}
                  </div>
                </details>
              )}
              {presentation.tips.length > 0 && (
                <div class="rounded-[28px] bg-tile-butter p-6">
                  <h2 class="text-xl font-bold tracking-tight">Tips</h2>
                  <ul class="mt-3 space-y-2">
                    {presentation.tips.map((tip) => (
                      <li class="flex gap-3 rounded-2xl bg-zinc-900/70 p-3 text-sm leading-relaxed text-zinc-200"><span aria-hidden="true" class="mt-1.5 size-2 shrink-0 rounded-full bg-accent-warm" />{tip}</li>
                    ))}
                  </ul>
                </div>
              )}
            </aside>
          </div>
          </div>
        </div>
      </main>
    </div>
  )}
</Base>
