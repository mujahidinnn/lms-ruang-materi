---
import { secondaryButton } from "@/components/ui/styles";
import Base from "../layouts/Base.astro";
import { publicPage } from "../lib/cdn";

publicPage(Astro);

// The music player, opened as its own small window by MusicButton.astro so
// it keeps playing while the learner moves between pages. The learner
// connects Spotify (OAuth PKCE) or YouTube (Google token client), picks one of
// their playlists, and it plays in that service's embed. Tokens stay in this
// browser's localStorage, never on our server; nothing from Spotify or Google
// loads until the learner presses Hubungkan (GUIDELINE, Privacy).
// Spotify's dashboard needs <origin>/musik as a redirect URI; Google's client
// needs <origin> as an authorized JavaScript origin.
const spotify = import.meta.env.SPOTIFY_CLIENT_ID ?? "";
const google = import.meta.env.GOOGLE_CLIENT_ID ?? "";
const SERVICES = [
  { key: "spotify", name: "Spotify", dot: "bg-[#1DB954]", on: !!spotify },
  { key: "youtube", name: "YouTube Music", dot: "bg-[#FF0033]", on: !!google },
];
// Spotify's own study playlists, played in its embed: no Web API, so no
// Premium developer account or user allowlist. Logged in to spotify.com in
// this browser, the embed plays whole songs; otherwise 30-second previews.
const PICKS = [
  ["37i9dQZF1DX8NTLI2TtZa6", "Intense Studying"],
  ["37i9dQZF1DWZeKCadgRdKQ", "Deep Focus"],
  ["37i9dQZF1DWWQRwui0ExPn", "lofi beats"],
  ["37i9dQZF1DX4sWSpwq3LiO", "Peaceful Piano"],
  ["37i9dQZF1DX9sIqqvKsjG8", "Instrumental Study"],
  ["37i9dQZF1DX3PFzdbtx1Us", "Music for Concentration"],
].map(([id, name]) => ({ name, count: "Playlist Spotify", src: `https://open.spotify.com/embed/playlist/${id}` }));
// One tap searches YouTube for these (each still spends search quota).
const SUGGESTIONS = ["lofi belajar", "piano tenang", "jazz cafe", "suara hujan", "musik klasik fokus", "akustik indonesia"];
---

<Base title="Musik belajar" noindex>
  <main data-music data-spotify={spotify} data-google={google} class="mx-auto flex w-full max-w-md flex-1 flex-col gap-5 p-4">
    <div data-music-player class="sticky top-0 z-10 -mx-4 -mt-4 bg-zinc-950 px-4 pt-4 empty:hidden"></div>
    <p data-music-error aria-live="polite" class="text-sm text-red-400 empty:hidden"></p>

    <section data-history-section hidden class="flex flex-col gap-3">
      <h2 class="font-(family-name:--font-bricolage) text-lg font-extrabold tracking-tight">Terakhir diputar</h2>
      <ul data-playlists data-history class="flex flex-col gap-1"></ul>
    </section>

    <section class="flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <span aria-hidden="true" class="size-3 rounded-full border-2 border-noir bg-[#1DB954]"></span>
        <h2 class="font-(family-name:--font-bricolage) text-lg font-extrabold tracking-tight">Playlist belajar Spotify</h2>
      </div>
      {/* We cannot see whether the browser is logged in to Spotify, so this
          asks until the learner logs in here or says they already are. */}
      <div data-spotify-login class="rounded-2xl border-2 border-noir bg-matcha-100 p-4 text-noir">
        <p class="font-bold">Masuk Spotify dulu supaya lagunya diputar penuh</p>
        <p class="mt-1 text-sm">Tanpa masuk, Spotify hanya memutar 30 detik per lagu. Pakai akun Spotify gratis pun bisa.</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button type="button" data-spotify-login-open class="inline-flex min-h-11 items-center rounded-full bg-noir px-5 text-sm font-bold text-on-noir hover:opacity-90">Masuk ke Spotify</button>
          <button type="button" data-spotify-login-done class="min-h-11 px-3 text-sm font-semibold underline">Sudah masuk</button>
        </div>
      </div>
      <ul data-playlists data-picks={JSON.stringify(PICKS)} class="flex flex-col gap-1"></ul>
    </section>

    {SERVICES.filter((s) => s.on).map((s) => (
      <section data-service={s.key} class="flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <span aria-hidden="true" class:list={["size-3 rounded-full border-2 border-noir", s.dot]}></span>
          <h2 class="font-(family-name:--font-bricolage) text-lg font-extrabold tracking-tight">{s.name}</h2>
          <button type="button" data-disconnect hidden class="ml-auto min-h-11 px-2 text-sm text-zinc-400 hover:text-zinc-50">Putuskan</button>
        </div>
        <button type="button" data-connect class={secondaryButton}>Hubungkan {s.name}</button>
        {s.key === "youtube" && (
          <div data-search hidden class="flex flex-col gap-2">
            <form role="search" class="flex gap-2">
              <label for="music-search" class="sr-only">Cari lagu atau playlist</label>
              <input id="music-search" name="q" type="search" placeholder="Cari lagu atau playlist, misal lofi" class="min-h-11 min-w-0 flex-1 rounded-2xl bg-zinc-900 px-4 text-sm shadow-soft focus-visible:outline-2 focus-visible:outline-accent" />
              <button class={secondaryButton}>Cari</button>
            </form>
            <div class="flex flex-wrap gap-1.5">
              {SUGGESTIONS.map((q) => (
                <button type="button" data-suggest={q} class="min-h-9 rounded-full border-2 border-noir bg-matcha-200 px-3 text-xs font-semibold text-noir hover:bg-matcha-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{q}</button>
              ))}
            </div>
          </div>
        )}
        <ul data-playlists class="flex flex-col gap-1 empty:hidden"></ul>
      </section>
    ))}

    <details class="text-sm">
      <summary class="min-h-11 cursor-pointer content-center text-zinc-400 hover:text-zinc-50">Putar dari link</summary>
      <form data-music-form class="mt-2 flex gap-2">
        <label for="music-link" class="sr-only">Link Spotify atau YouTube Music</label>
        <input id="music-link" name="link" type="url" required placeholder="https://open.spotify.com/..." class="min-h-11 min-w-0 flex-1 rounded-2xl bg-zinc-900 px-4 shadow-soft focus-visible:outline-2 focus-visible:outline-accent" />
        <button class={secondaryButton}>Putar</button>
      </form>
    </details>

    <p class="mt-auto text-xs text-zinc-400">Biarkan jendela ini terbuka, musik tetap jalan selagi kamu belajar di tab lain.</p>
  </main>
</Base>

<script>
  import { confirmDialog } from "@/lib/confirm";
  import { musicEmbed } from "@/lib/music";

  type Token = { access: string; refresh?: string; expires: number };
  type Playlist = { name: string; cover?: string; count: string; src: string };

  const LINK = "ruang-materi:musik";
  const TOKENS = "ruang-materi:musik-token";
  const root = document.querySelector<HTMLElement>("[data-music]")!;
  const player = document.querySelector<HTMLElement>("[data-music-player]")!;
  const error = document.querySelector<HTMLElement>("[data-music-error]")!;
  const redirect = `${location.origin}/musik`;

  function tokens(): Record<string, Token> {
    try { return JSON.parse(localStorage.getItem(TOKENS) ?? "{}"); } catch { return {}; }
  }
  function setToken(service: string, token: Token | null) {
    const all = tokens();
    if (token) all[service] = token;
    else delete all[service];
    try { localStorage.setItem(TOKENS, JSON.stringify(all)); } catch {}
  }

  function play(src: string) {
    const frame = document.createElement("iframe");
    frame.src = src;
    frame.title = "Pemutar musik";
    frame.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
    frame.className = `w-full rounded-2xl border-0 ${src.includes("spotify") ? "h-[152px]" : "aspect-video"}`;
    player.replaceChildren(frame);
    if (src.includes("spotify")) {
      const again = document.createElement("button");
      again.type = "button";
      again.className = "mt-1 min-h-11 text-left text-xs text-zinc-400 underline hover:text-zinc-50";
      again.textContent = "Lagunya berhenti di 30 detik? Masuk ke Spotify";
      again.addEventListener("click", spotifyLogin);
      player.append(again);
    }
  }

  // Spotify's login in a popup; when it closes the embed reloads, now
  // playing whole songs. Remembered so the prompt stops asking.
  const LOGIN = "ruang-materi:spotify-masuk";
  const loginBox = document.querySelector<HTMLElement>("[data-spotify-login]")!;
  function loggedIn() {
    loginBox.hidden = true;
    try { localStorage.setItem(LOGIN, "1"); } catch {}
  }
  function spotifyLogin() {
    const win = window.open("https://accounts.spotify.com/login?continue=https%3A%2F%2Fopen.spotify.com%2F", "spotify-login", "popup,width=480,height=720");
    if (!win) return void (location.href = "https://accounts.spotify.com/login");
    const timer = setInterval(() => {
      if (!win.closed) return;
      clearInterval(timer);
      loggedIn();
      const frame = player.querySelector("iframe");
      if (frame?.src.includes("spotify")) frame.src = frame.src;
    }, 700);
  }
  try { loginBox.hidden = localStorage.getItem(LOGIN) === "1"; } catch {}
  document.querySelector("[data-spotify-login-open]")!.addEventListener("click", spotifyLogin);
  document.querySelector("[data-spotify-login-done]")!.addEventListener("click", loggedIn);

  // Spotify: authorization code with PKCE, so no client secret is needed.
  const b64url = (bytes: Uint8Array) => btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");

  async function spotifyConnect() {
    const verifier = b64url(crypto.getRandomValues(new Uint8Array(48)));
    const challenge = b64url(new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))));
    sessionStorage.setItem("spotify-verifier", verifier);
    location.href = `https://accounts.spotify.com/authorize?${new URLSearchParams({
      response_type: "code",
      client_id: root.dataset.spotify!,
      scope: "playlist-read-private playlist-read-collaborative",
      redirect_uri: redirect,
      code_challenge_method: "S256",
      code_challenge: challenge,
    })}`;
  }

  async function spotifyGrant(body: Record<string, string>) {
    const res = await fetch("https://accounts.spotify.com/api/token", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({ client_id: root.dataset.spotify!, ...body }),
    });
    if (!res.ok) return null;
    const t = await res.json();
    const token = { access: t.access_token, refresh: t.refresh_token ?? body.refresh_token, expires: Date.now() + t.expires_in * 1000 };
    setToken("spotify", token);
    return token;
  }

  async function spotifyPlaylists(token: Token): Promise<Playlist[] | null> {
    if (token.expires < Date.now() + 60_000) {
      const fresh = token.refresh ? await spotifyGrant({ grant_type: "refresh_token", refresh_token: token.refresh }) : null;
      if (!fresh) return null;
      token = fresh;
    }
    const res = await fetch("https://api.spotify.com/v1/me/playlists?limit=50", { headers: { Authorization: `Bearer ${token.access}` } });
    if (!res.ok) return null;
    const { items } = await res.json();
    return items.filter(Boolean).map((p: any) => ({
      name: p.name,
      cover: p.images?.at(-1)?.url,
      count: `${(p.items ?? p.tracks)?.total ?? 0} lagu`,
      src: `https://open.spotify.com/embed/playlist/${p.id}`,
    }));
  }

  // YouTube: Google's token client, a one-hour token and no refresh, so an
  // expired one just shows Hubungkan again.
  function youtubeConnect() {
    const script = document.createElement("script");
    script.src = "https://accounts.google.com/gsi/client";
    script.onload = () => {
      const { oauth2 } = (window as any).google.accounts;
      oauth2.initTokenClient({
        client_id: root.dataset.google,
        scope: "https://www.googleapis.com/auth/youtube.readonly",
        callback: (t: any) => {
          if (t.error) {
            error.textContent = `Google menolak: ${t.error_description ?? t.error}`;
            return;
          }
          error.textContent = "";
          setToken("youtube", { access: t.access_token, expires: Date.now() + t.expires_in * 1000 });
          render("youtube");
        },
      }).requestAccessToken();
    };
    document.head.append(script);
  }

  async function youtubePlaylists(token: Token): Promise<Playlist[] | null> {
    if (token.expires < Date.now()) return null;
    const res = await fetch("https://www.googleapis.com/youtube/v3/playlists?mine=true&part=snippet,contentDetails&maxResults=50", {
      headers: { Authorization: `Bearer ${token.access}` },
    });
    const body = await res.json().catch(() => ({}));
    // An account without a YouTube channel has no playlists, not an error.
    if (body.error?.errors?.[0]?.reason === "channelNotFound") return [];
    if (!res.ok) {
      error.textContent = `YouTube menolak: ${body.error?.message ?? res.status}`;
      return null;
    }
    return (body.items ?? []).map((p: any) => ({
      name: p.snippet.title,
      cover: p.snippet.thumbnails?.default?.url,
      count: `${p.contentDetails.itemCount} lagu`,
      src: `https://www.youtube-nocookie.com/embed/videoseries?list=${p.id}`,
    }));
  }

  // ponytail: each search costs 100 of the project's 10,000 daily YouTube
  // quota units, so about 100 searches a day across all learners; ask Google
  // for more quota if it runs out.
  async function youtubeSearch(q: string): Promise<Playlist[] | null> {
    const token = tokens().youtube;
    if (!token || token.expires < Date.now()) return null;
    const res = await fetch(`https://www.googleapis.com/youtube/v3/search?${new URLSearchParams({ part: "snippet", type: "video,playlist", maxResults: "15", q })}`, {
      headers: { Authorization: `Bearer ${token.access}` },
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) {
      error.textContent = `YouTube menolak: ${body.error?.message ?? res.status}`;
      return [];
    }
    // Search titles come HTML-escaped (&amp;, &#39;).
    const text = (s: string) => new DOMParser().parseFromString(s, "text/html").documentElement.textContent ?? s;
    return (body.items ?? []).map((r: any) => {
      const list = r.id.kind === "youtube#playlist";
      return {
        name: text(r.snippet.title),
        cover: r.snippet.thumbnails?.default?.url,
        count: `${list ? "Playlist dari " : ""}${text(r.snippet.channelTitle)}`,
        src: list ? `https://www.youtube-nocookie.com/embed/videoseries?list=${r.id.playlistId}` : `https://www.youtube-nocookie.com/embed/${r.id.videoId}?autoplay=1`,
      };
    });
  }

  const SERVICES = {
    spotify: { connect: spotifyConnect, playlists: spotifyPlaylists, empty: "Belum ada playlist di Spotify-mu." },
    youtube: { connect: youtubeConnect, playlists: youtubePlaylists, empty: "Belum ada playlist di YouTube-mu. Cari lagu di atas." },
  };

  async function render(key: keyof typeof SERVICES) {
    const section = document.querySelector<HTMLElement>(`[data-service="${key}"]`);
    if (!section) return;
    const connect = section.querySelector<HTMLButtonElement>("[data-connect]")!;
    const disconnect = section.querySelector<HTMLButtonElement>("[data-disconnect]")!;
    const search = section.querySelector<HTMLElement>("[data-search]");
    const list = section.querySelector<HTMLElement>("[data-playlists]")!;
    const token = tokens()[key];
    const playlists = token ? await SERVICES[key].playlists(token) : null;
    if (token && !playlists) setToken(key, null);
    connect.hidden = !!playlists;
    disconnect.hidden = !playlists;
    if (search) search.hidden = !playlists;
    fill(list, playlists, SERVICES[key].empty);
  }

  function fill(list: HTMLElement, items: Playlist[] | null, empty: string) {
    list.replaceChildren(
      ...(items ?? []).map((p) => {
        const row = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "flex min-h-14 w-full items-center gap-3 rounded-2xl p-1.5 text-left hover:bg-zinc-900 focus-visible:outline-2 focus-visible:outline-accent aria-pressed:bg-matcha-200 aria-pressed:text-noir";
        const cover = document.createElement(p.cover ? "img" : "span");
        cover.className = "size-11 shrink-0 rounded-xl border-2 border-noir bg-matcha-200 object-cover";
        if (p.cover) Object.assign(cover, { src: p.cover, alt: "", loading: "lazy", referrerPolicy: "no-referrer" });
        const text = document.createElement("span");
        text.className = "min-w-0";
        const name = document.createElement("span");
        name.className = "block truncate text-sm font-semibold";
        name.textContent = p.name;
        const count = document.createElement("span");
        count.className = "block text-xs opacity-70";
        count.textContent = p.count;
        text.append(name, count);
        button.append(cover, text);
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-playlists] button").forEach((b) => b.removeAttribute("aria-pressed"));
          button.setAttribute("aria-pressed", "true");
          play(p.src);
          remember(p);
        });
        row.append(button);
        return row;
      }),
    );
    if (items?.length === 0) {
      const note = document.createElement("li");
      note.className = "text-sm text-zinc-400";
      note.textContent = empty;
      list.append(note);
    }
  }

  // The last few things played, newest first, kept in this browser only. They
  // replay straight from the embed, so no login or search quota is needed.
  const HISTORY = "ruang-materi:musik-riwayat";
  function played(): Playlist[] {
    try { return JSON.parse(localStorage.getItem(HISTORY) ?? "[]"); } catch { return []; }
  }
  function remember(p: Playlist) {
    const items = [p, ...played().filter((h) => h.src !== p.src)].slice(0, 6);
    try { localStorage.setItem(HISTORY, JSON.stringify(items)); } catch {}
  }
  function renderHistory() {
    const items = played();
    document.querySelector<HTMLElement>("[data-history-section]")!.hidden = !items.length;
    fill(document.querySelector<HTMLElement>("[data-history]")!, items, "");
  }
  renderHistory();
  const picks = document.querySelector<HTMLElement>("[data-picks]")!;
  fill(picks, JSON.parse(picks.dataset.picks!), "");

  // Searching shows results in place of the playlists; an empty query brings
  // the playlists back.
  const searchForm = document.querySelector<HTMLFormElement>("[data-search] form");
  searchForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const q = new FormData(searchForm).get("q")?.toString().trim();
    if (!q) return render("youtube");
    error.textContent = "";
    const results = await youtubeSearch(q);
    if (!results) return render("youtube");
    fill(searchForm.closest("section")!.querySelector("[data-playlists]")!, results, "Tidak ada hasil. Coba kata lain.");
  });
  // A suggestion fills the box and searches it.
  document.querySelectorAll<HTMLButtonElement>("[data-suggest]").forEach((b) =>
    b.addEventListener("click", () => {
      searchForm!.q.value = b.dataset.suggest;
      searchForm!.requestSubmit();
    }),
  );

  for (const key of Object.keys(SERVICES) as (keyof typeof SERVICES)[]) {
    const section = document.querySelector(`[data-service="${key}"]`);
    section?.querySelector("[data-connect]")!.addEventListener("click", () => SERVICES[key].connect());
    section?.querySelector("[data-disconnect]")!.addEventListener("click", async () => {
      const name = section.querySelector("h2")!.textContent;
      const ok = await confirmDialog({
        title: `Putuskan ${name}?`,
        text: "Playlist-mu tidak tampil lagi di sini sampai kamu menghubungkannya lagi. Musik yang sedang diputar tetap jalan.",
        action: "Putuskan",
        danger: true,
      });
      if (!ok) return;
      setToken(key, null);
      render(key);
    });
  }

  // Back from Spotify's consent screen with ?code= (or ?error= when refused).
  const params = new URLSearchParams(location.search);
  const code = params.get("code");
  const verifier = sessionStorage.getItem("spotify-verifier");
  history.replaceState(null, "", "/musik");
  if (params.get("error")) error.textContent = "Spotify tidak jadi dihubungkan.";
  if (code && verifier) {
    sessionStorage.removeItem("spotify-verifier");
    const ok = await spotifyGrant({ grant_type: "authorization_code", code, redirect_uri: redirect, code_verifier: verifier });
    if (!ok) error.textContent = "Gagal menghubungkan Spotify. Coba lagi.";
  }
  render("spotify");
  render("youtube");

  const form = document.querySelector<HTMLFormElement>("[data-music-form]")!;
  const input = form.querySelector("input")!;
  try { input.value = localStorage.getItem(LINK) ?? ""; } catch {}
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const src = musicEmbed(input.value);
    if (!src) {
      error.textContent = "Link belum dikenali. Salin link lagu atau playlist dari Spotify atau YouTube Music.";
      return;
    }
    error.textContent = "";
    try { localStorage.setItem(LINK, input.value.trim()); } catch {}
    play(src);
  });
</script>
