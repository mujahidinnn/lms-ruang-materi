---
import MasukanForm from "@/components/MasukanForm";
import { getCurrentUser } from "@/lib/dal";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";

const user = await getCurrentUser();
---

<Base title="Masukan dan saran" description="Kirim saran, laporkan masalah, atau beri tahu kami apa yang bisa lebih baik di Ruang Materi." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <h1 class="text-3xl font-extrabold sm:text-5xl">Masukan dan saran</h1>
        <p class="mt-2 max-w-xl text-zinc-400">Ada ide, kendala, atau kritik untuk Ruang Materi? Ceritakan di sini, kami baca semuanya. Untuk bab atau soal yang salah, lapor langsung dari bawah bab atau pembahasan ujian.</p>
        <div class="mt-8"><MasukanForm client:load signedIn={user !== null} /></div>
      </div>
    </main>
  </div>
</Base>
