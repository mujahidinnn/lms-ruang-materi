---
import ArrowBadge from "@/components/ui/ArrowBadge";
import { chip, tile } from "@/components/ui/styles";
import { getTracks } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { publicPage } from "../../lib/cdn";

publicPage(Astro);
const tracks = await getTracks();
---

<Base title="Roadmap" description="Pilih jalur belajar: urutan topik dengan prasyarat yang disarankan, dari dasar sampai mahir." canonical={`${SITE_URL}/roadmap`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-3xl">
        <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Roadmap</h1>
        <p class="mt-2 text-zinc-400">Pilih satu jalur, lalu ikuti topiknya dari kiri ke kanan.</p>
        {tracks.length === 0 ? (
          <p class="mt-10 text-zinc-400">
            Belum ada roadmap. <a href="/#materi" class="text-accent hover:underline">Pilih materi</a> untuk mulai belajar.
          </p>
        ) : (
          <ul class="mt-8 grid gap-4">
            {tracks.map((t, i) => (
              <li>
                <a
                  href={`/roadmap/${t.slug}`}
                  class={`group flex min-h-28 items-center gap-5 rounded-[28px] p-6 transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none ${tile(i)}`}
                >
                  <span class="min-w-0 flex-1">
                    <span class="block text-2xl font-bold tracking-tight">{t.title}</span>
                    {t.description && <span class="mt-1 line-clamp-2 block text-sm text-zinc-300">{t.description}</span>}
                  </span>
                  <span class={`${chip} hidden bg-zinc-900/70 tabular-nums sm:inline-flex`}>{t.nodeCount} topik</span>
                  <ArrowBadge />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </main>
  </div>
</Base>
