---
import TrackCard from "@/components/landing/TrackCard";
import { getTracks } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { publicPage } from "../../lib/cdn";

publicPage(Astro);
const tracks = await getTracks();
---

<Base title="Roadmap" description="Roadmap: urutan kelas yang disarankan, dari dasar sampai mahir. Saran, bukan syarat." canonical={`${SITE_URL}/roadmap`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-6xl">
        <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Roadmap</h1>
        <p class="mt-2 text-zinc-400">Urutan kelas yang disarankan. Kamu tetap bebas membuka kelas mana saja.</p>
        {tracks.length === 0 ? (
          <p class="mt-10 text-zinc-400">
            Belum ada roadmap. <a href="/kelas" class="text-accent hover:underline">Pilih kelas</a> untuk mulai belajar.
          </p>
        ) : (
          <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {tracks.map((t) => <TrackCard track={t} />)}
          </ul>
        )}
      </div>
    </main>
  </div>
</Base>
