---
import RoadmapView from "@/components/roadmap/RoadmapView";
import { getTrack } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { publicPage } from "../../lib/cdn";

const track = await getTrack(Astro.params.track!);
if (!track) return Astro.rewrite("/404");
publicPage(Astro);

const description = track.description || `Urutan kelas ${track.title}, dari dasar sampai mahir.`;
---

<Base title={track.title} description={description} canonical={`${SITE_URL}/roadmap/${track.slug}`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader learning />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <a href="/roadmap" class="text-sm text-zinc-400 hover:text-zinc-50">
          Semua jalur belajar
        </a>
        <div class="mt-3 mb-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{track.title}</h1>
          <p class="inline-flex min-h-8 items-center rounded-full bg-tile-lavender px-3 text-xs font-medium tabular-nums">{track.nodes.length} topik</p>
        </div>
        {track.description && <p class="-mt-6 mb-10 max-w-2xl text-zinc-400">{track.description}</p>}
        <RoadmapView client:load nodes={track.nodes} edges={track.edges} />
      </div>
    </main>
  </div>
</Base>
