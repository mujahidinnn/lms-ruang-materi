---
import ChapterEditor, { type ChapterRow } from "@/components/admin/ChapterEditor";
import ExerciseEditor, { type ExerciseRow } from "@/components/admin/ExerciseEditor";
import ProjectEditor, { type ProjectRow } from "@/components/admin/ProjectEditor";
import QuestionEditor, { type Question } from "@/components/admin/QuestionEditor";
import RowEditor from "@/components/admin/RowEditor";
import StatusBadge from "@/components/admin/StatusBadge";
import TopicActions from "@/components/admin/TopicActions";
import { field, smallButton } from "@/components/admin/editor";
import { slideUrl, thumbSrc } from "@/lib/slides";
import { createClient } from "@/lib/supabase/server";
import AdminSection from "../../../components/AdminSection.astro";
import AppShell from "../../../components/AppShell.astro";
import Base from "../../../layouts/Base.astro";
import { adminOnly } from "../../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = { id: string; status: string };

// When a table has drafts, those are what publish puts live, so show them;
// otherwise show the published rows.
const pending = <T extends Row>(rows: T[] | null) => {
  const all = rows ?? [];
  return all.some((r) => r.status === "draft") ? all.filter((r) => r.status === "draft") : all;
};

const slug = Astro.params.slug!;
const galat = Astro.url.searchParams.get("galat");
const db = await createClient();

const { data: topic } = await db.from("topics").select("*").eq("slug", slug).maybeSingle();
if (!topic) return Astro.rewrite("/404");

const by = (t: string) => db.from(t).select("*").eq("topic_id", topic.id);
const [slides, tips, cards, practice, exam, job, chapters, chapterQuestions, exercises, projects] = await Promise.all([
  by("slides").order("index"),
  by("tips").order("position"),
  by("flashcards").order("position"),
  by("practice_questions").order("created_at"),
  // Archived questions stay only for old attempts; the editor skips them.
  db.from("exams").select("id, exam_questions(*)").eq("topic_id", topic.id).neq("exam_questions.status", "archived").maybeSingle(),
  db.from("import_jobs").select("prerequisites").eq("slug", slug).eq("status", "done").order("created_at", { ascending: false }).limit(1).maybeSingle(),
  by("chapters").order("position"),
  db.from("chapter_questions").select("*, chapters!inner(topic_id)").eq("chapters.topic_id", topic.id).order("position"),
  db.from("code_exercises").select("*, chapters!inner(topic_id)").eq("chapters.topic_id", topic.id).order("position"),
  db.from("projects").select("*, project_solutions(solution)").eq("topic_id", topic.id),
]);
// The draft project when there is one (it replaces the live one on publish).
const projectRows = (projects.data ?? []) as (Omit<ProjectRow, "solution"> & { status: string; project_solutions: { solution: ProjectRow["solution"] } | null })[];
const projectRow = projectRows.find((p) => p.status === "draft") ?? projectRows[0];
const project: ProjectRow | null = projectRow ? { ...projectRow, solution: projectRow.project_solutions?.solution ?? {} } : null;

const shownChapters = pending(chapters.data as ChapterRow[] | null);
const shownSlides = pending(slides.data);
const shownTips = pending(tips.data);
const shownCards = pending(cards.data);
const shownPractice = pending(practice.data as Question[]);
const shownExam = pending(exam.data?.exam_questions as Question[] | null);
const prereq: string[] = job.data?.prerequisites ?? [];
const slidesForPreview = shownSlides.map((s) => ({ index: s.index, src: slideUrl(s.path), width: s.width, height: s.height }));
const hasDraft =
  !!topic.draft_summary ||
  [chapters.data as Row[] | null, slides.data, tips.data, cards.data, practice.data, exam.data?.exam_questions as Row[] | undefined, projects.data as Row[] | null].some((rows) =>
    rows?.some((x) => x.status === "draft")
  );
const allChapterQuestions = (chapterQuestions.data ?? []) as (Question & { chapter_id: string })[];
const allExercises = (exercises.data ?? []) as ExerciseRow[];

const sections = [
  { id: "ringkasan", title: "Ringkasan" },
  { id: "bab", title: "Bab", count: shownChapters.length },
  { id: "slide", title: "Slide", count: shownSlides.length },
  { id: "tips", title: "Tips", count: shownTips.length },
  { id: "flashcard", title: "Flashcard", count: shownCards.length },
  { id: "latihan", title: "Soal latihan", count: shownPractice.length },
  { id: "ujian", title: "Soal ujian", count: shownExam.length },
];
---

<Base title="Tinjau topik" description="Tinjau, edit dan terbitkan draf materi." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="grid gap-10 lg:grid-cols-[17rem_1fr]">
      <aside class="flex flex-col gap-6 lg:sticky lg:top-6 lg:self-start">
        <a href="/admin/topik" class="text-sm text-zinc-400 hover:text-zinc-50">Semua topik</a>
        <div class="flex flex-col gap-5 rounded-[28px] bg-tile-lavender p-5">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">{topic.title}</h1>
            <p class="mt-1 font-mono text-sm text-zinc-500">{slug}</p>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              <StatusBadge status={topic.status} />
              {hasDraft && <span class="text-zinc-400">Ada draf baru</span>}
              {topic.status === "published" && <a href={`/belajar/${slug}`} class="text-accent hover:underline">Lihat di situs</a>}
            </div>
          </div>
          <TopicActions client:load slug={slug} published={topic.status === "published"} hasDraft={hasDraft} />
          {galat !== null && (
            <p role="alert" class="rounded-2xl bg-tile-pink px-4 py-3 text-sm">{galat}</p>
          )}
        </div>
        {prereq.length > 0 && (
          <p class="text-sm text-zinc-400">
            Saran prasyarat dari model: <span class="font-mono text-zinc-300">{prereq.join(", ")}</span>
          </p>
        )}
        <nav aria-label="Bagian topik" class="hidden lg:block">
          <ul class="border-l border-zinc-800/80 text-sm">
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="-ml-px flex min-h-9 items-center justify-between border-l border-transparent pl-3 text-zinc-400 hover:border-accent hover:text-zinc-50">
                  {s.title}
                  {s.count !== undefined && <span class="tabular-nums text-zinc-500">{s.count}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <div class="flex min-w-0 flex-col gap-12">
        <AdminSection id="ringkasan" title="Ringkasan" note={topic.draft_summary ? "Draf, tampil setelah diterbitkan" : undefined}>
          <form method="post" action="/rpc/simpanRingkasan" class="flex flex-col gap-3">
            <input type="hidden" name="slug" value={slug} />
            <textarea name="summary" aria-label="Ringkasan" rows={10} required class={`${field} leading-relaxed`}>{topic.draft_summary ?? topic.summary}</textarea>
            <button class={`${smallButton} w-fit`}>Simpan ringkasan</button>
          </form>
        </AdminSection>

        <AdminSection id="bab" title="Bab" note="Isi bab dalam markdown, kuis tiap bab di bawahnya">
          <ul class="divide-y divide-zinc-800/80">
            {shownChapters.map((c, i) => (
              <li>
                <ul>
                  <ChapterEditor client:load topic={slug} c={c} n={i + 1} slides={slidesForPreview} />
                </ul>
                <ul class="divide-y divide-zinc-800/80 pl-4">
                  {allChapterQuestions
                    .filter((q) => q.chapter_id === c.id)
                    .map((q, qi) => (
                      <QuestionEditor client:load table="chapter_questions" slug={slug} q={{ ...q, status: c.status }} n={qi + 1} />
                    ))}
                </ul>
                <ul class="divide-y divide-zinc-800/80 pl-4">
                  {allExercises
                    .filter((x) => x.chapter_id === c.id)
                    .map((x, xi) => (
                      <ExerciseEditor client:load topic={slug} ex={x} n={xi + 1} />
                    ))}
                </ul>
                <form method="post" action="/rpc/tambahLatihanKode" class="pb-4 pl-4">
                  <input type="hidden" name="chapter" value={c.id} />
                  <input type="hidden" name="topic" value={slug} />
                  <button class={smallButton}>Tambah latihan kode</button>
                </form>
              </li>
            ))}
          </ul>
          <form method="post" action="/rpc/tambahBab" class="mt-4">
            <input type="hidden" name="topic" value={slug} />
            <button class={smallButton}>Tambah bab</button>
            <p class="mt-2 text-xs text-zinc-500">Bab baru jadi draf. Kalau topik sudah punya bab terbit dan tidak ada draf, bab baru langsung tampil.</p>
          </form>
        </AdminSection>

        <AdminSection id="proyek" title="Proyek akhir" note="Syarat sertifikat, diperiksa otomatis di browser">
          {project ? (
            <ProjectEditor client:load p={project} />
          ) : (
            <form method="post" action="/rpc/tambahProyek" class="py-4">
              <input type="hidden" name="topic" value={slug} />
              <button class={smallButton}>Tambah proyek akhir</button>
              <p class="mt-2 text-xs text-zinc-500">Proyek tampil untuk murid setelah solusinya lolos uji.</p>
            </form>
          )}
        </AdminSection>

        <AdminSection id="slide" title="Slide" note={`${shownSlides.length} slide${shownSlides[0]?.status === "draft" ? ", hasil render baru" : ""}`}>
          <ul class="scrollbar-thin flex gap-2 overflow-x-auto pb-2">
            {shownSlides.map((s) => (
              <li class="relative aspect-video w-36 shrink-0 overflow-hidden rounded-xl">
                <img src={thumbSrc({ ...s, src: slideUrl(s.path) })} alt={`${topic.title}, slide ${s.index} dari ${shownSlides.length}`} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
              </li>
            ))}
          </ul>
        </AdminSection>

        <AdminSection id="tips" title="Tips">
          <ul class="divide-y divide-zinc-800/80">
            {shownTips.map((r) => <RowEditor client:load table="tips" slug={slug} row={r} fields={[{ name: "body", label: "Tip" }]} />)}
          </ul>
        </AdminSection>

        <AdminSection id="flashcard" title="Flashcard">
          <ul class="divide-y divide-zinc-800/80">
            {shownCards.map((r) => (
              <RowEditor client:load table="flashcards" slug={slug} row={r} fields={[{ name: "front", label: "Depan" }, { name: "back", label: "Belakang" }]} />
            ))}
          </ul>
        </AdminSection>

        <AdminSection id="latihan" title="Soal latihan" note="Langsung dapat pembahasan, tidak dinilai">
          <ul class="divide-y divide-zinc-800/80">
            {shownPractice.map((q, i) => <QuestionEditor client:load table="practice_questions" slug={slug} q={q} n={i + 1} />)}
          </ul>
        </AdminSection>

        <AdminSection id="ujian" title="Soal ujian" note="Bank soal, tiap percobaan mengambil sebagian secara acak">
          <ul class="divide-y divide-zinc-800/80">
            {shownExam.map((q, i) => <QuestionEditor client:load table="exam_questions" slug={slug} q={q} n={i + 1} />)}
          </ul>
        </AdminSection>
      </div>
    </div>
  </AppShell>
</Base>
