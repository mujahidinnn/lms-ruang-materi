---
import EmptyState from "../../../components/EmptyState.astro";
import ActionForm from "@/components/admin/ActionForm";
import { dangerButton, field, smallButton } from "@/components/admin/editor";
import { coverFor } from "@/lib/studio/covers";
import { listDefs } from "@/lib/studio/data";
import { Rocket } from "lucide-react";
import { LEVELS, STUDIO_FEATURE } from "@/lib/studio/stages";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../../components/AppShell.astro";
import Base from "../../../layouts/Base.astro";
import { adminOnly } from "../../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

const db = await createClient();
const [defs, { data: counts }, { data: access }, { data: open }, { data: people }] = await Promise.all([
  listDefs(),
  db.from("studio_steps").select("def_id"),
  db.from("feature_access").select("user_id, granted_at").eq("feature", STUDIO_FEATURE),
  db.from("feature_open").select("feature").eq("feature", STUDIO_FEATURE).maybeSingle(),
  db.rpc("admin_users"),
]);
const steps = new Map<string, number>();
for (const r of (counts ?? []) as { def_id: string }[]) steps.set(r.def_id, (steps.get(r.def_id) ?? 0) + 1);
type Person = { user_id: string; display_name: string | null; email: string };
const all = (people ?? []) as Person[];
const byId = new Map(all.map((p) => [p.user_id, p]));
const granted = new Set(((access ?? []) as { user_id: string }[]).map((a) => a.user_id));
const candidates = all.filter((p) => !granted.has(p.user_id)).sort((a, b) => (a.display_name || a.email).localeCompare(b.display_name || b.email));
const isOpen = open !== null;
---

<Base title="Studio Proyek" description="Kelola proyek Studio Proyek dan siapa yang bisa melihatnya." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Studio Proyek</h1>
      <p class="mt-2 text-sm text-zinc-400">Buat proyek berpanduan lengkap: arahan, bahan, dan butir periksa untuk setiap langkah. Murid mengerjakannya dari awal sampai online.</p>

      <section aria-labelledby="proyek" class="mt-8">
        <h2 id="proyek" class="text-xl font-bold">Proyek</h2>
        {defs.length === 0 ? (
          <EmptyState title="Belum ada proyek" class="mt-3 justify-center rounded-[18px] bg-zinc-900 px-6 py-10 shadow-soft"></EmptyState>
        ) : (
          <ul class="mt-3 grid gap-3">
            {defs.map((d) => (
              <li>
                <a href={`/admin/studio/${d.slug}`} class="flex flex-wrap items-center gap-3 rounded-[18px] bg-zinc-900 p-4 shadow-soft hover:bg-zinc-800 sm:p-5">
                  {coverFor(d.slug)
                    ? <img src={coverFor(d.slug)} alt="" width="800" height="597" loading="lazy" decoding="async" class="aspect-[2/1] w-28 shrink-0 rounded-xl border-2 border-noir bg-[#f2f1e9] object-contain sm:w-36" />
                    : <span aria-hidden="true" class="grid aspect-[2/1] w-28 shrink-0 place-items-center rounded-xl border-2 border-noir bg-matcha-100 text-noir sm:w-36"><Rocket className="size-6" /></span>}
                  <span class="min-w-0 flex-1 basis-40">
                    <span class="block font-bold">{d.title}</span>
                    <span class="mt-0.5 block text-sm text-zinc-400">{LEVELS[d.level]} · {steps.get(d.id) ?? 0} langkah{d.est_hours ? ` · sekitar ${d.est_hours} jam` : ""}</span>
                  </span>
                  <span class={`inline-flex min-h-7 items-center rounded-full px-3 text-xs font-semibold text-zinc-50 ${d.status === "published" ? "bg-tile-mint" : "bg-tile-butter"}`}>{d.status === "published" ? "Terbit" : "Draf"}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        <ActionForm client:load action="buatProyekStudio" className="mt-4 flex flex-wrap items-end gap-3 rounded-[18px] border-2 border-dashed border-zinc-700 p-4">
          <label class="min-w-0 flex-1 basis-56 text-sm text-zinc-400">Judul proyek baru<input name="title" required minlength="3" maxlength="80" placeholder="Contoh: Aplikasi Daftar Tugas" class={`${field} mt-1`} /></label>
          <label class="w-56 text-sm text-zinc-400">Slug<input name="slug" required pattern="[a-z-]{3,40}" placeholder="daftar-tugas" class={`${field} mt-1 font-mono`} /></label>
          <button class={`${smallButton} bg-primary font-semibold text-on-primary hover:bg-primary-hover hover:text-on-primary`}>Buat proyek</button>
        </ActionForm>
      </section>

      <section aria-labelledby="akses" class="mt-12">
        <h2 id="akses" class="text-xl font-bold">Siapa yang bisa melihat</h2>
        <div class={`mt-3 flex flex-wrap items-center justify-between gap-3 rounded-[18px] p-4 sm:p-5 ${isOpen ? "bg-tile-mint text-zinc-50" : "bg-zinc-900 shadow-soft"}`}>
          <div class="min-w-0 flex-1 basis-64">
            <p class="font-bold">{isOpen ? "Terbuka untuk semua akun yang sudah masuk" : "Akses awal: hanya akun di daftar bawah"}</p>
            <p class={`text-sm ${isOpen ? "" : "text-zinc-400"}`}>{isOpen ? "Tamu dan akun belum masuk tetap melihat halaman Segera." : "Akun lain dan tamu melihat halaman Segera."}</p>
          </div>
          <form method="post" action="/rpc/bukaStudioUntukSemua" data-confirm={isOpen ? "Tutup akses untuk semua?" : "Buka untuk semua akun?"} data-confirm-text={isOpen ? "Hanya akun di daftar akses awal yang tetap bisa melihat Studio Proyek." : "Semua akun yang sudah masuk bisa melihat proyek yang berstatus terbit."} data-confirm-action={isOpen ? "Tutup" : "Buka untuk semua"}>
            <input type="hidden" name="open" value={isOpen ? "0" : "1"} />
            <button class={smallButton}>{isOpen ? "Kembalikan ke akses awal" : "Buka untuk semua"}</button>
          </form>
        </div>

        <h3 class="mt-6 text-sm font-semibold text-zinc-300">Akses awal ({granted.size})</h3>
        <ul class="mt-2 divide-y divide-zinc-800 rounded-[18px] bg-zinc-900 px-5 shadow-soft">
          {[...granted].map((id) => {
            const p = byId.get(id);
            return (
              <li class="flex flex-wrap items-center gap-3 py-3 text-sm">
                <span class="min-w-0 flex-1"><span class="block font-medium">{p?.display_name || p?.email || "(akun dihapus)"}</span>{p?.display_name && <span class="block text-xs text-zinc-500">{p.email}</span>}</span>
                <form method="post" action="/rpc/cabutAksesStudio"><input type="hidden" name="user" value={id} /><button class={dangerButton}>Cabut</button></form>
              </li>
            );
          })}
          {granted.size === 0 && <li class="py-3"><EmptyState small>Belum ada akun.</EmptyState></li>}
        </ul>
        <form method="post" action="/rpc/berikanAksesStudio" class="mt-3 flex flex-wrap items-center gap-3">
          <label class="min-w-0 flex-1 basis-64"><span class="sr-only">Akun</span>
            <select name="user" required class={field}>
              <option value="">Pilih akun untuk diberi akses...</option>
              {candidates.map((p) => <option value={p.user_id}>{p.display_name || p.email}{p.display_name ? ` (${p.email})` : ""}</option>)}
            </select>
          </label>
          <button class={smallButton}>Beri akses</button>
        </form>
      </section>
    </div>
  </AppShell>
</Base>
