---
import { ArrowLeft } from "lucide-react";
import Avatar from "@/components/admin/Avatar";
import { chip } from "@/components/ui/styles";
import { createClient } from "@/lib/supabase/server";
import Recap, { type Recap as RecapData } from "../../../components/Recap.astro";
import AppShell from "../../../components/AppShell.astro";
import Base from "../../../layouts/Base.astro";
import { adminOnly } from "../../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

const id = Astro.params.id ?? "";
if (!/^[0-9a-f-]{36}$/.test(id)) return Astro.rewrite("/404");
const db = await createClient();
const [{ data: all }, { data: recap }, { data: rel }] = await Promise.all([
  db.rpc("admin_users"),
  db.rpc("admin_user_recap", { target: id }),
  db.rpc("admin_user_referrals", { target: id }),
]);
const refs = (rel ?? []) as { relation: "invited_by" | "invited"; user_id: string; name: string; at: string }[];
const invitedBy = refs.find((x) => x.relation === "invited_by");
const invited = refs.filter((x) => x.relation === "invited");
const who = ((all ?? []) as { user_id: string; email: string; display_name: string | null; role: string; avatar_url: string | null; provider: string; created_at: string; last_sign_in_at: string | null; confirmed: boolean }[]).find((p) => p.user_id === id);
if (!who || !recap) return Astro.rewrite("/404");
const r = recap as RecapData;

const name = who.display_name || who.email.split("@")[0];
const date = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" });
const fmt = (iso: string | null) => (iso ? date.format(new Date(iso)) : "-");
const info: [string, string][] = [
  ["Masuk lewat", who.provider === "google" ? "Google" : "Email"],
  ["Bergabung", fmt(who.created_at)],
  ["Terakhir masuk", fmt(who.last_sign_in_at)],
  ["Email terverifikasi", who.confirmed ? "Ya" : "Belum"],
];
---

<Base title={`Rekap ${name}`} description="Kemajuan belajar satu murid." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <a href="/admin/pengguna" class="inline-flex min-h-11 items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50"><ArrowLeft aria-hidden className="size-4" />Pengguna</a>
      <div class="mt-3 flex items-center gap-4">
        <Avatar client:load name={name} src={who.avatar_url} admin={who.role === "admin"} className="size-16 text-2xl" />
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{name}</h1>
            <span class={`${chip} ${who.role === "admin" ? "bg-tile-mint text-zinc-50" : "bg-zinc-800"}`}>{who.role === "admin" ? "Admin" : "Siswa"}</span>
          </div>
          <p class="truncate text-sm text-zinc-400">{who.email}</p>
        </div>
      </div>

      <Recap recap={r} info={info}>
        {(invitedBy || invited.length > 0) && (
        <section class="mt-6 rounded-[18px] bg-zinc-900 p-5 shadow-soft" aria-labelledby="ajakan">
          <h2 id="ajakan" class="text-xl font-bold tracking-tight">Ajakan</h2>
          {invitedBy && (
            <p class="mt-2 text-sm text-zinc-300">Diajak oleh <a href={`/admin/pengguna/${invitedBy.user_id}`} class="font-medium text-accent hover:underline">{invitedBy.name}</a></p>
          )}
          {invited.length > 0 && (
            <>
              <p class="mt-3 text-sm text-zinc-400">Mengajak {invited.length} orang</p>
              <ul class="mt-2 divide-y divide-zinc-800 text-sm">
                {invited.map((x) => (
                  <li class="flex items-center justify-between gap-3 py-2">
                    <a href={`/admin/pengguna/${x.user_id}`} class="min-w-0 truncate font-medium text-accent hover:underline">{x.name}</a>
                    <span class="shrink-0 text-xs text-zinc-500">bergabung {fmt(x.at)}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      )}
      </Recap>
    </div>
  </AppShell>
</Base>
