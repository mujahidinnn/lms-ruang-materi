---
import { CircleHelp, CircleCheck, Flag, MessageSquareQuote, TriangleAlert } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { smallButton } from "@/components/admin/editor";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Report = {
  id: string;
  user_id: string;
  kind: "salah" | "tidak-jelas" | "lainnya";
  note: string;
  status: "baru" | "selesai";
  created_at: string;
  chapters: { slug: string; title: string; position: number; topics: { slug: string; title: string } };
};

const KIND = {
  salah: { label: "Ada yang salah", tone: "bg-tile-pink", Icon: TriangleAlert },
  "tidak-jelas": { label: "Kurang jelas", tone: "bg-tile-butter", Icon: CircleHelp },
  lainnya: { label: "Lainnya", tone: "bg-tile-lavender", Icon: MessageSquareQuote },
};
const ago = (iso: string) => {
  const m = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return m < 60 ? `${m} menit lalu` : m < 1440 ? `${Math.round(m / 60)} jam lalu` : `${Math.round(m / 1440)} hari lalu`;
};
const db = await createClient();
const [{ data }, { data: people }] = await Promise.all([
  db.from("chapter_reports").select("id, user_id, kind, note, status, created_at, chapters(slug, title, position, topics(slug, title))").order("created_at", { ascending: false }).limit(200),
  db.rpc("admin_users"),
]);
const names = new Map<string, string>(((people ?? []) as { user_id: string; display_name: string | null; email: string }[]).map((p) => [p.user_id, p.display_name || p.email]));
const all = (data ?? []) as unknown as Report[];
const open = all.filter((r) => r.status === "baru");
const done = all.filter((r) => r.status === "selesai");
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
---

<Base title="Laporan" description="Laporan murid tentang bab yang salah atau kurang jelas." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Laporan</h1>
          <p class="mt-2 text-sm text-zinc-400">Murid melapor dari bagian bawah tiap bab. Perbaiki di halaman kelas, lalu tandai selesai.</p>
        </div>
        <p class="flex gap-2 text-sm">
          <span class={`inline-flex min-h-9 items-center gap-1.5 rounded-full px-4 font-semibold tabular-nums text-zinc-50 ${open.length ? "bg-tile-pink" : "bg-tile-mint"}`}>{open.length} perlu ditangani</span>
          <span class="inline-flex min-h-9 items-center rounded-full bg-zinc-800 px-4 tabular-nums text-zinc-300">{done.length} selesai</span>
        </p>
      </div>

      {open.length === 0 ? (
        <div class="mt-8 flex flex-col items-center gap-3 rounded-[28px] bg-zinc-900 px-6 py-14 text-center shadow-soft">
          <span aria-hidden class="grid size-14 place-items-center rounded-2xl bg-tile-mint text-zinc-50"><CircleCheck className="size-7" /></span>
          <p class="font-bold">Semua laporan sudah ditangani</p>
          <p class="max-w-sm text-sm text-zinc-400">Laporan baru muncul di sini saat murid mengirimnya dari halaman bab.</p>
        </div>
      ) : (
        <ul class="mt-6 grid gap-3">
          {open.map((r) => {
            const k = KIND[r.kind];
            return (
              <li class="flex gap-4 rounded-[28px] bg-zinc-900 p-4 shadow-soft sm:p-5">
                <span aria-hidden class={`hidden size-11 shrink-0 place-items-center rounded-2xl text-zinc-50 sm:grid ${k.tone}`}><k.Icon className="size-5" /></span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class={`inline-flex min-h-7 items-center rounded-full px-3 text-xs font-semibold text-zinc-50 ${k.tone}`}>{k.label}</span>
                    <time datetime={r.created_at} title={when.format(new Date(r.created_at))} class="text-xs text-zinc-500">{ago(r.created_at)}</time>
                  </div>
                  <a href={`/admin/topik/${r.chapters.topics.slug}`} class="mt-2 block text-sm font-medium hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                    <span class="text-zinc-400">{r.chapters.topics.title}</span>, bab {r.chapters.position + 1}: {r.chapters.title}
                  </a>
                  <blockquote class="mt-3 rounded-2xl bg-zinc-800 px-4 py-3 text-sm whitespace-pre-line text-zinc-50">{r.note}</blockquote>
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xs text-zinc-500">Dari {names.get(r.user_id) ?? "(akun dihapus)"}</p>
                    <div class="flex flex-wrap gap-2">
                      <a href={`/belajar/${r.chapters.topics.slug}/${r.chapters.slug}`} class={smallButton}>Buka bab</a>
                      <ActionForm client:load action="selesaikanLaporan" className="flex">
                        <input type="hidden" name="id" value={r.id} />
                        <button class={`${smallButton} bg-tile-mint! text-zinc-50!`}>Tandai selesai</button>
                      </ActionForm>
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )}

      {done.length > 0 && (
        <details class="mt-8">
          <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50"><Flag aria-hidden className="size-4" />Sudah selesai ({done.length})</summary>
          <ul class="mt-2 divide-y divide-zinc-800 rounded-[28px] bg-zinc-900 px-5 shadow-soft">
            {done.map((r) => (
              <li class="py-3 text-sm">
                <p class="text-zinc-300">{r.chapters.topics.title}, bab {r.chapters.position + 1}: {r.chapters.title}</p>
                <p class="mt-0.5 line-clamp-2 text-xs text-zinc-500">{r.note}</p>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </AppShell>
</Base>
