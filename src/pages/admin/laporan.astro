---
import EmptyState from "../../components/EmptyState.astro";
import { CircleHelp, Flag, MessageSquareQuote, TriangleAlert } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { field, smallButton } from "@/components/admin/editor";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Report = {
  id: string;
  user_id: string;
  kind: "salah" | "tidak-jelas" | "lainnya" | "pertanyaan";
  note: string;
  status: "baru" | "selesai";
  response: string | null;
  source_url: string | null;
  resolved_at: string | null;
  created_at: string;
  chapters: { slug: string; title: string; position: number; topics: { slug: string; title: string } } | null;
  exam_questions: { prompt: string; exams: { topics: { slug: string; title: string } } } | null;
};

const KIND = {
  salah: { label: "Ada yang salah", tone: "bg-tile-pink", Icon: TriangleAlert },
  "tidak-jelas": { label: "Kurang jelas", tone: "bg-tile-butter", Icon: CircleHelp },
  lainnya: { label: "Lainnya", tone: "bg-tile-lavender", Icon: MessageSquareQuote },
  pertanyaan: { label: "Pertanyaan", tone: "bg-tile-sky", Icon: CircleHelp },
};
const ago = (iso: string) => {
  const m = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return m < 60 ? `${m} menit lalu` : m < 1440 ? `${Math.round(m / 60)} jam lalu` : `${Math.round(m / 1440)} hari lalu`;
};
const db = await createClient();
const [{ data }, { data: people }] = await Promise.all([
  db.from("chapter_reports").select("id, user_id, kind, note, status, created_at, response, source_url, resolved_at, chapters(slug, title, position, topics(slug, title)), exam_questions(prompt, exams(topics(slug, title)))").order("created_at", { ascending: false }).limit(200),
  db.rpc("admin_users"),
]);
const names = new Map<string, string>(((people ?? []) as { user_id: string; display_name: string | null; email: string }[]).map((p) => [p.user_id, p.display_name || p.email]));
const where = (r: Report) => {
  const c = r.chapters;
  if (c) return { topic: c.topics, text: `bab ${c.position + 1}: ${c.title}`, href: `/admin/topik/${c.topics.slug}`, open: `/belajar/${c.topics.slug}/${c.slug}`, openLabel: "Buka bab" };
  const t = r.exam_questions!.exams.topics;
  return { topic: t, text: `soal ujian: ${r.exam_questions!.prompt}`, href: "/admin/ujian", open: `/admin/ujian`, openLabel: "Buka ujian" };
};
const all = (data ?? []) as unknown as Report[];
const open = all.filter((r) => r.status === "baru");
const done = all.filter((r) => r.status === "selesai");
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
---

<Base title="Laporan" description="Laporan murid tentang bab atau soal ujian yang salah atau kurang jelas." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Laporan</h1>
          <p class="mt-2 text-sm text-zinc-400">Murid melapor dari bawah tiap bab dan tiap soal di pembahasan ujian. Perbaiki, lalu tandai selesai.</p>
        </div>
        <p class="flex gap-2 text-sm">
          <span class={`inline-flex min-h-9 items-center gap-1.5 rounded-full px-4 font-semibold tabular-nums text-zinc-50 ${open.length ? "bg-tile-pink" : "bg-tile-mint"}`}>{open.length} perlu ditangani</span>
          <span class="inline-flex min-h-9 items-center rounded-full bg-zinc-800 px-4 tabular-nums text-zinc-300">{done.length} selesai</span>
        </p>
      </div>

      {open.length === 0 ? (
        <EmptyState art="beres" title="Semua laporan sudah ditangani" class="mt-8 justify-center rounded-[18px] bg-zinc-900 px-6 py-10 shadow-soft">Laporan baru muncul di sini saat murid mengirimnya dari halaman bab.</EmptyState>
      ) : (
        <ul class="mt-6 grid gap-3">
          {open.map((r) => {
            const k = KIND[r.kind];
            const w = where(r);
            return (
              <li class="flex gap-4 rounded-[18px] bg-zinc-900 p-4 shadow-soft sm:p-5">
                <span aria-hidden class={`hidden size-11 shrink-0 place-items-center rounded-xl text-zinc-50 sm:grid ${k.tone}`}><k.Icon className="size-5" /></span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class={`inline-flex min-h-7 items-center rounded-full px-3 text-xs font-semibold text-zinc-50 ${k.tone}`}>{k.label}</span>
                    <time datetime={r.created_at} tabindex="0" data-tip={when.format(new Date(r.created_at))} class="text-xs text-zinc-500">{ago(r.created_at)}</time>
                  </div>
                  <a href={w.href} class="mt-2 block text-sm font-medium hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                    <span class="text-zinc-400">{w.topic.title}</span>, <span class="line-clamp-2">{w.text}</span>
                  </a>
                  <blockquote class="mt-3 rounded-xl bg-zinc-800 px-4 py-3 text-sm whitespace-pre-line text-zinc-50">{r.note}</blockquote>
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xs text-zinc-500">Dari {names.get(r.user_id) ?? "(akun dihapus)"}</p>
                    <a href={w.open} class={smallButton}>{w.openLabel}</a>
                  </div>
                  <ActionForm client:load action="selesaikanLaporan" className="mt-4 grid gap-2 border-t border-zinc-800 pt-4">
                    <input type="hidden" name="id" value={r.id} />
                    <label class="text-xs font-semibold text-zinc-400" for={`resp-${r.id}`}>{r.kind === "pertanyaan" ? "Jawaban" : "Apa yang diperbaiki"} <span class="font-normal text-zinc-500">(ikut dikirim ke email pelapor)</span></label>
                    <textarea id={`resp-${r.id}`} name="response" rows="3" maxlength="2000" class={`${field} py-3`} placeholder={r.kind === "pertanyaan" ? "Jelaskan jawabannya untuk murid" : "Mis. definisi baris dan kolom diperjelas dengan contoh tabel"}></textarea>
                    <label class="text-xs font-semibold text-zinc-400" for={`src-${r.id}`}>Link sumber <span class="font-normal text-zinc-500">(opsional)</span></label>
                    <input id={`src-${r.id}`} name="source_url" type="text" inputmode="url" maxlength="500" class={field} placeholder={w.open} />
                    <button class={`${smallButton} mt-1 justify-self-end bg-tile-mint! text-zinc-50!`}>Tandai selesai</button>
                  </ActionForm>
                </div>
              </li>
            );
          })}
        </ul>
      )}

      {done.length > 0 && (
        <details class="mt-8">
          <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50"><Flag aria-hidden className="size-4" />Sudah selesai ({done.length})</summary>
          <ul class="mt-2 divide-y divide-zinc-800 rounded-[18px] bg-zinc-900 px-5 shadow-soft">
            {done.map((r) => {
              const k = KIND[r.kind];
              const w = where(r);
              return (
                <li class="py-3 text-sm">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class={`inline-flex min-h-6 items-center rounded-full px-2.5 text-xs font-semibold text-zinc-50 ${k.tone}`}>{k.label}</span>
                    <a href={w.open} class="min-w-0 text-zinc-300 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">{w.topic.title}, {w.text}</a>
                  </div>
                  <p class="mt-1.5 text-sm whitespace-pre-line text-zinc-400">{r.note}</p>
                  <p class="mt-1 text-xs text-zinc-500">Dari {names.get(r.user_id) ?? "(akun dihapus)"} · <time datetime={r.created_at}>{when.format(new Date(r.created_at))}</time></p>
                  {(r.response || r.source_url) && (
                    <div class="mt-2 rounded-xl bg-zinc-800 px-4 py-3">
                      <p class="text-xs font-semibold text-zinc-400">{r.kind === "pertanyaan" ? "Jawaban" : "Perbaikan"}{r.resolved_at && <span class="font-normal text-zinc-500"> · <time datetime={r.resolved_at}>{when.format(new Date(r.resolved_at))}</time></span>}</p>
                      {r.response && <p class="mt-1 text-sm whitespace-pre-line text-zinc-50">{r.response}</p>}
                      {r.source_url && <a href={r.source_url} target={r.source_url.startsWith("/") ? undefined : "_blank"} rel="noopener" class="mt-1.5 block truncate text-xs text-accent hover:underline">{r.source_url}</a>}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      )}
    </div>
  </AppShell>
</Base>
