---
import { Award, BookOpenCheck, ClipboardCheck, TriangleAlert } from "lucide-react";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Analytics = {
  topics: { slug: string; title: string; started: number; finished: number }[];
  chapters: { slug: string; topic: string; position: number; title: string; started: number; done: number }[];
  questions: { id: string; slug: string; topic: string; prompt: string; seen: number; wrong: number }[];
};
type Attempt = { score: number | null; passed: boolean | null; exams: { topics: { slug: string } } };

const db = await createClient();
const { data } = await db.rpc("admin_analytics");
const a = data as Analytics | null;
if (!a) return Astro.rewrite("/404");

// Extra detail read through the admin's own access; a failed read only hides its column.
const since = new Date(Date.now() - 30 * 864e5).toISOString();
const since30 = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
const [{ data: att }, { data: chs }, { data: certs }, { data: qs }, { data: jobData }, { data: days }, { data: done }, { data: people }] = await Promise.all([
  db.from("exam_attempts").select("score, passed, exams(topics(slug))").not("submitted_at", "is", null).limit(5000),
  db.from("chapters").select("topics(slug)").eq("status", "published"),
  db.from("certificates").select("topics(slug)").limit(5000),
  db.from("exam_questions").select("id, options, answer").in("id", a.questions.map((q) => q.id)),
  db.from("import_jobs").select("provider, model, status, input_tokens, output_tokens").gte("created_at", since).limit(2000),
  db.from("learning_days").select("user_id").gte("day", since30).limit(20000),
  db.from("chapter_progress").select("user_id").limit(20000),
  db.rpc("admin_users"),
]);
const count = <T,>(rows: T[] | null, slug: (r: T) => string | undefined) => {
  const m = new Map<string, number>();
  for (const r of rows ?? []) { const s = slug(r); if (s) m.set(s, (m.get(s) ?? 0) + 1); }
  return m;
};
const chapterCount = count((chs ?? []) as unknown as { topics: { slug: string } }[], (r) => r.topics?.slug);
const certCount = count((certs ?? []) as unknown as { topics: { slug: string } }[], (r) => r.topics?.slug);
const attempts = (att ?? []) as unknown as Attempt[];
const examBy = new Map<string, { n: number; sum: number; passed: number }>();
for (const t of attempts) {
  const s = t.exams?.topics?.slug;
  if (!s) continue;
  const e = examBy.get(s) ?? { n: 0, sum: 0, passed: 0 };
  e.n++; e.sum += t.score ?? 0; e.passed += t.passed ? 1 : 0;
  examBy.set(s, e);
}
const keyOf = new Map(((qs ?? []) as { id: string; options: string[]; answer: number }[]).map((q) => [q.id, q.options[q.answer]]));

type Job = { provider: string; model: string; status: string; input_tokens: number | null; output_tokens: number | null };
const byModel = new Map<string, { name: string; jobs: number; done: number; failed: number; tin: number; tout: number }>();
for (const j of (jobData ?? []) as Job[]) {
  const name = `${j.provider} / ${j.model}`;
  const m = byModel.get(name) ?? { name, jobs: 0, done: 0, failed: 0, tin: 0, tout: 0 };
  m.jobs++; m.done += j.status === "done" ? 1 : 0; m.failed += j.status === "failed" ? 1 : 0;
  m.tin += j.input_tokens ?? 0; m.tout += j.output_tokens ?? 0;
  byModel.set(name, m);
}
const models = [...byModel.values()].sort((x, y) => y.jobs - x.jobs);
const nf = new Intl.NumberFormat("id-ID");
// Diligent: most study days in 30 days. Slipping: studied before, quiet for 14+ days.
type Person = { user_id: string; email: string; display_name: string | null; role: string; last_active_at: string | null };
const tally = (rows: { user_id: string }[] | null) => {
  const m = new Map<string, number>();
  for (const r of rows ?? []) m.set(r.user_id, (m.get(r.user_id) ?? 0) + 1);
  return m;
};
const dayCount = tally(days);
const chapterDone = tally(done);
const students = ((people ?? []) as Person[]).filter((x) => x.role === "student");
const label = (x: Person) => x.display_name || x.email;
const diligent = students
  .map((x) => ({ x, days: dayCount.get(x.user_id) ?? 0, chapters: chapterDone.get(x.user_id) ?? 0 }))
  .filter((r) => r.days > 0)
  .sort((a, b) => b.days - a.days || b.chapters - a.chapters)
  .slice(0, 5);
const cutoff = Date.now() - 14 * 864e5;
const slipping = students
  .filter((x) => x.last_active_at && new Date(x.last_active_at).getTime() < cutoff && (chapterDone.get(x.user_id) ?? 0) > 0)
  .sort((a, b) => new Date(a.last_active_at!).getTime() - new Date(b.last_active_at!).getTime())
  .slice(0, 5);
const idDate = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" });
const pct = (n: number, d: number) => (d ? Math.round((100 * n) / d) : 0);
const topics = a.topics.filter((t) => t.started > 0);
const chapters = a.chapters.slice(0, 10);
const learners = topics.reduce((n, t) => n + t.started, 0);
const finished = topics.reduce((n, t) => n + t.finished, 0);
const avgScore = attempts.length ? Math.round(attempts.reduce((s, t) => s + (t.score ?? 0), 0) / attempts.length) : 0;
const passRate = pct(attempts.filter((t) => t.passed).length, attempts.length);
const hard = a.questions.filter((q) => pct(q.wrong, q.seen) >= 70).length;

const tiles = [
  { label: "Kelas dibuka murid", value: learners, note: `di ${topics.length} kelas`, tone: "bg-tile-mint", Icon: BookOpenCheck },
  { label: "Kelas selesai", value: finished, note: `${pct(finished, learners)}% dari yang dibuka`, tone: "bg-tile-peach", Icon: Award },
  { label: "Rata-rata nilai ujian", value: attempts.length ? avgScore : "-", note: attempts.length ? `${passRate}% percobaan lulus, ${attempts.length} percobaan` : "belum ada percobaan", tone: "bg-tile-lavender", Icon: ClipboardCheck },
  { label: "Soal perlu dicek", value: hard, note: "salah 70% atau lebih", tone: hard ? "bg-tile-pink" : "bg-tile-sky", Icon: TriangleAlert },
];
const good = "bg-brand";
const bad = "bg-red-400";
const card = "rounded-[28px] bg-zinc-900 p-5 shadow-soft sm:p-6";
const track = "h-2.5 overflow-hidden rounded-full bg-zinc-800";
---

<Base title="Analitik" description="Di mana murid berhenti belajar dan soal ujian mana yang paling sering salah." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto flex max-w-5xl flex-col gap-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Analitik</h1>
        <p class="mt-2 text-sm text-zinc-400">Bahan untuk memperbaiki materi: kelas yang jarang selesai, bab tempat murid berhenti, dan soal yang sering salah.</p>
      </div>

      <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {tiles.map(({ label, value, note, tone, Icon }) => (
          <div class={`flex flex-col gap-3 rounded-[28px] p-4 sm:p-5 ${tone}`}>
            <span aria-hidden class="grid size-10 place-items-center rounded-2xl bg-zinc-900/60 text-zinc-50"><Icon className="size-5" /></span>
            <div>
              <dt class="text-sm text-zinc-300">{label}</dt>
              <dd class="text-3xl font-bold tabular-nums text-zinc-50">{value}</dd>
              <p class="mt-0.5 text-xs text-zinc-300">{note}</p>
            </div>
          </div>
        ))}
      </dl>

      <section aria-labelledby="kelas" class={card}>
        <h2 id="kelas" class="text-lg font-bold tracking-tight">Kelas</h2>
        <p class="mt-1 text-sm text-zinc-400">Murid yang menyelesaikan kelas dari yang membukanya. Kelas tanpa murid tidak ditampilkan.</p>
        {topics.length === 0 ? (
          <p class="mt-4 text-sm text-zinc-400">Belum ada murid yang membuka kelas.</p>
        ) : (
          <div class="mt-4">
            <div aria-hidden class="hidden grid-cols-[minmax(0,1fr)_5rem_5rem_6rem_5rem] gap-4 border-b border-zinc-800 pb-2 text-xs text-zinc-500 md:grid">
              <span>Kelas</span><span class="text-right">Murid</span><span class="text-right">Bab</span><span class="text-right">Nilai ujian</span><span class="text-right">Sertifikat</span>
            </div>
            <ul class="divide-y divide-zinc-800">
              {topics.map((t) => {
                const p = pct(t.finished, t.started);
                const ex = examBy.get(t.slug);
                return (
                  <li class="grid gap-x-4 gap-y-2 py-3 md:grid-cols-[minmax(0,1fr)_5rem_5rem_6rem_5rem] md:items-center">
                    <a href={`/admin/topik/${t.slug}`} class="group min-w-0 focus-visible:outline-2 focus-visible:outline-accent">
                      <p class="flex items-baseline justify-between gap-3 text-sm"><span class="truncate font-medium group-hover:text-accent">{t.title}</span><span class="shrink-0 text-xs tabular-nums text-zinc-400">{t.finished} dari {t.started} selesai ({p}%)</span></p>
                      <div aria-hidden class={`mt-2 ${track}`}><div class={`h-full rounded-full ${p >= 30 ? good : bad}`} style={`width:${p}%`}></div></div>
                    </a>
                    <dl class="grid grid-cols-4 gap-2 text-xs tabular-nums text-zinc-400 md:contents md:text-sm md:text-zinc-50">
                      <div class="md:text-right"><dt class="md:sr-only">Murid</dt><dd>{t.started}</dd></div>
                      <div class="md:text-right"><dt class="md:sr-only">Bab</dt><dd>{chapterCount.get(t.slug) ?? 0}</dd></div>
                      <div class="md:text-right"><dt class="md:sr-only">Nilai ujian</dt><dd>{ex ? `${Math.round(ex.sum / ex.n)} (${ex.n}x)` : "-"}</dd></div>
                      <div class="md:text-right"><dt class="md:sr-only">Sertifikat</dt><dd>{certCount.get(t.slug) ?? 0}</dd></div>
                    </dl>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </section>

      <div class="grid gap-6 lg:grid-cols-2">
        <section aria-labelledby="rajin" class={card}>
          <h2 id="rajin" class="text-lg font-bold tracking-tight">Murid paling rajin</h2>
          <p class="mt-1 text-sm text-zinc-400">Paling banyak hari belajar dalam 30 hari terakhir.</p>
          {diligent.length === 0 ? (
            <p class="mt-4 text-sm text-zinc-400">Belum ada aktivitas belajar 30 hari terakhir.</p>
          ) : (
            <ol class="mt-3 divide-y divide-zinc-800">
              {diligent.map((r, i) => (
                <li>
                  <a href={`/admin/pengguna/${r.x.user_id}`} data-murid class="flex min-h-14 items-center gap-3 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                    <span aria-hidden class={`grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold text-zinc-50 ${i === 0 ? "bg-tile-peach" : "bg-zinc-800"}`}>{i + 1}</span>
                    <span class="min-w-0 flex-1 truncate text-sm font-medium" data-nama>{label(r.x)}</span>
                    <span class="shrink-0 text-right text-xs tabular-nums text-zinc-400"><span class="block font-semibold text-zinc-50">{r.days} hari</span>{r.chapters} bab selesai</span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>

        <section aria-labelledby="jarang" class={card}>
          <h2 id="jarang" class="text-lg font-bold tracking-tight">Mulai jarang aktif</h2>
          <p class="mt-1 text-sm text-zinc-400">Sudah pernah menyelesaikan bab, tapi tidak aktif 14 hari atau lebih. Cocok untuk diberi pengumuman.</p>
          {slipping.length === 0 ? (
            <p class="mt-4 text-sm text-zinc-400">Tidak ada. Semua murid yang pernah belajar masih aktif.</p>
          ) : (
            <ul class="mt-3 divide-y divide-zinc-800">
              {slipping.map((x) => (
                <li>
                  <a href={`/admin/pengguna/${x.user_id}`} data-murid class="flex min-h-14 items-center gap-3 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                    <span class="min-w-0 flex-1 truncate text-sm font-medium" data-nama>{label(x)}</span>
                    <span class="shrink-0 text-right text-xs tabular-nums text-zinc-400"><span class="block font-semibold text-zinc-50">{Math.floor((Date.now() - new Date(x.last_active_at!).getTime()) / 864e5)} hari lalu</span>{idDate.format(new Date(x.last_active_at!))}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>

      <section aria-labelledby="bab" class={card}>
        <h2 id="bab" class="text-lg font-bold tracking-tight">Bab yang jarang diselesaikan</h2>
        <p class="mt-1 text-sm text-zinc-400">Dari murid yang sudah membuka kelasnya, berapa persen yang menyelesaikan bab ini. Hanya kelas dengan minimal 3 murid.</p>
        {chapters.length === 0 ? (
          <p class="mt-4 text-sm text-zinc-400">Belum cukup data. Muncul setelah sebuah kelas dibuka minimal 3 murid.</p>
        ) : (
          <ol class="mt-4 grid gap-4">
            {chapters.map((c) => {
              const p = pct(c.done, c.started);
              return (
                <li>
                  <a href={`/admin/topik/${c.slug}`} class="group block focus-visible:outline-2 focus-visible:outline-accent">
                    <p class="flex items-baseline justify-between gap-3 text-sm">
                      <span class="min-w-0 truncate"><span class="font-medium group-hover:text-accent">Bab {c.position + 1}: {c.title}</span> <span class="text-zinc-500">{c.topic}</span></span>
                      <span class="shrink-0 text-xs tabular-nums text-zinc-400">{c.done} dari {c.started} murid ({p}%)</span>
                    </p>
                    <div aria-hidden class={`mt-2 ${track}`}><div class={`h-full rounded-full ${p >= 30 ? good : bad}`} style={`width:${p}%`}></div></div>
                  </a>
                </li>
              );
            })}
          </ol>
        )}
      </section>

      <section aria-labelledby="soal" class={card}>
        <h2 id="soal" class="text-lg font-bold tracking-tight">Soal ujian yang paling sering salah</h2>
        <p class="mt-1 text-sm text-zinc-400">Soal yang muncul di minimal 3 percobaan. Soal yang dilewati dihitung salah. Tingkat salah sangat tinggi bisa berarti kunci atau redaksinya keliru.</p>
        {a.questions.length === 0 ? (
          <p class="mt-4 text-sm text-zinc-400">Belum cukup percobaan ujian.</p>
        ) : (
          <ol class="mt-4 divide-y divide-zinc-800">
            {a.questions.map((q) => {
              const p = pct(q.wrong, q.seen);
              return (
                <li class="py-3">
                  <a href={`/admin/topik/${q.slug}#ujian`} class="group block focus-visible:outline-2 focus-visible:outline-accent">
                    <p class="flex items-start justify-between gap-4 text-sm">
                      <span class="line-clamp-2 min-w-0 group-hover:text-accent">{q.prompt}</span>
                      <span class={`inline-flex min-h-7 shrink-0 items-center rounded-full px-3 text-xs font-semibold tabular-nums ${p >= 70 ? "bg-tile-pink" : "bg-zinc-800"} text-zinc-50`}>{p}% salah</span>
                    </p>
                    <div aria-hidden class="mt-2 h-1.5 overflow-hidden rounded-full bg-zinc-800"><div class={`h-full rounded-full ${p >= 70 ? bad : good}`} style={`width:${p}%`}></div></div>
                    <p class="mt-1.5 flex flex-wrap justify-between gap-x-4 text-xs text-zinc-500">
                      <span class="min-w-0 truncate">{q.topic}{keyOf.get(q.id) ? `, kunci: ${keyOf.get(q.id)}` : ""}</span>
                      <span class="tabular-nums">{q.wrong} dari {q.seen} percobaan</span>
                    </p>
                  </a>
                </li>
              );
            })}
          </ol>
        )}
      </section>

      <section aria-labelledby="impor" class={card}>
        <h2 id="impor" class="text-lg font-bold tracking-tight">Impor AI, 30 hari terakhir</h2>
        <p class="mt-1 text-sm text-zinc-400">Jumlah impor dan token per model, untuk memantau pemakaian dan model yang sering gagal.</p>
        {models.length === 0 ? (
          <p class="mt-4 text-sm text-zinc-400">Belum ada impor dalam 30 hari terakhir.</p>
        ) : (
          <div class="mt-4 overflow-x-auto">
            <table class="w-full min-w-[34rem] text-left text-sm">
              <thead class="text-xs text-zinc-500">
                <tr class="border-b border-zinc-800">
                  <th scope="col" class="py-2 pr-3 font-normal">Model</th>
                  <th scope="col" class="py-2 pr-3 text-right font-normal">Impor</th>
                  <th scope="col" class="py-2 pr-3 text-right font-normal">Gagal</th>
                  <th scope="col" class="py-2 pr-3 text-right font-normal">Token masuk</th>
                  <th scope="col" class="py-2 text-right font-normal">Token keluar</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800 tabular-nums">
                {models.map((m) => (
                  <tr>
                    <td class="py-3 pr-3 font-medium">{m.name}</td>
                    <td class="py-3 pr-3 text-right">{m.jobs}</td>
                    <td class={`py-3 pr-3 text-right ${m.failed ? "font-semibold text-red-500" : "text-zinc-400"}`}>{m.failed}</td>
                    <td class="py-3 pr-3 text-right">{nf.format(m.tin)}</td>
                    <td class="py-3 text-right">{nf.format(m.tout)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </div>
  </AppShell>
</Base>
