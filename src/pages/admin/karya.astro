---
import { ExternalLink, Rocket } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { smallButton } from "@/components/admin/editor";
import { STUDIO_TITLES } from "@/lib/studio/portofolio";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = { user_id: string; project: string; url: string; hidden: boolean; updated_at: string };
const db = await createClient();
const [{ data }, { data: people }] = await Promise.all([
  db.from("studio_projects").select("user_id, project, url, hidden, updated_at").order("updated_at", { ascending: false }).limit(200),
  db.rpc("admin_users"),
]);
const names = new Map<string, string>(((people ?? []) as { user_id: string; display_name: string | null; email: string }[]).map((p) => [p.user_id, p.display_name || p.email]));
const rows = (data ?? []) as Row[];
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
---

<Base title="Karya" description="Alamat situs yang dikirim murid dari Studio Proyek." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Karya</h1>
      <p class="mt-2 text-sm text-zinc-400">Alamat situs yang dikirim murid dari Studio Proyek. Alamat yang disembunyikan tidak tampil di profil publik dan tidak bisa dihapus lalu dikirim ulang oleh pemiliknya.</p>

      {rows.length === 0 ? (
        <div class="mt-8 flex flex-col items-center gap-3 rounded-[18px] bg-zinc-900 px-6 py-14 text-center shadow-soft">
          <span aria-hidden class="grid size-14 place-items-center rounded-xl bg-tile-mint text-zinc-50"><Rocket className="size-7" /></span>
          <p class="font-bold">Belum ada karya</p>
          <p class="max-w-sm text-sm text-zinc-400">Alamat yang dikirim murid dari Studio Proyek muncul di sini.</p>
        </div>
      ) : (
        <ul class="mt-6 grid gap-3">
          {rows.map((r) => (
            <li class="flex flex-wrap items-center gap-4 rounded-[18px] bg-zinc-900 p-4 shadow-soft sm:p-5">
              <div class="min-w-0 flex-1 basis-64">
                <p class="flex flex-wrap items-center gap-2 text-sm font-bold">
                  {names.get(r.user_id) ?? "(akun dihapus)"}
                  <span class="text-xs font-normal text-zinc-500">{STUDIO_TITLES[r.project] ?? r.project}</span>
                  {r.hidden && <span class="rounded-full bg-tile-pink px-2.5 py-0.5 text-xs font-semibold text-zinc-50">Disembunyikan</span>}
                </p>
                <a href={r.url} target="_blank" rel="nofollow noopener noreferrer" class="mt-1 inline-flex max-w-full items-center gap-1.5 text-sm text-accent hover:underline"><span class="truncate">{r.url}</span><ExternalLink aria-hidden className="size-3.5 shrink-0" /></a>
                <p class="mt-1 text-xs text-zinc-500">Diperbarui {when.format(new Date(r.updated_at))}</p>
              </div>
              <ActionForm client:load action="aturKarya" className="flex">
                <input type="hidden" name="user" value={r.user_id} />
                <input type="hidden" name="project" value={r.project} />
                <input type="hidden" name="hidden" value={r.hidden ? "0" : "1"} />
                <button class={smallButton}>{r.hidden ? "Tampilkan" : "Sembunyikan"}</button>
              </ActionForm>
            </li>
          ))}
        </ul>
      )}
    </div>
  </AppShell>
</Base>
