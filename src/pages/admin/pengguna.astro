---
import PenggunaList from "@/components/admin/PenggunaList";
import { loadPeople } from "@/lib/pengguna";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

const people = await loadPeople(user.id);
---

<Base title="Pengguna" description="Lihat semua akun dan atur siapa yang menjadi admin." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Pengguna</h1>
      <p class="mt-2 text-sm text-zinc-400">
        Admin bisa mengelola semua materi. Role dirimu sendiri tidak bisa diubah di sini.
      </p>
      <PenggunaList client:load people={people} />
    </div>
  </AppShell>
</Base>
