---
import PenggunaList, { type Person } from "@/components/admin/PenggunaList";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = {
  user_id: string;
  email: string;
  display_name: string | null;
  role: "student" | "admin";
  provider: string;
  avatar_url: string | null;
  created_at: string;
  last_sign_in_at: string | null;
  last_active_at: string | null;
  confirmed: boolean;
};

const fmt = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" });
const stamp = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
const day = (d: Date) => Math.floor((d.getTime() + 7 * 36e5) / 864e5); // WIB calendar day
function ago(iso: string | null) {
  if (!iso) return "Belum pernah masuk";
  const at = new Date(iso);
  const min = Math.floor((Date.now() - at.getTime()) / 6e4);
  if (min < 5) return "Baru saja aktif";
  if (min < 60) return `${min} menit lalu`;
  if (min < 60 * 6) return `${Math.floor(min / 60)} jam lalu`;
  const n = day(new Date()) - day(at);
  return n <= 0 ? "Hari ini" : n === 1 ? "Kemarin" : n < 30 ? `${n} hari lalu` : fmt.format(at);
}

const { data } = await (await createClient()).rpc("admin_users");
const rows = (data ?? []) as Row[];
const people: Person[] = rows.map((r) => ({
  id: r.user_id,
  name: r.display_name || r.email.split("@")[0],
  email: r.email,
  admin: r.role === "admin",
  me: r.user_id === user.id,
  pending: !r.confirmed,
  provider: r.provider,
  avatar: r.avatar_url,
  joined: fmt.format(new Date(r.created_at)),
  joinedAt: Date.parse(r.created_at),
  seen: ago(r.last_active_at ?? r.last_sign_in_at),
  seenFull: r.last_active_at ? stamp.format(new Date(r.last_active_at)) : "",
  online: !!r.last_active_at && Date.now() - Date.parse(r.last_active_at) < 6 * 6e4,
  seenAt: r.last_active_at ? Date.parse(r.last_active_at) : 0,
}));
---

<Base title="Pengguna" description="Lihat semua akun dan atur siapa yang menjadi admin." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-4xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Pengguna</h1>
      <p class="mt-2 text-sm text-zinc-400">
        Admin bisa mengelola semua materi. Role dirimu sendiri tidak bisa diubah di sini.
      </p>
      <PenggunaList client:load people={people} />
    </div>
  </AppShell>
</Base>
