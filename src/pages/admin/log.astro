---
import EmptyState from "../../components/EmptyState.astro";
import { ChevronDown, History, Megaphone, Pencil, Plus, ShieldCheck, Trash2, Undo2, Upload, UserPlus } from "lucide-react";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = { id: number; admin_email: string; action: string; detail: string; meta: [string, string][]; created_at: string };
const { data } = await (await createClient()).from("admin_audit_log").select("id, admin_email, action, detail, meta, created_at").order("created_at", { ascending: false }).limit(200);
// Older rows stored the account's UUID; show its email where it still exists.
const { data: people } = await (await createClient()).rpc("admin_users");
const emails = new Map(((people ?? []) as { user_id: string; email: string }[]).map((p) => [p.user_id, p.email]));
const rows = ((data ?? []) as Row[]).map((r) => ({ ...r, detail: r.detail?.replace(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/g, (id) => emails.get(id) ?? id) }));
const full = new Intl.DateTimeFormat("id-ID", { dateStyle: "full", timeStyle: "medium", timeZone: "Asia/Jakarta" });
const clock = new Intl.DateTimeFormat("id-ID", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
const dayKey = new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Jakarta" });
const dayName = new Intl.DateTimeFormat("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Jakarta" });

// Icon and tile by what the action does: publish, withdraw, delete, people, announce.
const look = (action: string) =>
  action.startsWith("Terbitkan") ? { Icon: Upload, tone: "bg-tile-mint" }
  : action.startsWith("Tarik") ? { Icon: Undo2, tone: "bg-tile-butter" }
  : action.startsWith("Hapus") ? { Icon: Trash2, tone: "bg-tile-pink" }
  : action.startsWith("Ganti role") ? { Icon: ShieldCheck, tone: "bg-tile-lavender" }
  : action.startsWith("Undang") ? { Icon: UserPlus, tone: "bg-tile-sky" }
  : action.startsWith("Kirim") ? { Icon: Megaphone, tone: "bg-tile-peach" }
  : /^(Tambah|Buat)/.test(action) ? { Icon: Plus, tone: "bg-tile-mint" }
  : /^(Simpan|Ubah|Geser)/.test(action) ? { Icon: Pencil, tone: "bg-tile-butter" }
  : { Icon: History, tone: "bg-zinc-800" };

const days: { key: string; label: string; rows: Row[] }[] = [];
for (const r of rows) {
  const key = dayKey.format(new Date(r.created_at));
  if (days.at(-1)?.key !== key) days.push({ key, label: dayName.format(new Date(r.created_at)), rows: [] });
  days.at(-1)!.rows.push(r);
}
---

<Base title="Log aktivitas" description="Catatan perubahan penting yang dilakukan admin." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Log aktivitas</h1>
      <p class="mt-2 text-sm text-zinc-400">Semua perubahan yang dilakukan admin. Klik baris untuk melihat rinciannya. Menampilkan 200 terbaru.</p>
      {days.length === 0 ? (
        <EmptyState title="Belum ada catatan" class="mt-8 justify-center rounded-2xl bg-zinc-900 px-6 py-10 shadow-soft">Muncul setelah admin mengubah role, menerbitkan kelas, atau mengirim pengumuman.</EmptyState>
      ) : (
        <div class="mt-6 flex flex-col gap-6">
          {days.map((d) => (
            <section aria-label={d.label}>
              <h2 class="mb-2 px-1 text-sm font-semibold text-zinc-400">{d.label}</h2>
              <ul class="rounded-2xl bg-zinc-900 px-4 shadow-soft sm:px-5">
                {d.rows.map((r, i) => {
                  const { Icon, tone } = look(r.action);
                  return (
                    <li class={i ? "border-t border-zinc-800" : ""}>
                      <details class="group">
                        <summary class="-mx-2 flex cursor-pointer list-none items-start gap-3 rounded-xl px-2 py-3.5 hover:bg-zinc-800/50 focus-visible:outline-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
                          <span aria-hidden class={`grid size-10 shrink-0 place-items-center rounded-xl text-zinc-50 ${tone}`}><Icon className="size-[18px]" /></span>
                          <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">{r.action}</p>
                            {r.detail && <p class="mt-0.5 text-sm break-words text-zinc-400">{r.detail}</p>}
                            <p class="mt-1 truncate text-xs text-zinc-500">{r.admin_email}</p>
                          </div>
                          <span class="flex shrink-0 items-center gap-1.5 pt-0.5 text-xs tabular-nums text-zinc-500">
                            <time datetime={r.created_at}>{clock.format(new Date(r.created_at))}</time>
                            <ChevronDown aria-hidden className="size-4 transition-transform group-open:rotate-180 motion-reduce:transition-none" />
                          </span>
                        </summary>
                        <dl class="mb-3.5 ml-13 grid grid-cols-1 gap-x-4 gap-y-2 rounded-xl bg-zinc-950/60 p-3 text-sm sm:grid-cols-[10rem_minmax(0,1fr)]">
                          {([["Waktu", full.format(new Date(r.created_at))], ["Admin", r.admin_email], ...(r.meta ?? [])] as [string, string][]).map(([k, v]) => (
                            <>
                              <dt class="text-xs font-medium text-zinc-500 sm:pt-0.5">{k}</dt>
                              <dd class="break-words whitespace-pre-line text-zinc-300 max-sm:-mt-1.5">{/^\/[a-z]/.test(v) ? <a href={v} class="font-medium text-accent underline underline-offset-2 hover:no-underline">{v}</a> : v}</dd>
                            </>
                          ))}
                          {!r.meta?.length && <p class="text-xs text-zinc-500 sm:col-span-2">Rincian tambahan belum dicatat untuk baris ini.</p>}
                        </dl>
                      </details>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      )}
    </div>
  </AppShell>
</Base>
