---
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = { id: number; admin_email: string; action: string; detail: string; created_at: string };
const { data } = await (await createClient()).from("admin_audit_log").select("id, admin_email, action, detail, created_at").order("created_at", { ascending: false }).limit(200);
const rows = (data ?? []) as Row[];
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
---

<Base title="Log aktivitas" description="Catatan perubahan penting yang dilakukan admin." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Log aktivitas</h1>
      <p class="mt-2 text-sm text-zinc-400">Perubahan role, penghapusan, penerbitan, dan pengumuman. Menampilkan 200 terbaru.</p>
      {rows.length === 0 ? (
        <p class="mt-6 text-zinc-400">Belum ada catatan. Muncul setelah admin mengubah role, menerbitkan kelas, atau mengirim pengumuman.</p>
      ) : (
        <ul class="mt-6 divide-y divide-zinc-800 rounded-[28px] bg-zinc-900 px-5 shadow-soft">
          {rows.map((r) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
              <p class="min-w-0 text-sm"><span class="font-medium">{r.action}</span>{r.detail && <span class="text-zinc-400">: {r.detail}</span>}</p>
              <p class="text-xs text-zinc-500">{r.admin_email}, <time datetime={r.created_at}>{when.format(new Date(r.created_at))}</time></p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </AppShell>
</Base>
