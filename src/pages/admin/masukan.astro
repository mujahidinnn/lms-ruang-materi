---
import EmptyState from "../../components/EmptyState.astro";
import { Bug, BookOpen, Lightbulb, MessageCircle, MessageSquareText, Palette } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { smallButton } from "@/components/admin/editor";
import { MASUKAN, type MasukanId } from "@/lib/masukan";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = { id: string; user_id: string; category: MasukanId; message: string; page: string | null; status: "baru" | "selesai"; created_at: string };
const ICON = { saran: Lightbulb, bug: Bug, konten: BookOpen, tampilan: Palette, lainnya: MessageCircle };
const TONE = { saran: "bg-tile-mint", bug: "bg-tile-pink", konten: "bg-tile-butter", tampilan: "bg-tile-lavender", lainnya: "bg-tile-sky" };
const label = Object.fromEntries(MASUKAN.map((m) => [m.id, m.label])) as Record<MasukanId, string>;

const db = await createClient();
const [{ data }, { data: people }] = await Promise.all([
  db.from("feedback").select("id, user_id, category, message, page, status, created_at").order("created_at", { ascending: false }).limit(200),
  db.rpc("admin_users"),
]);
const names = new Map<string, string>(((people ?? []) as { user_id: string; display_name: string | null; email: string }[]).map((p) => [p.user_id, p.display_name || p.email]));
const all = (data ?? []) as Row[];
const filter = MASUKAN.some((m) => m.id === Astro.url.searchParams.get("jenis")) ? (Astro.url.searchParams.get("jenis") as MasukanId) : null;
const shown = filter ? all.filter((r) => r.category === filter) : all;
const open = shown.filter((r) => r.status === "baru");
const done = shown.filter((r) => r.status === "selesai");
const count = (id: MasukanId) => all.filter((r) => r.category === id && r.status === "baru").length;
const ago = (iso: string) => {
  const m = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return m < 60 ? `${m} menit lalu` : m < 1440 ? `${Math.round(m / 60)} jam lalu` : `${Math.round(m / 1440)} hari lalu`;
};
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
const pill = "inline-flex min-h-10 items-center gap-2 rounded-full px-4 text-sm font-semibold";
---

<Base title="Masukan" description="Masukan dan saran dari pengguna Ruang Materi." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Masukan</h1>
          <p class="mt-2 text-sm text-zinc-400">Saran, kendala, dan kritik dari halaman Masukan dan saran. Laporan bab dan soal ujian ada di menu Laporan.</p>
        </div>
        <p class="flex gap-2 text-sm">
          <span class={`${pill} tabular-nums text-zinc-50 ${open.length ? "bg-tile-pink" : "bg-tile-mint"}`}>{open.length} baru</span>
          <span class={`${pill} bg-zinc-800 font-normal tabular-nums text-zinc-300`}>{done.length} selesai</span>
        </p>
      </div>

      <nav aria-label="Jenis masukan" class="mt-6 flex flex-wrap gap-2">
        <a href="/admin/masukan" aria-current={filter ? undefined : "page"} class={`${pill} ${filter ? "bg-zinc-900 text-zinc-300 hover:bg-zinc-800" : "bg-noir text-on-noir"}`}>Semua</a>
        {MASUKAN.map((m) => (
          <a href={`/admin/masukan?jenis=${m.id}`} aria-current={filter === m.id ? "page" : undefined} class={`${pill} ${filter === m.id ? "bg-noir text-on-noir" : "bg-zinc-900 text-zinc-300 hover:bg-zinc-800"}`}>
            {m.label}{count(m.id) > 0 && <span class="tabular-nums opacity-70">{count(m.id)}</span>}
          </a>
        ))}
      </nav>

      {open.length === 0 ? (
        <EmptyState title="Belum ada masukan baru" class="mt-8 justify-center rounded-[18px] bg-zinc-900 px-6 py-10 shadow-soft">Masukan yang masuk dari halaman Masukan dan saran muncul di sini.</EmptyState>
      ) : (
        <ul class="mt-6 grid gap-3">
          {open.map((r) => {
            const Icon = ICON[r.category];
            return (
              <li class="flex gap-4 rounded-[18px] bg-zinc-900 p-4 shadow-soft sm:p-5">
                <span aria-hidden class={`hidden size-11 shrink-0 place-items-center rounded-xl text-zinc-50 sm:grid ${TONE[r.category]}`}><Icon className="size-5" /></span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class={`inline-flex min-h-7 items-center rounded-full px-3 text-xs font-semibold text-zinc-50 ${TONE[r.category]}`}>{label[r.category]}</span>
                    <time datetime={r.created_at} tabindex="0" data-tip={when.format(new Date(r.created_at))} class="text-xs text-zinc-500">{ago(r.created_at)}</time>
                  </div>
                  <blockquote class="mt-3 rounded-xl bg-zinc-800 px-4 py-3 text-sm whitespace-pre-line text-zinc-50">{r.message}</blockquote>
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xs text-zinc-500">Dari {names.get(r.user_id) ?? "(akun dihapus)"}{r.page && <> di <a href={r.page} class="font-mono text-accent hover:underline">{r.page}</a></>}</p>
                    <ActionForm client:load action="selesaikanMasukan" className="flex">
                      <input type="hidden" name="id" value={r.id} />
                      <button class={`${smallButton} bg-tile-mint! text-zinc-50!`}>Tandai selesai</button>
                    </ActionForm>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )}

      {done.length > 0 && (
        <details class="mt-8">
          <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50"><MessageSquareText aria-hidden className="size-4" />Sudah selesai ({done.length})</summary>
          <ul class="mt-2 divide-y divide-zinc-800 rounded-[18px] bg-zinc-900 px-5 shadow-soft">
            {done.map((r) => (
              <li class="py-3 text-sm">
                <p class="text-zinc-300">{label[r.category]} · {names.get(r.user_id) ?? "(akun dihapus)"}</p>
                <p class="mt-0.5 line-clamp-2 text-xs text-zinc-500">{r.message}</p>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </AppShell>
</Base>
