---
import { Plus } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import StatusBadge from "@/components/admin/StatusBadge";
import { field, primaryButton } from "@/components/admin/editor";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../../components/AppShell.astro";
import Base from "../../../layouts/Base.astro";
import { adminOnly } from "../../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

const { data: tracks } = await (await createClient())
  .from("tracks")
  .select("slug, title, status, track_nodes(count)")
  .order("created_at");
---

<Base title="Roadmap" description="Susun track dari topik yang sudah terbit, atur prasyaratnya, lalu terbitkan." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Roadmap</h1>
      {!tracks?.length ? (
        <p class="mt-6 text-zinc-400">Belum ada track. Buat yang pertama di bawah.</p>
      ) : (
        <ul class="mt-6 divide-y divide-zinc-800 rounded-[28px] bg-zinc-900 px-5 shadow-soft">
          {tracks.map((t) => (
            <li>
              <a href={`/admin/roadmap/${t.slug}`} class="group flex min-h-16 items-center gap-4 py-3 focus-visible:outline-2 focus-visible:outline-accent">
                <span class="min-w-0 flex-1">
                  <span class="block font-medium group-hover:text-accent">{t.title}</span>
                  <span class="font-mono text-xs text-zinc-500">{t.slug}</span>
                </span>
                <span class="text-sm text-zinc-400 tabular-nums">{t.track_nodes[0]?.count ?? 0} topik</span>
                <StatusBadge status={t.status} />
              </a>
            </li>
          ))}
        </ul>
      )}

      <h2 class="mt-12 text-xl font-bold tracking-tight">Track baru</h2>
      <ActionForm client:load action="buatTrack" className="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="text-sm text-zinc-400">
          Judul
          <input name="title" required class={`${field} mt-1`} placeholder="Frontend Dasar" />
        </label>
        <label class="text-sm text-zinc-400">
          Slug
          <input name="slug" required pattern="[a-z0-9\-]+" class={`${field} mt-1 font-mono`} placeholder="frontend-dasar" />
        </label>
        <label class="text-sm text-zinc-400 sm:col-span-2">
          Deskripsi
          <textarea name="description" rows={2} class={`${field} mt-1`} />
        </label>
        <button class={`${primaryButton} sm:col-span-2 sm:justify-self-end`}><Plus aria-hidden className="size-4" />Buat track</button>
      </ActionForm>
    </div>
  </AppShell>
</Base>
