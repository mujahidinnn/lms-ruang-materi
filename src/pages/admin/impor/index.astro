---
import ImporForm from "@/components/admin/ImporForm";
import JobList, { type Job } from "@/components/admin/JobList";
import MigrasiList from "@/components/admin/MigrasiList";
import { enabledModels } from "@/lib/llm";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../../components/AppShell.astro";
import Base from "../../../layouts/Base.astro";
import { adminOnly } from "../../../lib/guard";
import { CircleCheck, Gauge, TriangleAlert } from "lucide-react";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

const supabase = await createClient();
const [{ data: jobs }, { data: topics }] = await Promise.all([
  supabase.from("import_jobs").select("*").order("created_at", { ascending: false }).limit(20),
  supabase.from("topics").select("slug"),
]);
const { data: done } = await supabase.from("import_jobs").select("slug").eq("status", "done");
const drafted = new Set((done ?? []).map((j) => j.slug));
const models = enabledModels();
const { data: ov } = await supabase.rpc("admin_overview");
const imp = ((ov as { imports?: { today: number; failed7: number; running: number } } | null)?.imports) ?? { today: 0, failed7: 0, running: 0 };
const steps = ["Unggah deck .pptx", "Slide dirender dan draf disusun", "Kamu tinjau, lalu terbitkan"];
---

<Base title="Impor materi" description="Unggah deck .pptx dan pantau proses impor." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto flex max-w-5xl flex-col gap-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Impor materi</h1>
        <p class="mt-2 text-zinc-400">Unggah deck. Slide dirender dan draf disusun otomatis, lalu kamu tinjau sebelum terbit.</p>
      </div>
      {models.length === 0 ? (
        <p class="text-sm text-red-500">Belum ada model aktif. Isi LLM_PROVIDERS di env server.</p>
      ) : (
        <>
          <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            <ImporForm client:load models={models} />
            <aside aria-label="Status impor" class="grid gap-3">
              <div class="rounded-[28px] bg-zinc-900 p-5 shadow-soft">
                <p class="flex items-center gap-2 text-sm text-zinc-400"><Gauge aria-hidden className="size-4" />Kuota otomatis, 24 jam</p>
                <p class="mt-1 text-3xl font-bold tabular-nums">{imp.today} <span class="text-sm font-normal text-zinc-500">dari 10</span></p>
                <div aria-hidden class="mt-3 h-2 overflow-hidden rounded-full bg-zinc-800"><div class="h-full rounded-full bg-brand" style={`width:${Math.min(100, imp.today * 10)}%`}></div></div>
                <p class="mt-2 text-xs text-zinc-500">Impor tulis tangan (claude:manual) tidak dihitung.</p>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-[24px] bg-zinc-900 p-4 shadow-soft"><p class="flex items-center gap-1.5 text-xs text-zinc-400"><CircleCheck aria-hidden className="size-3.5" />Berjalan</p><p class="mt-1 text-2xl font-bold tabular-nums">{imp.running}</p></div>
                <div class="rounded-[24px] bg-zinc-900 p-4 shadow-soft"><p class="flex items-center gap-1.5 text-xs text-zinc-400"><TriangleAlert aria-hidden className="size-3.5" />Gagal, 7 hari</p><p class={`mt-1 text-2xl font-bold tabular-nums ${imp.failed7 ? "text-accent-warm" : ""}`}>{imp.failed7}</p></div>
              </div>
              <ol class="rounded-[28px] bg-zinc-900 p-5 text-sm shadow-soft">
                {steps.map((t, i) => (
                  <li class="flex items-start gap-3 py-1.5">
                    <span aria-hidden class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-zinc-800 text-xs font-bold tabular-nums">{i + 1}</span>
                    <span class="text-zinc-300">{t}</span>
                  </li>
                ))}
              </ol>
            </aside>
          </div>
          <JobList client:load initial={(jobs ?? []) as Job[]} models={models} />
          <MigrasiList client:load slugs={(topics ?? []).map((t) => t.slug).filter((s) => !drafted.has(s))} models={models} />
        </>
      )}
    </div>
  </AppShell>
</Base>
