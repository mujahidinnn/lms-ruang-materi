---
import EmptyState from "../../components/EmptyState.astro";
import { Award, BookOpen, ClipboardCheck, FileSearch, FileUp, Megaphone, TriangleAlert, UserPlus, Users } from "lucide-react";
import { primaryButton, secondaryButton } from "@/components/ui/styles";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Overview = {
  users: { total: number; admins: number; active7: number; new7: number };
  topics: { published: number; draft: number; waiting: number };
  chapters: number;
  exercises: number;
  exams: { attempts: number; attempts7: number; passed: number; avg_score: number | null };
  certificates: number;
  imports: { today: number; failed7: number; running: number };
  signups: { id: string; email: string; created_at: string }[];
  popular: { slug: string; title: string; learners: number }[];
  activity: { day: string; n: number }[];
};

type Referrals = {
  total: number;
  top: { id: string; name: string; n: number }[];
  recent: { id: string; name: string; by_id: string; by: string; at: string }[];
};

const db = await createClient();
const [{ data }, { data: refData }, { data: waiting }] = await Promise.all([
  db.rpc("admin_overview"),
  db.rpc("admin_referral_summary"),
  db.from("topics").select("slug, title").not("draft_summary", "is", null).order("title"),
]);
const o = (data ?? null) as Overview | null;
const ref = (refData ?? { total: 0, top: [], recent: [] }) as Referrals;
if (!o) return Astro.rewrite("/404");

const drafts = waiting ?? [];
const peak = Math.max(1, ...o.activity.map((a) => a.n));
const topLearners = Math.max(1, ...o.popular.map((p) => p.learners));
const dayName = new Intl.DateTimeFormat("id-ID", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });
const today = new Intl.DateTimeFormat("id-ID", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Jakarta" }).format(new Date());
const joined = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });

const alerts = [
  drafts.length > 0 && { text: `${drafts.length} draf menunggu tinjauan`, href: `/admin/topik/${drafts[0].slug}`, action: "Tinjau" },
  o.imports.failed7 > 0 && { text: `${o.imports.failed7} impor gagal dalam 7 hari`, href: "/admin/impor", action: "Lihat" },
  o.imports.running > 0 && { text: `${o.imports.running} impor sedang berjalan`, href: "/admin/impor", action: "Pantau" },
].filter(Boolean) as { text: string; href: string; action: string }[];

const stats = [
  { label: "Pengguna", value: o.users.total, note: `${o.users.active7} aktif 7 hari, ${o.users.new7} baru`, href: "/admin/pengguna", Icon: Users, tone: "bg-tile-mint" },
  { label: "Kelas terbit", value: o.topics.published, note: `${o.topics.draft} masih draf`, href: "/admin/topik", Icon: BookOpen, tone: "bg-tile-lavender" },
  { label: "Ujian dikerjakan", value: o.exams.attempts, note: o.exams.attempts ? `rata-rata ${o.exams.avg_score ?? 0}, ${o.exams.passed} lulus` : "belum ada", href: "/admin/ujian", Icon: ClipboardCheck, tone: "bg-tile-sky" },
  { label: "Sertifikat", value: o.certificates, note: `${o.chapters} bab, ${o.exercises} latihan kode`, href: "/admin/topik", Icon: Award, tone: "bg-tile-peach" },
];
const card = "rounded-[18px] bg-zinc-900 shadow-soft";
---

<Base title="Ringkasan" description="Kondisi Ruang Materi: pengguna, kelas, ujian, aktivitas belajar dan impor." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto flex max-w-6xl flex-col gap-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Ringkasan</h1>
          <p class="mt-1 text-sm text-zinc-400">{today}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin/pengumuman" class={secondaryButton}><Megaphone aria-hidden className="size-4" />Kirim pengumuman</a>
          <a href="/admin/impor" class={`${primaryButton} min-h-11 px-5 text-sm`}><FileUp aria-hidden className="size-4" />Impor deck</a>
        </div>
      </div>

      {alerts.length > 0 && (
        <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3" aria-label="Perlu perhatian">
          {alerts.map((a) => (
            <li>
              <a href={a.href} class="flex min-h-14 items-center gap-3 rounded-xl bg-tile-butter px-4 text-sm font-medium ring-1 ring-zinc-800 hover:ring-accent focus-visible:outline-2 focus-visible:outline-accent">
                <TriangleAlert aria-hidden className="size-4 shrink-0" />
                <span class="flex-1">{a.text}</span>
                <span class="text-xs underline underline-offset-2">{a.action}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {stats.map(({ label, value, note, href, Icon, tone }) => (
          <a href={href} class={`${card} group flex flex-col gap-3 p-4 hover:ring-2 hover:ring-accent/40 focus-visible:outline-2 focus-visible:outline-accent sm:p-5`}>
            <span aria-hidden class={`grid size-10 place-items-center rounded-xl ${tone}`}><Icon className="size-5" /></span>
            <div>
              <dt class="text-sm text-zinc-400">{label}</dt>
              <dd class="text-3xl font-bold tabular-nums">{value}</dd>
              <p class="mt-0.5 text-xs text-zinc-500">{note}</p>
            </div>
          </a>
        ))}
      </dl>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <section aria-labelledby="aktivitas" class={`${card} p-5 sm:p-6`}>
          <div class="flex items-baseline justify-between gap-3">
            <h2 id="aktivitas" class="text-lg font-bold tracking-tight">Aktivitas belajar</h2>
            <p class="text-xs text-zinc-500">murid aktif per hari, 14 hari</p>
          </div>
          <ol class="mt-5 flex h-40 items-end gap-1.5" aria-label="Murid aktif per hari">
            {o.activity.map((a, i) => (
              <li class="flex h-full min-w-0 flex-1 flex-col justify-end" tabindex="0" data-tip={`${dayName.format(new Date(a.day))}: ${a.n} murid`}>
                <span class="mb-1 text-center text-[10px] tabular-nums text-zinc-500">{a.n || ""}</span>
                <span class={`block w-full rounded-t-lg ${i === o.activity.length - 1 ? "bg-primary" : "bg-brand/70"} ${a.n ? "" : "bg-zinc-800"}`} style={`height:${a.n ? Math.max(10, (a.n / peak) * 100) : 4}%`}></span>
              </li>
            ))}
          </ol>
          <div class="mt-2 flex justify-between text-[11px] text-zinc-500">
            <span>{dayName.format(new Date(o.activity[0].day))}</span><span>hari ini</span>
          </div>
        </section>

        <section aria-labelledby="populer" class={`${card} p-5 sm:p-6`}>
          <h2 id="populer" class="text-lg font-bold tracking-tight">Kelas paling banyak dibuka</h2>
          {o.popular.length === 0 ? (
            <EmptyState small title="Belum ada murid" class="mt-4">Belum ada murid yang membuka kelas.</EmptyState>
          ) : (
            <ol class="mt-4 grid gap-3">
              {o.popular.map((p) => (
                <li>
                  <a href={`/admin/topik/${p.slug}`} class="group block focus-visible:outline-2 focus-visible:outline-accent">
                    <p class="flex justify-between gap-3 text-sm"><span class="truncate group-hover:text-accent">{p.title}</span><span class="shrink-0 tabular-nums text-zinc-400">{p.learners} murid</span></p>
                    <div aria-hidden class="mt-1.5 h-2 overflow-hidden rounded-full bg-zinc-800"><div class="h-full rounded-full bg-brand" style={`width:${(p.learners / topLearners) * 100}%`}></div></div>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      </div>

      <section aria-labelledby="ajakan" class={`${card} p-5 sm:p-6`}>
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="ajakan" class="inline-flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight"><UserPlus aria-hidden className="size-5" />Ajakan teman</h2>
          <p class="text-sm text-zinc-400"><span class="text-xl font-bold tabular-nums text-zinc-50">{ref.total}</span> akun daftar lewat ajakan</p>
        </div>
        {ref.total === 0 ? (
          <EmptyState small title="Belum ada ajakan" class="mt-3">Belum ada yang mendaftar lewat link ajakan. Murid membagikan linknya dari halaman Profil.</EmptyState>
        ) : (
          <div class="mt-4 grid gap-6 lg:grid-cols-2">
            <div>
              <h3 class="text-sm font-semibold text-zinc-300">Paling banyak mengajak</h3>
              <ol class="mt-2 divide-y divide-zinc-800">
                {ref.top.map((t) => (
                  <li>
                    <a href={`/admin/pengguna/${t.id}`} class="flex min-h-11 items-center justify-between gap-3 text-sm hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                      <span class="truncate">{t.name}</span>
                      <span class="shrink-0 tabular-nums text-zinc-400">{t.n} orang</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-zinc-300">Ajakan terbaru</h3>
              <ul class="mt-2 divide-y divide-zinc-800">
                {ref.recent.map((r) => (
                  <li class="flex min-h-11 items-center justify-between gap-3 text-sm">
                    <span class="min-w-0 truncate"><a href={`/admin/pengguna/${r.id}`} class="font-medium hover:text-accent">{r.name}</a> <span class="text-zinc-500">diajak</span> <a href={`/admin/pengguna/${r.by_id}`} class="hover:text-accent">{r.by}</a></span>
                    <time datetime={r.at} class="shrink-0 text-xs text-zinc-500">{joined.format(new Date(r.at))}</time>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </section>

      <div class="grid gap-6 lg:grid-cols-2">
        <section aria-labelledby="daftar" class={`${card} p-5 sm:p-6`}>
          <div class="flex items-baseline justify-between gap-3">
            <h2 id="daftar" class="text-lg font-bold tracking-tight">Pendaftar terbaru</h2>
            <a href="/admin/pengguna" class="text-sm text-accent hover:underline">Semua</a>
          </div>
          <ul class="mt-3 divide-y divide-zinc-800">
            {o.signups.map((s) => (
              <li>
                <a href={`/admin/pengguna/${s.id}`} class="flex min-h-12 items-center justify-between gap-3 text-sm hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                  <span class="truncate">{s.email}</span>
                  <time datetime={s.created_at} class="shrink-0 text-xs text-zinc-500">{joined.format(new Date(s.created_at))}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="impor" class={`${card} p-5 sm:p-6`}>
          <div class="flex items-baseline justify-between gap-3">
            <h2 id="impor" class="text-lg font-bold tracking-tight">Impor</h2>
            <a href="/admin/impor" class="text-sm text-accent hover:underline">Buka</a>
          </div>
          <p class="mt-3 text-sm text-zinc-400">Impor otomatis 24 jam terakhir</p>
          <p class="text-2xl font-bold tabular-nums">{o.imports.today} <span class="text-sm font-normal text-zinc-500">dari 10</span></p>
          <div aria-hidden class="mt-2 h-2 overflow-hidden rounded-full bg-zinc-800"><div class="h-full rounded-full bg-brand" style={`width:${Math.min(100, o.imports.today * 10)}%`}></div></div>
          {drafts.length > 0 ? (
            <ul class="mt-4 divide-y divide-zinc-800">
              {drafts.slice(0, 4).map((t) => (
                <li>
                  <a href={`/admin/topik/${t.slug}`} class="flex min-h-11 items-center justify-between gap-3 text-sm hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                    <span class="truncate">{t.title}</span>
                    <span class="inline-flex shrink-0 items-center gap-1 text-xs text-zinc-500"><FileSearch aria-hidden className="size-3.5" />Tinjau</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm text-zinc-400">Semua draf sudah ditinjau.</p>
          )}
        </section>
      </div>
    </div>
  </AppShell>
</Base>
