---
import { FileSearch, FileUp } from "lucide-react";
import ProgressStat from "@/components/admin/ProgressStat";
import { primaryButton } from "@/components/admin/editor";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

// Same window as the 10-a-day limit in check_import_limits().
const oneDayAgo = new Date(Date.now() - 864e5).toISOString();
const db = await createClient();
const [topics, waiting, today] = await Promise.all([
  db.from("topics").select("status"),
  db.from("topics").select("slug, title").not("draft_summary", "is", null).order("title"),
  db.from("import_jobs").select("id", { count: "exact", head: true }).gte("created_at", oneDayAgo),
]);
const all = topics.data ?? [];
const published = all.filter((t) => t.status === "published").length;
const [next, ...rest] = waiting.data ?? [];
---

<Base title="Admin" description="Kelola materi Ruang Materi." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-col gap-8">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Ringkasan</h1>

        <section aria-labelledby="fokus" class="rounded-[28px] bg-tile-lavender p-6 sm:p-8">
          {next ? (
            <>
              <p class="text-sm text-accent">{rest.length + 1} draf menunggu tinjauan</p>
              <h2 id="fokus" class="mt-2 text-2xl font-bold tracking-tight">{next.title}</h2>
              <p class="mt-1 max-w-prose text-zinc-400">Periksa ringkasan, tips dan soal dari model, lalu terbitkan.</p>
              <a href={`/admin/topik/${next.slug}`} class={`${primaryButton} mt-6`}><FileSearch aria-hidden className="size-4" />Tinjau draf</a>
            </>
          ) : (
            <>
              <h2 id="fokus" class="text-2xl font-bold tracking-tight">Semua draf sudah ditinjau</h2>
              <p class="mt-1 max-w-prose text-zinc-400">Impor deck baru untuk menambah materi.</p>
              <a href="/admin/impor" class={`${primaryButton} mt-6`}><FileUp aria-hidden className="size-4" />Impor deck</a>
            </>
          )}
        </section>

        <div class="grid gap-4 sm:grid-cols-2">
          <ProgressStat label="Topik terbit" value={published} max={all.length} />
          <ProgressStat label="Impor 24 jam terakhir" value={today.count ?? 0} max={10} />
        </div>

        {rest.length > 0 && (
          <section aria-labelledby="antrean">
            <h2 id="antrean" class="text-xl font-bold tracking-tight">Draf lain</h2>
            <ul class="mt-3 divide-y divide-zinc-800 rounded-[28px] bg-zinc-900 px-5 shadow-soft">
              {rest.map((t) => (
                <li>
                  <a href={`/admin/topik/${t.slug}`} class="flex min-h-12 items-center justify-between gap-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent">
                    {t.title}
                    <span class="text-sm text-zinc-500">Tinjau</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </AppShell>
</Base>
