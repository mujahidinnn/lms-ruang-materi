---
import { Globe, Monitor, Server, CircleCheck } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { smallButton } from "@/components/admin/editor";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import EmptyState from "../../components/EmptyState.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = { id: number; source: "server" | "rpc" | "client"; path: string; message: string; stack: string; count: number; first_at: string; last_at: string; resolved_at: string | null };
const SOURCE = {
  server: { label: "Halaman", Icon: Server, tone: "bg-tile-pink" },
  rpc: { label: "Aksi server", Icon: Globe, tone: "bg-tile-butter" },
  client: { label: "Browser", Icon: Monitor, tone: "bg-tile-lavender" },
};

const { data } = await (await createClient()).from("error_log").select("id, source, path, message, stack, count, first_at, last_at, resolved_at").order("last_at", { ascending: false }).limit(200);
const all = (data ?? []) as Row[];
const open = all.filter((r) => !r.resolved_at);
const done = all.filter((r) => r.resolved_at);
const ago = (iso: string) => {
  const m = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  return m < 60 ? `${m} menit lalu` : m < 1440 ? `${Math.round(m / 60)} jam lalu` : `${Math.round(m / 1440)} hari lalu`;
};
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
const pill = "inline-flex min-h-10 items-center gap-2 rounded-full px-4 text-sm font-semibold";
---

<Base title="Error" description="Error dari server dan browser pengguna." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Error</h1>
          <p class="mt-2 text-sm text-zinc-400">Error yang sama dikelompokkan jadi satu baris. Error baru dikirim ke email approver, paling banyak sekali per jam.</p>
        </div>
        <p class="flex gap-2 text-sm">
          <span class={`${pill} tabular-nums text-zinc-50 ${open.length ? "bg-tile-pink" : "bg-tile-mint"}`}>{open.length} terbuka</span>
          <span class={`${pill} bg-zinc-800 font-normal tabular-nums text-zinc-300`}>{done.length} beres</span>
        </p>
      </div>

      {open.length === 0 ? (
        <EmptyState art="beres" title="Tidak ada error terbuka" class="mt-8 justify-center rounded-2xl bg-zinc-900 px-6 py-10 shadow-soft">Error dari halaman, aksi server, dan browser pengguna muncul di sini.</EmptyState>
      ) : (
        <ul class="mt-6 grid gap-3">
          {open.map((r) => {
            const s = SOURCE[r.source];
            return (
              <li class="flex gap-4 rounded-2xl bg-zinc-900 p-4 shadow-soft sm:p-5">
                <span aria-hidden class={`hidden size-11 shrink-0 place-items-center rounded-xl text-zinc-50 sm:grid ${s.tone}`}><s.Icon className="size-5" /></span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class={`inline-flex min-h-7 items-center rounded-full px-3 text-xs font-semibold text-zinc-50 ${s.tone}`}>{s.label}</span>
                    <span class="text-xs font-semibold tabular-nums text-zinc-50">{r.count}x</span>
                    <time datetime={r.last_at} tabindex="0" data-tip={`Pertama ${when.format(new Date(r.first_at))}, terakhir ${when.format(new Date(r.last_at))}`} class="text-xs text-zinc-500">terakhir {ago(r.last_at)}</time>
                  </div>
                  <p class="mt-3 font-mono text-sm break-words text-zinc-50">{r.message}</p>
                  {r.stack && (
                    <details class="mt-2">
                      <summary class="cursor-pointer text-xs text-zinc-400 hover:text-zinc-50">Stack trace</summary>
                      <pre class="mt-2 max-h-72 overflow-auto rounded-xl bg-zinc-800 p-3 text-xs text-zinc-300">{r.stack}</pre>
                    </details>
                  )}
                  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xs text-zinc-500">Di <a href={r.path.startsWith("/rpc/") ? undefined : r.path} class="font-mono text-accent hover:underline">{r.path || "/"}</a></p>
                    <ActionForm client:load action="selesaikanError" className="flex">
                      <input type="hidden" name="id" value={r.id} />
                      <button class={`${smallButton} bg-tile-mint! text-zinc-50!`}>Tandai beres</button>
                    </ActionForm>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )}

      {done.length > 0 && (
        <details class="mt-8">
          <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50"><CircleCheck aria-hidden className="size-4" />Sudah beres ({done.length})</summary>
          <ul class="mt-2 divide-y divide-zinc-800 rounded-2xl bg-zinc-900 px-5 shadow-soft">
            {done.map((r) => (
              <li class="py-3 text-sm">
                <p class="text-zinc-300">{SOURCE[r.source].label} di <span class="font-mono">{r.path || "/"}</span>, {r.count}x</p>
                <p class="mt-0.5 line-clamp-2 font-mono text-xs text-zinc-500">{r.message}</p>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </AppShell>
</Base>
