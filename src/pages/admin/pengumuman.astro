---
import { Globe, Mail, Trash2 } from "lucide-react";
import PengumumanForm from "@/components/admin/PengumumanForm";
import { dangerButton } from "@/components/admin/editor";
import { chip } from "@/components/ui/styles";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;

type Row = {
  id: string; title: string; body: string; audience: "all" | "student" | "admin" | "users"; user_ids: string[];
  on_web: boolean; on_email: boolean; email_sent: number; email_failed: number; created_at: string;
};
const { data } = await (await createClient())
  .from("announcements")
  .select("id, title, body, audience, user_ids, on_web, on_email, email_sent, email_failed, created_at")
  .order("created_at", { ascending: false })
  .limit(30);
const items = (data ?? []) as Row[];
const { data: all } = await (await createClient()).rpc("admin_users");
const people = ((all ?? []) as { user_id: string; email: string; display_name: string | null; confirmed: boolean }[])
  .filter((u) => u.confirmed)
  .map((u) => ({ id: u.user_id, name: u.display_name || u.email.split("@")[0], email: u.email }))
  .sort((a, b) => a.name.localeCompare(b.name));
const who = (a: Row) => ({ all: "Semua", student: "Siswa", admin: "Admin", users: `${a.user_ids.length} pengguna` })[a.audience];
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
---

<Base title="Pengumuman" description="Kirim pengumuman ke Dashboard murid dan ke email." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Pengumuman</h1>
      <p class="mt-2 text-sm text-zinc-400">Tampil sebagai kartu di Dashboard murid, dikirim ke email, atau keduanya.</p>

      <div class="mt-6"><PengumumanForm client:load people={people} /></div>

      <h2 class="mt-10 text-xl font-bold tracking-tight">Riwayat</h2>
      {!items.length ? (
        <p class="mt-3 rounded-[28px] bg-zinc-900 p-8 text-center text-zinc-400 shadow-soft">Belum ada pengumuman.</p>
      ) : (
        <ul class="mt-3 divide-y divide-zinc-800 rounded-[28px] bg-zinc-900 px-5 shadow-soft">
          {items.map((a) => (
            <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 py-4">
              <div class="min-w-0 flex-1 basis-64">
                <p class="font-medium">{a.title}</p>
                <p class="mt-0.5 line-clamp-2 text-sm text-zinc-400">{a.body}</p>
                <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500">
                  <time datetime={a.created_at}>{when.format(new Date(a.created_at))}</time>
                  <span class={`${chip} min-h-6 bg-zinc-800 px-2`}>{who(a)}</span>
                  {a.on_web && <span class="inline-flex items-center gap-1"><Globe aria-hidden className="size-3.5" />Website</span>}
                  {a.on_email && (
                    <span class="inline-flex items-center gap-1">
                      <Mail aria-hidden className="size-3.5" />{a.email_sent} terkirim{a.email_failed > 0 && <span class="text-red-500">, {a.email_failed} gagal</span>}
                    </span>
                  )}
                </p>
              </div>
              <form method="post" action="/rpc/hapusPengumuman" data-confirm={`Hapus "${a.title}"?`} data-confirm-text="Kartu di Dashboard hilang. Email yang sudah terkirim tidak bisa ditarik." data-confirm-action="Hapus" data-confirm-danger>
                <input type="hidden" name="id" value={a.id} />
                <button class={dangerButton}><Trash2 aria-hidden className="size-4" />Hapus</button>
              </form>
            </li>
          ))}
        </ul>
      )}
    </div>
  </AppShell>
</Base>
