---
import EmptyState from "../../components/EmptyState.astro";
import { Clock, ShieldCheck } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { smallButton } from "@/components/admin/editor";
import { APPROVER } from "@/lib/dal";
import { createClient } from "@/lib/supabase/server";
import AppShell from "../../components/AppShell.astro";
import Base from "../../layouts/Base.astro";
import { adminOnly } from "../../lib/guard";

const user = await adminOnly(Astro);
if (user instanceof Response) return user;
const isApprover = user.email === APPROVER;

type Row = { id: number; action: string; args: unknown[]; requested_email: string; status: string; note: string; created_at: string };
const { data } = await (await createClient())
  .from("admin_approvals")
  .select("id, action, args, requested_email, status, note, created_at")
  .order("created_at", { ascending: false })
  .limit(200);
const rows = (data ?? []) as Row[];
const open = rows.filter((r) => r.status === "pending");
const done = rows.filter((r) => r.status !== "pending");

// What the admin sent, as "field: value" lines (form fields or plain values).
const fields = (args: unknown[]) =>
  args
    .flatMap((a) => (a && typeof a === "object" && "$form" in a ? (a as { $form: [string, string][] }).$form : a == null || (typeof a === "object" && !Object.keys(a).length) ? [] : [["nilai", typeof a === "string" ? a : JSON.stringify(a)]]))
    .filter(([k]) => !k.startsWith("$ACTION"))
    .map(([k, v]) => `${k}: ${v.length > 160 ? v.slice(0, 160) + "…" : v}`);
const when = new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
const STATUS: Record<string, [string, string]> = { approved: ["Disetujui", "bg-tile-mint"], rejected: ["Ditolak", "bg-tile-pink"], failed: ["Gagal", "bg-tile-butter"] };
const pill = "inline-flex min-h-10 items-center gap-2 rounded-full px-4 text-sm font-semibold";
---

<Base title="Persetujuan" description="Perubahan admin yang menunggu persetujuan." noindex>
  <AppShell set="admin" email={user.email}>
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Persetujuan</h1>
          <p class="mt-2 text-sm text-zinc-400">
            {isApprover ? "Perubahan dari admin lain baru dijalankan setelah kamu setujui." : "Perubahanmu dijalankan setelah disetujui admin utama."}
          </p>
        </div>
        <span class={`${pill} tabular-nums text-zinc-50 ${open.length ? "bg-tile-pink" : "bg-tile-mint"}`}>{open.length} menunggu</span>
      </div>

      {open.length === 0 ? (
        <EmptyState art="beres" title="Tidak ada yang menunggu" class="mt-8 justify-center rounded-2xl bg-zinc-900 px-6 py-10 shadow-soft">Perubahan dari admin lain yang perlu disetujui muncul di sini.</EmptyState>
      ) : (
        <ul class="mt-6 grid gap-3">
          {open.map((r) => (
            <li class="flex gap-4 rounded-2xl bg-zinc-900 p-4 shadow-soft sm:p-5">
              <span aria-hidden class="hidden size-11 shrink-0 place-items-center rounded-xl bg-tile-lavender text-zinc-50 sm:grid"><Clock className="size-5" /></span>
              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="font-mono text-sm font-semibold">{r.action}</span>
                  <span class="text-xs text-zinc-500">{r.requested_email} · {when.format(new Date(r.created_at))}</span>
                </p>
                <pre class="mt-3 max-h-48 overflow-auto rounded-xl bg-zinc-800 px-4 py-3 text-xs whitespace-pre-wrap text-zinc-300">{fields(r.args).join("\n") || "(tanpa isian)"}</pre>
                {isApprover && (
                  <div class="mt-3 flex flex-wrap items-start justify-end gap-2">
                    <ActionForm client:load action="tolakPerubahan" className="flex flex-wrap gap-2">
                      <input type="hidden" name="id" value={r.id} />
                      <input name="note" placeholder="Alasan (opsional)" maxlength="300" aria-label="Alasan menolak" class="min-h-10 rounded-full bg-zinc-800 px-4 text-sm" />
                      <button class={`${smallButton} bg-tile-pink! text-zinc-50!`}>Tolak</button>
                    </ActionForm>
                    <ActionForm client:load action="setujuiPerubahan" className="flex">
                      <input type="hidden" name="id" value={r.id} />
                      <button class={`${smallButton} bg-tile-mint! text-zinc-50!`}>Setujui</button>
                    </ActionForm>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}

      {done.length > 0 && (
        <details class="mt-8">
          <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm text-zinc-400 hover:text-zinc-50"><ShieldCheck aria-hidden className="size-4" />Sudah diputuskan ({done.length})</summary>
          <ul class="mt-2 divide-y divide-zinc-800 rounded-2xl bg-zinc-900 px-5 shadow-soft">
            {done.map((r) => (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-3 text-sm">
                <span class={`inline-flex min-h-7 items-center rounded-full px-3 text-xs font-semibold text-zinc-50 ${STATUS[r.status]?.[1] ?? "bg-zinc-800"}`}>{STATUS[r.status]?.[0] ?? r.status}</span>
                <span class="font-mono text-zinc-300">{r.action}</span>
                <span class="text-xs text-zinc-500">{r.requested_email}</span>
                {r.note && <span class="basis-full text-xs text-zinc-500">{r.note}</span>}
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </AppShell>
</Base>
