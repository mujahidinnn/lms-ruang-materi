---
import Select from "@/components/ui/Select";
import { Monitor, Smartphone, Trash2 } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { field } from "@/components/admin/editor";
import PasswordInput from "@/components/auth/PasswordInput";
import AjakTeman from "@/components/profil/AjakTeman";
import ExportButton from "@/components/dashboard/ExportButton";
import { card, primaryButton } from "@/components/ui/styles";
import { SITE_URL } from "@/lib/site";
import { createClient } from "@/lib/supabase/server";
import Recap, { type Recap as RecapData } from "../components/Recap.astro";
import SignOutButton from "../components/SignOutButton.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { signedIn } from "../lib/guard";

const INDONESIA = ["Asia/Jakarta", "Asia/Makassar", "Asia/Jayapura"];
const ZONES = [...INDONESIA, ...Intl.supportedValuesOf("timeZone").filter((z) => !INDONESIA.includes(z))];

const user = await signedIn(Astro);
if (user instanceof Response) return user;
const db = await createClient();
const [{ data: p }, { data: refRow }, { data: recap }, { data: st }, { data: certs }, { data: bdg }] = await Promise.all([
  db.from("profiles").select("display_name, timezone, guardian_consent, age_group, announce_email").eq("user_id", user.id).single(),
  db.rpc("my_referral").maybeSingle(),
  db.rpc("admin_user_recap", { target: user.id }),
  db.from("learning_streaks").select("current_days, best_days").eq("user_id", user.id).maybeSingle(),
  db.from("certificates").select("code, topics(title)").eq("user_id", user.id).order("issued_at"),
  db.from("badges").select("tracks(title)").eq("user_id", user.id),
]);
const wins = {
  certs: ((certs ?? []) as unknown as { code: string; topics: { title: string } | null }[]).map((c) => ({ code: c.code, title: c.topics?.title ?? "Kelas" })),
  badges: ((bdg ?? []) as unknown as { tracks: { title: string } | null }[]).flatMap((b) => (b.tracks ? [b.tracks.title] : [])),
};
const ref = refRow as { code: string; joined: number } | null;
const METODE: Record<string, string> = { email: "Email", google: "Google" };
const { data: ids } = await db.auth.getUserIdentities();
const methods = [...new Set((ids?.identities ?? []).map((i) => METODE[i.provider] ?? i.provider))];
const { data: sessions } = await db.rpc("my_sessions");
const WIN: Record<string, string> = { "10.0": "10/11", "6.3": "8.1", "6.1": "7" };
const perangkat = ((sessions ?? []) as { id: string; user_agent: string | null; ip: string | null; country: string | null; created_at: string; refreshed_at: string; current: boolean }[]).map((x) => {
  const ua = x.user_agent ?? "";
  const ver = (re: RegExp) => ua.match(re)?.[1]?.split(".")[0];
  const [b, bv] = /Edg\/(\d+)/.test(ua) ? ["Edge", ver(/Edg\/([\d.]+)/)] : /OPR\/(\d+)/.test(ua) ? ["Opera", ver(/OPR\/([\d.]+)/)] : /Firefox\/(\d+)/.test(ua) ? ["Firefox", ver(/Firefox\/([\d.]+)/)] : /(?:Chrome|CriOS)\/(\d+)/.test(ua) ? ["Chrome", ver(/(?:Chrome|CriOS)\/([\d.]+)/)] : /Safari\//.test(ua) ? ["Safari", ver(/Version\/([\d.]+)/)] : ["Browser", undefined];
  const os = /Android ([\d.]+)/.exec(ua) ? `Android ${ver(/Android ([\d.]+)/)}` : /iPhone|iPad/.test(ua) ? `iOS ${(ua.match(/OS (\d+)_/) ?? [])[1] ?? ""}`.trim() : /Windows NT ([\d.]+)/.exec(ua) ? `Windows ${WIN[ua.match(/Windows NT ([\d.]+)/)![1]] ?? ""}`.trim() : /Mac OS X/.test(ua) ? "macOS" : /CrOS/.test(ua) ? "ChromeOS" : /Linux/.test(ua) ? "Linux" : "";
  const model = ua.match(/Android [\d.]+; ([^;)]+)/)?.[1]?.replace(/ Build.*/, "");
  return { ...x, nama: `${b}${bv ? ` ${bv}` : ""}${os ? ` · ${os}` : ""}`, model: model && model !== "K" ? model : null, hp: /Android|iPhone|iPad|Mobile/.test(ua) };
});
const hasGoogle = (ids?.identities ?? []).some((i) => i.provider === "google");
const canLink = import.meta.env.PUBLIC_GOOGLE_AUTH === "1";
const here = perangkat.find((x) => x.current);
const others = perangkat.filter((x) => !x.current);
const negara = new Intl.DisplayNames(["id"], { type: "region" });
const tgl = (d: string) => new Date(d).toLocaleString("id-ID", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: p?.timezone ?? "Asia/Jakarta" });
const zone = p?.timezone ?? "Asia/Jakarta";
---

<Base title="Profil" description="Ubah nama dan zona waktu, unduh data belajarmu, atau hapus akun." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
    <div class="mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Profil</h1>
      <div role="tablist" aria-label="Bagian profil" class="mt-4 inline-flex rounded-full border-2 border-noir bg-zinc-900 p-1 text-sm font-bold">
        <button type="button" role="tab" id="tab-umum" aria-controls="panel-umum" aria-selected="true" class="min-h-10 cursor-pointer rounded-full px-5 aria-selected:bg-noir aria-selected:text-on-noir">Umum</button>
        <button type="button" role="tab" id="tab-rekap" aria-controls="panel-rekap" aria-selected="false" tabindex="-1" class="min-h-10 cursor-pointer rounded-full px-5 aria-selected:bg-noir aria-selected:text-on-noir">Rekap</button>
        <button type="button" role="tab" id="tab-akun" aria-controls="panel-akun" aria-selected="false" tabindex="-1" class="min-h-10 cursor-pointer rounded-full px-5 aria-selected:bg-noir aria-selected:text-on-noir">Akun</button>
      </div>
      <div id="panel-rekap" role="tabpanel" aria-labelledby="tab-rekap" hidden class="mt-4">
        {recap ? <Recap recap={recap as RecapData} streak={{ current: st?.current_days ?? 0, best: st?.best_days ?? 0 }} wins={wins} /> : <p class="rounded-[18px] bg-zinc-900 p-8 text-center text-zinc-400 shadow-soft">Rekap belum tersedia.</p>}
      </div>
      <div id="panel-umum" role="tabpanel" aria-labelledby="tab-umum">
      <div class="mt-4 grid items-start gap-4 sm:mt-6 sm:gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
      <div class="flex items-end gap-4 overflow-hidden rounded-[18px] bg-noir px-5 pt-5 text-on-noir lg:col-start-2 lg:row-start-1">
        <div class="min-w-0 pb-5">
          <p class="truncate text-2xl font-extrabold">{p?.display_name || "Tanpa nama"}</p>
          <p class="truncate text-sm text-on-noir/60">{user.email}</p>
          <a href="/nilai" class="mt-4 inline-flex min-h-10 items-center rounded-full bg-matcha-300 px-4 text-sm font-bold text-noir">Lihat pencapaian</a>
        </div>
        <div class="ml-auto flex h-28 w-20 shrink-0 sm:h-36 sm:w-24 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-3"><img src="/ilustrasi/kode.svg" alt="" width="890" height="1220" class="h-full w-auto -scale-x-100" /></div>
      </div>
      <dl class="grid grid-cols-3 gap-3 lg:col-start-2 lg:row-start-2">
        {[
          { label: "Streak", value: st?.current_days ?? 0, unit: "hari", tone: "bg-tile-mint" },
          { label: "Sertifikat", value: wins.certs.length, unit: "kelas", tone: "bg-tile-peach" },
          { label: "Badge", value: wins.badges.length, unit: "roadmap", tone: "bg-tile-butter" },
        ].map((t) => (
          <div class={`rounded-[18px] p-4 ${t.tone}`}>
            <dt class="text-xs text-zinc-300">{t.label}</dt>
            <dd class="mt-1 text-3xl font-extrabold tabular-nums text-zinc-50">{t.value}</dd>
            <p class="text-xs text-zinc-300">{t.unit}</p>
          </div>
        ))}
      </dl>

      <section aria-labelledby="data" class={`p-5 sm:p-8 lg:col-start-1 lg:row-span-3 lg:row-start-1 ${card}`}>
        <h2 id="data" class="text-xl font-bold tracking-tight">Data diri</h2>
        <p class="mt-1 text-sm text-zinc-400">{user.email}</p>
        <ActionForm client:load action="simpanProfil" className="mt-4 grid gap-4" data-confirm="Cabut persetujuan?" data-confirm-text="Progres bab, kuis, dan latihan kode berhenti tersimpan sampai kamu memilih usia lagi." data-confirm-action="Cabut" data-confirm-if="usia=" data-confirm-danger>
          <label class="text-sm text-zinc-400">
            Nama tampilan
            <input name="display_name" maxlength={80} value={p?.display_name ?? ""} class={`${field} mt-1`} />
          </label>
          <label class="text-sm text-zinc-400">
            Zona waktu, untuk menghitung streak harian
            <Select client:load name="timezone" label="Zona waktu" value={zone} options={ZONES.map((z) => [z, z] as [string, string])} className="mt-1" />
          </label>
          <label class="flex min-h-11 items-center gap-3 text-sm text-zinc-300">
            <input type="checkbox" name="announce_email" checked={p?.announce_email ?? true} class="size-4 accent-[var(--color-brand)]" />
            Kirimi aku email pengumuman dari Ruang Materi
          </label>
          <fieldset class="grid gap-2 text-sm text-zinc-300">
            <legend class="mb-1 text-zinc-400">Usia dan persetujuan</legend>
            {[
              { value: "dewasa", label: "18 tahun ke atas, setuju dengan Kebijakan Privasi" },
              { value: "anak", label: "Di bawah 18 tahun, orang tua atau wali sudah mengizinkan" },
              { value: "", label: "Cabut persetujuan (progres berhenti tersimpan)" },
            ].map((c) => (
              <label class="flex min-h-11 items-start gap-3">
                <input type="radio" name="usia" value={c.value} checked={p?.guardian_consent ? (p?.age_group ?? "dewasa") === c.value : c.value === ""} class="mt-0.5 size-4 accent-(--accent)" />
                {c.label}
              </label>
            ))}
          </fieldset>
          <button class={`${primaryButton} justify-self-start`}>Simpan</button>
        </ActionForm>
      </section>

      {ref && (
        <section aria-labelledby="ajak" class={`p-5 sm:p-8 lg:col-start-2 lg:row-start-3 ${card}`}>
          <h2 id="ajak" class="text-xl font-bold tracking-tight">Ajak teman</h2>
          <p class="mt-1 text-sm text-zinc-400">
            Bagikan link ini. Temanmu mendaftar lewat link itu dan tercatat sebagai ajakanmu. Tidak ada email yang dikirim.
          </p>
          <AjakTeman client:load code={ref.code} joined={ref.joined} origin={SITE_URL} />
        </section>
      )}

      </div>
      </div>
      <div id="panel-akun" role="tabpanel" aria-labelledby="tab-akun" hidden class="mt-4 sm:mt-6">
      <div class="grid items-start gap-4 sm:gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
      <div class="grid gap-4 sm:gap-6">
      <section aria-labelledby="masuk-judul" class={`grid overflow-hidden md:grid-cols-2 ${card}`}>
        <div class="p-5 sm:p-8">
          <h2 id="masuk-judul" class="text-xl font-bold tracking-tight">Email</h2>
          <p class="mt-1 text-sm text-zinc-400">Sekarang <span class="font-semibold text-zinc-200 break-all">{user.email}</span>. Email baru aktif setelah tautan di email lama dan baru sama-sama diklik.</p>
          <ActionForm client:load action="gantiEmail" className="mt-5 grid gap-4">
            <label class="text-sm text-zinc-400">
              Email baru
              <input type="email" name="email" required maxlength={254} autocomplete="email" class={`${field} mt-1`} />
            </label>
            <button class={`${primaryButton} justify-self-start`}>Kirim konfirmasi</button>
          </ActionForm>
        </div>
        <div id="sandi" class="scroll-mt-6 border-t-2 border-zinc-800 p-5 sm:p-8 md:border-t-0 md:border-l-2" aria-labelledby="sandi-judul" role="group">
          <h2 id="sandi-judul" class="text-xl font-bold tracking-tight">Password</h2>
          <p class="mt-1 text-sm text-zinc-400">Opsional, supaya bisa masuk tanpa menunggu email. Lupa? Masuk lewat link email, lalu buat yang baru di sini.</p>
          <ActionForm client:load action="aturSandi" className="mt-5 grid gap-4">
            <input type="email" name="username" autocomplete="username" value={user.email} readonly hidden />
            <label class="text-sm text-zinc-400">
              Password baru
              <PasswordInput client:load name="password" required minLength={8} maxLength={72} autoComplete="new-password" className={`${field} mt-1`} />
            </label>
            <label class="text-sm text-zinc-400">
              Ulangi password
              <PasswordInput client:load name="confirm" required minLength={8} maxLength={72} autoComplete="new-password" className={`${field} mt-1`} />
            </label>
            <button class={`${primaryButton} justify-self-start`}>Simpan password</button>
          </ActionForm>
        </div>
      </section>

      <section aria-labelledby="keamanan" class={`p-5 sm:p-8 ${card}`}>
        <h2 id="keamanan" class="text-xl font-bold tracking-tight">Keamanan</h2>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
          <span class="text-zinc-400">Masuk dengan</span>
          {(methods.length ? methods : ["Email"]).map((m) => <span class="inline-flex min-h-8 items-center rounded-full bg-zinc-800 px-3 font-bold">{m}</span>)}
          {canLink && (
            <form method="post" action={hasGoogle ? "/rpc/lepasGoogle" : "/rpc/hubungkanGoogle"} data-confirm={hasGoogle ? "Lepas Google?" : undefined} data-confirm-text={hasGoogle ? "Kamu tidak bisa lagi masuk dengan Google. Masuk lewat email tetap bisa." : undefined} data-confirm-action={hasGoogle ? "Lepas" : undefined}>
              <button disabled={hasGoogle && methods.length < 2} title={hasGoogle && methods.length < 2 ? "Google satu-satunya cara masukmu, jadi belum bisa dilepas." : undefined} class="min-h-8 cursor-pointer rounded-full border-2 border-dashed border-zinc-700 px-3 font-bold hover:bg-zinc-800 disabled:cursor-not-allowed disabled:opacity-50">{hasGoogle ? "Lepas Google" : "+ Hubungkan Google"}</button>
            </form>
          )}
        </div>

        {here && (
          <div class="mt-5 flex items-center gap-4 rounded-[20px] bg-tile-mint p-4 sm:p-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-noir text-on-noir">{here.hp ? <Smartphone aria-hidden className="size-5" /> : <Monitor aria-hidden className="size-5" />}</span>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-bold text-zinc-300">Perangkat ini</p>
              <p class="truncate text-lg font-extrabold">{here.nama}{here.model && <span class="font-semibold"> · {here.model}</span>}</p>
              <p class="text-xs text-zinc-300">Masuk {tgl(here.created_at)}{here.country && <> · {negara.of(here.country) ?? here.country}</>}</p>
            </div>
          </div>
        )}

        {others.length > 0 && (
          <>
            <h3 class="mt-6 text-sm font-bold text-zinc-300">Perangkat lain <span class="font-normal text-zinc-400">({others.length})</span></h3>
            <input type="checkbox" id="semua-perangkat" class="peer sr-only" aria-label="Tampilkan semua perangkat" />
            <ul class="mt-2 grid gap-2 text-sm peer-checked:[&>.extra]:flex">
              {others.map((x, i) => (
                <li class:list={["items-center gap-3 rounded-2xl border-2 border-zinc-800 px-3 py-2.5", i < 4 ? "flex" : "extra hidden"]}>
                  <span class="grid size-9 shrink-0 place-items-center rounded-full bg-zinc-800 text-zinc-300">{x.hp ? <Smartphone aria-hidden className="size-4" /> : <Monitor aria-hidden className="size-4" />}</span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate font-semibold">{x.nama}{x.model && <span class="font-normal text-zinc-400"> · {x.model}</span>}</p>
                    <p class="truncate text-xs text-zinc-400">Aktif {tgl(x.refreshed_at)}{x.country && <> · {negara.of(x.country) ?? x.country}</>}</p>
                  </div>
                  <form method="post" action="/rpc/keluarkanPerangkat" data-confirm="Keluarkan perangkat ini?" data-confirm-text="Perangkat itu langsung keluar dari akunmu. Progresmu tetap aman." data-confirm-action="Keluarkan">
                    <input type="hidden" name="id" value={x.id} />
                    <button class="min-h-10 shrink-0 cursor-pointer rounded-full border-2 border-noir px-3 text-xs font-bold hover:bg-zinc-800">Keluarkan</button>
                  </form>
                </li>
              ))}
            </ul>
            {others.length > 4 && <label for="semua-perangkat" class="mt-2 inline-flex min-h-10 cursor-pointer items-center text-sm font-bold underline peer-checked:hidden peer-focus-visible:outline-2">Tampilkan {others.length - 4} lainnya</label>}
          </>
        )}

        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t-2 border-zinc-800 pt-5">
          <p class="max-w-md text-sm text-zinc-400">Pakai perangkat bersama atau merasa akun dipakai orang lain? Keluarkan semua, lalu masuk lagi di perangkatmu.</p>
          <SignOutButton all label class="min-h-11 shrink-0 cursor-pointer rounded-full border-2 border-noir px-5 text-sm font-bold hover:bg-zinc-800" />
        </div>
      </section>

      </div>
      <div class="grid gap-4 sm:gap-6">
      <section aria-labelledby="ekspor" class="h-full rounded-[18px] bg-tile-lavender p-5 sm:p-8">
        <h2 id="ekspor" class="text-xl font-bold tracking-tight">Ekspor data</h2>
        <p class="mt-1 mb-4 text-sm text-zinc-300">Semua data belajarmu dalam satu file JSON: progres, latihan, flashcard, ujian, badge, sertifikat, dan streak.</p>
        <ExportButton client:load />
      </section>

      <section aria-labelledby="hapus" class="h-full rounded-[18px] bg-tile-pink p-5 sm:p-8">
        <h2 id="hapus" class="text-xl font-bold tracking-tight">Hapus akun</h2>
        <p class="mt-1 text-sm text-zinc-400">
          Semua data belajarmu ikut terhapus dan tidak bisa dikembalikan. Ketik email akunmu untuk memastikan.
        </p>
        <ActionForm client:load action="hapusAkun" className="mt-4 grid gap-2" data-confirm="Hapus akun ini?" data-confirm-text="Semua progres, nilai, flashcard, dan sertifikatmu ikut terhapus. Ini tidak bisa dibatalkan." data-confirm-action="Ya, hapus akun" data-confirm-danger>
          <input name="email" type="email" required autocomplete="off" aria-label="Email akun" placeholder={user.email} class={field} />
          <button class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-red-600 px-6 font-semibold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
            <Trash2 aria-hidden className="size-4" />
            Hapus akun
          </button>
        </ActionForm>
      </section>
      </div>
      </div>
      </div>
    </div>
  </main>
  </div>
</Base>

<script>
  // Three tabs, no routing: #rekap opens Rekap, #akun and #sandi (password mails) open Akun, anything else Umum.
  const tabs = ["umum", "rekap", "akun"];
  const show = (name: string) => {
    for (const t of tabs) {
      document.getElementById(`tab-${t}`)?.setAttribute("aria-selected", String(t === name));
      document.getElementById(`tab-${t}`)?.setAttribute("tabindex", t === name ? "0" : "-1");
      document.getElementById(`panel-${t}`)!.hidden = t !== name;
    }
  };
  for (const t of tabs) {
    document.getElementById(`tab-${t}`)?.addEventListener("click", () => {
      show(t);
      history.replaceState(null, "", t === "umum" ? location.pathname : `#${t}`);
    });
  }
  const sync = () => {
    const h = location.hash;
    show(h === "#rekap" ? "rekap" : h === "#akun" || h === "#sandi" ? "akun" : "umum");
    if (h && h !== "#rekap" && h !== "#akun") document.getElementById(location.hash.slice(1))?.scrollIntoView();
  };
  addEventListener("hashchange", sync);
  sync();
</script>
