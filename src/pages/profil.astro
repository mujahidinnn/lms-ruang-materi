---
import Select from "@/components/ui/Select";
import { Trash2 } from "lucide-react";
import ActionForm from "@/components/admin/ActionForm";
import { field } from "@/components/admin/editor";
import AjakTeman from "@/components/profil/AjakTeman";
import ExportButton from "@/components/dashboard/ExportButton";
import { card, primaryButton } from "@/components/ui/styles";
import { SITE_URL } from "@/lib/site";
import { createClient } from "@/lib/supabase/server";
import Recap, { type Recap as RecapData } from "../components/Recap.astro";
import SignOutButton from "../components/SignOutButton.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { signedIn } from "../lib/guard";

const INDONESIA = ["Asia/Jakarta", "Asia/Makassar", "Asia/Jayapura"];
const ZONES = [...INDONESIA, ...Intl.supportedValuesOf("timeZone").filter((z) => !INDONESIA.includes(z))];

const user = await signedIn(Astro);
if (user instanceof Response) return user;
const db = await createClient();
const [{ data: p }, { data: refRow }, { data: recap }, { data: st }, { data: certs }, { data: bdg }] = await Promise.all([
  db.from("profiles").select("display_name, timezone, guardian_consent, age_group, announce_email").eq("user_id", user.id).single(),
  db.rpc("my_referral").maybeSingle(),
  db.rpc("admin_user_recap", { target: user.id }),
  db.from("learning_streaks").select("current_days, best_days").eq("user_id", user.id).maybeSingle(),
  db.from("certificates").select("code, topics(title)").eq("user_id", user.id).order("issued_at"),
  db.from("badges").select("tracks(title)").eq("user_id", user.id),
]);
const wins = {
  certs: ((certs ?? []) as unknown as { code: string; topics: { title: string } | null }[]).map((c) => ({ code: c.code, title: c.topics?.title ?? "Kelas" })),
  badges: ((bdg ?? []) as unknown as { tracks: { title: string } | null }[]).flatMap((b) => (b.tracks ? [b.tracks.title] : [])),
};
const ref = refRow as { code: string; joined: number } | null;
const METODE: Record<string, string> = { email: "Email", google: "Google" };
const { data: ids } = await db.auth.getUserIdentities();
const methods = [...new Set((ids?.identities ?? []).map((i) => METODE[i.provider] ?? i.provider))];
const zone = p?.timezone ?? "Asia/Jakarta";
---

<Base title="Profil" description="Ubah nama dan zona waktu, unduh data belajarmu, atau hapus akun." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
    <div class="mx-auto max-w-7xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Profil</h1>
      {/* Phones and tablets: the side column dissolves into the grid (contents)
          so the identity card leads, the forms follow, and export and delete
          sit side by side on tablets. Wide screens keep two columns. */}
      <div role="tablist" aria-label="Bagian profil" class="mt-4 inline-flex rounded-full border-2 border-noir bg-zinc-900 p-1 text-sm font-bold">
        <button type="button" role="tab" id="tab-umum" aria-controls="panel-umum" aria-selected="true" class="min-h-10 cursor-pointer rounded-full px-5 aria-selected:bg-noir aria-selected:text-on-noir">Umum</button>
        <button type="button" role="tab" id="tab-rekap" aria-controls="panel-rekap" aria-selected="false" tabindex="-1" class="min-h-10 cursor-pointer rounded-full px-5 aria-selected:bg-noir aria-selected:text-on-noir">Rekap</button>
      </div>
      <div id="panel-rekap" role="tabpanel" aria-labelledby="tab-rekap" hidden class="mt-4">
        {recap ? <Recap recap={recap as RecapData} streak={{ current: st?.current_days ?? 0, best: st?.best_days ?? 0 }} wins={wins} /> : <p class="rounded-[18px] bg-zinc-900 p-8 text-center text-zinc-400 shadow-soft">Rekap belum tersedia.</p>}
      </div>
      <div id="panel-umum" role="tabpanel" aria-labelledby="tab-umum">
      <div class="mt-4 grid items-start gap-4 sm:mt-6 sm:gap-6 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_380px]">
      <div class="grid gap-4 sm:gap-6 sm:col-span-2 lg:col-span-1">

      <section aria-labelledby="data" class={`p-5 sm:p-8 ${card}`}>
        <h2 id="data" class="text-xl font-bold tracking-tight">Data diri</h2>
        <p class="mt-1 text-sm text-zinc-400">{user.email}</p>
        <ActionForm client:load action="simpanProfil" className="mt-4 grid gap-4" data-confirm="Cabut persetujuan?" data-confirm-text="Progres bab, kuis, dan latihan kode berhenti tersimpan sampai kamu memilih usia lagi." data-confirm-action="Cabut" data-confirm-if="usia=" data-confirm-danger>
          <label class="text-sm text-zinc-400">
            Nama tampilan
            <input name="display_name" maxlength={80} value={p?.display_name ?? ""} class={`${field} mt-1`} />
          </label>
          <label class="text-sm text-zinc-400">
            Zona waktu, untuk menghitung streak harian
            <Select client:load name="timezone" label="Zona waktu" value={zone} options={ZONES.map((z) => [z, z] as [string, string])} className="mt-1" />
          </label>
          <label class="flex min-h-11 items-center gap-3 text-sm text-zinc-300">
            <input type="checkbox" name="announce_email" checked={p?.announce_email ?? true} class="size-4 accent-[var(--color-brand)]" />
            Kirimi aku email pengumuman dari Ruang Materi
          </label>
          <fieldset class="grid gap-2 text-sm text-zinc-300">
            <legend class="mb-1 text-zinc-400">Usia dan persetujuan</legend>
            {[
              { value: "dewasa", label: "18 tahun ke atas, setuju dengan Kebijakan Privasi" },
              { value: "anak", label: "Di bawah 18 tahun, orang tua atau wali sudah mengizinkan" },
              { value: "", label: "Cabut persetujuan (progres berhenti tersimpan)" },
            ].map((c) => (
              <label class="flex min-h-11 items-start gap-3">
                <input type="radio" name="usia" value={c.value} checked={p?.guardian_consent ? (p?.age_group ?? "dewasa") === c.value : c.value === ""} class="mt-0.5 size-4 accent-(--accent)" />
                {c.label}
              </label>
            ))}
          </fieldset>
          <button class={`${primaryButton} justify-self-start`}>Simpan</button>
        </ActionForm>
      </section>

      {ref && (
        <section aria-labelledby="ajak" class={`p-5 sm:p-8 ${card}`}>
          <h2 id="ajak" class="text-xl font-bold tracking-tight">Ajak teman</h2>
          <p class="mt-1 text-sm text-zinc-400">
            Bagikan link ini. Temanmu mendaftar lewat link itu dan tercatat sebagai ajakanmu. Tidak ada email yang dikirim.
          </p>
          <AjakTeman client:load code={ref.code} joined={ref.joined} origin={SITE_URL} />
        </section>
      )}

      <section id="sandi" aria-labelledby="sandi-judul" class={`scroll-mt-6 p-5 sm:p-8 ${card}`}>
        <h2 id="sandi-judul" class="text-xl font-bold tracking-tight">Password</h2>
        <p class="mt-1 text-sm text-zinc-400">
          Opsional. Dengan password kamu bisa masuk tanpa menunggu email. Lupa? Masuk lewat link email, lalu buat yang baru di sini.
        </p>
        <ActionForm client:load action="aturSandi" className="mt-4 grid gap-4">
          <input type="email" name="username" autocomplete="username" value={user.email} readonly hidden />
          <label class="text-sm text-zinc-400">
            Password baru
            <input name="password" type="password" required minlength={8} maxlength={72} autocomplete="new-password" class={`${field} mt-1`} />
          </label>
          <label class="text-sm text-zinc-400">
            Ulangi password
            <input name="confirm" type="password" required minlength={8} maxlength={72} autocomplete="new-password" class={`${field} mt-1`} />
          </label>
          <button class={`${primaryButton} justify-self-start`}>Simpan password</button>
        </ActionForm>
      </section>

      <section aria-labelledby="keamanan" class={`p-5 sm:p-8 ${card}`}>
        <h2 id="keamanan" class="text-xl font-bold tracking-tight">Keamanan</h2>
        <p class="mt-1 text-sm text-zinc-400">Metode masuk: {methods.join(", ") || "Email"}</p>
        <p class="mt-3 text-sm text-zinc-400">Pakai perangkat bersama atau merasa akun dipakai orang lain? Keluarkan semua perangkat sekaligus, lalu masuk lagi di perangkatmu.</p>
        <div class="mt-4"><SignOutButton all label class="min-h-11 cursor-pointer rounded-full border-2 border-noir px-5 text-sm font-bold hover:bg-zinc-800" /></div>
      </section>

      </div>
      <aside class="contents lg:grid lg:gap-6">
      <div class="-order-1 flex items-end gap-4 overflow-hidden rounded-[18px] bg-noir px-5 pt-5 text-on-noir sm:col-span-2 lg:order-none lg:col-span-1">
        <div class="min-w-0 pb-5">
          <p class="truncate text-2xl font-extrabold">{p?.display_name || "Tanpa nama"}</p>
          <p class="truncate text-sm text-on-noir/60">{user.email}</p>
          <a href="/nilai" class="mt-4 inline-flex min-h-10 items-center rounded-full bg-matcha-300 px-4 text-sm font-bold text-noir">Lihat pencapaian</a>
        </div>
        <div class="ml-auto flex h-28 w-20 shrink-0 sm:h-36 sm:w-24 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-3"><img src="/ilustrasi/kode.svg" alt="" width="890" height="1220" class="h-full w-auto -scale-x-100" /></div>
      </div>
      <section aria-labelledby="ekspor" class="h-full rounded-[18px] bg-tile-sky p-5 sm:p-8 lg:h-auto">
        <h2 id="ekspor" class="text-xl font-bold tracking-tight">Ekspor data</h2>
        <p class="mt-1 mb-4 text-sm text-zinc-300">Semua data belajarmu dalam satu file JSON: progres, latihan, flashcard, ujian, dan badge.</p>
        <ExportButton client:load />
      </section>

      <section aria-labelledby="hapus" class="h-full rounded-[18px] bg-tile-pink p-5 sm:p-8 lg:h-auto">
        <h2 id="hapus" class="text-xl font-bold tracking-tight">Hapus akun</h2>
        <p class="mt-1 text-sm text-zinc-400">
          Semua data belajarmu ikut terhapus dan tidak bisa dikembalikan. Ketik email akunmu untuk memastikan.
        </p>
        <ActionForm client:load action="hapusAkun" className="mt-4 grid gap-2" data-confirm="Hapus akun ini?" data-confirm-text="Semua progres, nilai, flashcard, dan sertifikatmu ikut terhapus. Ini tidak bisa dibatalkan." data-confirm-action="Ya, hapus akun" data-confirm-danger>
          <input name="email" type="email" required autocomplete="off" aria-label="Email akun" placeholder={user.email} class={field} />
          <button class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-red-600 px-6 font-semibold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
            <Trash2 aria-hidden className="size-4" />
            Hapus akun
          </button>
        </ActionForm>
      </section>
      </aside>
      </div>
      </div>
    </div>
  </main>
  </div>
</Base>

<script>
  // Two tabs, no routing: #rekap opens Rekap, any other hash (e.g. #sandi) opens Umum.
  const tabs = ["umum", "rekap"];
  const show = (name: string) => {
    for (const t of tabs) {
      document.getElementById(`tab-${t}`)?.setAttribute("aria-selected", String(t === name));
      document.getElementById(`tab-${t}`)?.setAttribute("tabindex", t === name ? "0" : "-1");
      document.getElementById(`panel-${t}`)!.hidden = t !== name;
    }
  };
  for (const t of tabs) {
    document.getElementById(`tab-${t}`)?.addEventListener("click", () => {
      show(t);
      history.replaceState(null, "", t === "rekap" ? "#rekap" : location.pathname);
    });
  }
  const sync = () => {
    show(location.hash === "#rekap" ? "rekap" : "umum");
    if (location.hash && location.hash !== "#rekap") document.getElementById(location.hash.slice(1))?.scrollIntoView();
  };
  addEventListener("hashchange", sync);
  sync();
</script>
