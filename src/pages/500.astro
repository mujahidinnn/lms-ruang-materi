---
import { RotateCcw } from "lucide-react";
import { primaryButton } from "@/components/ui/styles";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";

// The error itself stays in the server log; the learner only needs a way out.
---

<Base title="Halaman ini gagal dimuat" noindex>
  <SiteHeader />
  <main class="flex flex-1 flex-col items-center justify-center px-6 py-20 text-center">
    <h1 class="text-3xl font-bold tracking-tight">Halaman ini gagal dimuat</h1>
    <p class="mt-2 max-w-sm text-zinc-400">
      Periksa koneksimu lalu muat ulang. Kalau masih gagal, kembali ke beranda dan coba lagi nanti.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
      <button type="button" onclick="location.reload()" class={primaryButton}><RotateCcw aria-hidden className="size-4" />Muat ulang</button>
      <a href="/" class="text-zinc-400 hover:text-zinc-50">Ke beranda</a>
    </div>
  </main>
</Base>
