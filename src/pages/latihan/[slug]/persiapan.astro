---
import PracticeQuiz from "@/components/quiz/PracticeQuiz";
import PracticeTabs from "@/components/quiz/PracticeTabs";
import { getPractice } from "@/lib/content";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../../../components/SiteHeader.astro";
import ClassSteps from "../../../components/ClassSteps.astro";
import PracticeRail from "../../../components/PracticeRail.astro";
import Base from "../../../layouts/Base.astro";
import { publicPage } from "../../../lib/cdn";

const SIZE = 20;

const slug = Astro.params.slug!;
const practice = await getPractice(slug);
if (!practice) return Astro.rewrite("/404");
publicPage(Astro);
const pool = [...practice.questions, ...practice.chapterQuestions];
---

<Base
  title={`Try out ${practice.title}`}
  description={`${SIZE} soal acak ${practice.title} dengan kunci dan pembahasan langsung, dinilai seperti ujian.`}
  canonical={`${SITE_URL}/latihan/${slug}/persiapan`}
>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader learning focus />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <ClassSteps slug={slug} current="latihan" />
        <h1 class="mt-4 mb-5 text-4xl font-bold tracking-tight sm:text-5xl">Latihan ujian</h1>
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
        <div>
        <PracticeTabs slug={slug} current="persiapan" />
        {pool.length === 0 ? (
          <p class="text-zinc-400">
            Soal untuk try out belum tersedia.{" "}
            <a href={`/belajar/${slug}`} class="text-accent hover:underline">Kembali ke materi</a>
          </p>
        ) : (
          <PracticeQuiz client:load topicId={practice.id} slug={slug} questions={pool} hasExam={practice.hasExam} prep={{ passScore: practice.passScore ?? 70, size: SIZE }} />
        )}
        </div>
        <PracticeRail slug={slug} title={practice.title} count={pool.length} mode="persiapan" hasExam={practice.hasExam} passScore={practice.passScore} />
        </div>
      </div>
    </main>
  </div>
</Base>
