---
import { Award, BookOpen, ExternalLink, Flame, Medal } from "lucide-react";
import { card } from "@/components/ui/styles";
import { STUDIO_TITLES } from "@/lib/studio/portofolio";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";

const handle = Astro.params.handle ?? "";
const { data } = await (await createClient()).rpc("public_profile", { p_handle: handle });
const p = data as { name: string; certificates: { code: string; title: string; issued_at: string }[]; badges: string[]; studio: { project: string; url: string }[]; chapters: number; best_streak: number } | null;
if (!p) return Astro.rewrite("/404");
const tgl = new Intl.DateTimeFormat("id-ID", { month: "long", year: "numeric", timeZone: "Asia/Jakarta" });
const stat = `${card} flex items-center gap-3 p-4`;
---

<Base title={`${p.name} · Profil belajar`} description={`Sertifikat dan pencapaian belajar ${p.name} di Ruang Materi.`} noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm font-semibold text-zinc-400">Profil belajar</p>
        <h1 class="mt-1 text-3xl font-extrabold sm:text-5xl">{p.name}</h1>
        <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
          <li class={stat}><BookOpen aria-hidden className="size-6" /><span><b class="block text-xl tabular-nums">{p.chapters}</b><span class="text-sm text-zinc-400">bab selesai</span></span></li>
          <li class={stat}><Award aria-hidden className="size-6" /><span><b class="block text-xl tabular-nums">{p.certificates.length}</b><span class="text-sm text-zinc-400">sertifikat</span></span></li>
          <li class={stat}><Flame aria-hidden className="size-6" /><span><b class="block text-xl tabular-nums">{p.best_streak}</b><span class="text-sm text-zinc-400">hari beruntun terbaik</span></span></li>
        </ul>

        {p.certificates.length > 0 && (
          <section aria-labelledby="sertif" class="mt-10">
            <h2 id="sertif" class="text-xl font-extrabold">Sertifikat</h2>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {p.certificates.map((c) => (
                <li><a href={`/sertifikat/${c.code}`} class={`block p-4 hover:bg-zinc-800 sm:p-5 ${card}`}><span class="font-bold">{c.title}</span><span class="mt-1 block text-sm text-zinc-400">{tgl.format(new Date(c.issued_at))}, bisa dicek keasliannya</span></a></li>
              ))}
            </ul>
          </section>
        )}
        {p.studio.length > 0 && (
          <section aria-labelledby="karya" class="mt-10">
            <h2 id="karya" class="text-xl font-extrabold">Karya</h2>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {p.studio.map((w) => (
                <li><a href={w.url} target="_blank" rel="nofollow noopener noreferrer ugc" class={`flex items-center justify-between gap-3 p-4 hover:bg-zinc-800 sm:p-5 ${card}`}><span class="min-w-0"><span class="block font-bold">{STUDIO_TITLES[w.project] ?? w.project}</span><span class="mt-1 block truncate text-sm text-zinc-400">{new URL(w.url).host}</span></span><ExternalLink aria-hidden className="size-5 shrink-0" /></a></li>
              ))}
            </ul>
          </section>
        )}
        {p.badges.length > 0 && (
          <section aria-labelledby="lencana" class="mt-10">
            <h2 id="lencana" class="text-xl font-extrabold">Lencana roadmap</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {p.badges.map((b) => <li class="inline-flex min-h-10 items-center gap-2 rounded-full bg-tile-mint px-4 text-sm font-semibold text-zinc-50"><Medal aria-hidden className="size-4" />{b}</li>)}
            </ul>
          </section>
        )}
      </div>
    </main>
  </div>
</Base>
