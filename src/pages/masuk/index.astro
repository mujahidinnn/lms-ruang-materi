---
import MasukForm from "@/components/auth/MasukForm";
import { getCurrentUser } from "@/lib/dal";
import { safeNext } from "@/lib/safe-next";
import AuthShell from "../../components/AuthShell.astro";
import GoogleButton from "../../components/GoogleButton.astro";
import Base from "../../layouts/Base.astro";

const next = safeNext(Astro.url.searchParams.get("next"), "/dasbor");
// Already signed in: straight on.
if (await getCurrentUser()) return Astro.redirect(next);
const galat = Astro.url.searchParams.get("galat") === "1";
const galatGoogle = Astro.url.searchParams.get("galat") === "google";
---

<Base title="Masuk" description="Masuk ke Ruang Materi untuk melanjutkan belajar dan menyimpan progres." noindex>
  <AuthShell current="masuk" next={next}>
    <GoogleButton next={next} label="Masuk dengan Google" />
    {galatGoogle && <p role="alert" class="mb-4 rounded-2xl bg-tile-pink px-4 py-3 text-sm">Masuk dengan Google gagal. Coba sekali lagi, atau pakai email.</p>}
    <MasukForm client:load next={next} galat={galat} />
  </AuthShell>
</Base>
