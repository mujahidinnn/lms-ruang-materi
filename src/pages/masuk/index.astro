---
import MasukForm from "@/components/auth/MasukForm";
import Logo from "@/components/brand/Logo";
import { SignIn } from "@/components/illustrations";
import { safeNext } from "@/lib/safe-next";
import Base from "../../layouts/Base.astro";

const next = safeNext(Astro.url.searchParams.get("next"));
const galat = Astro.url.searchParams.get("galat") === "1";
---

<Base title="Masuk" description="Masuk ke Ruang Materi dengan tautan dari email untuk menyimpan progres belajar kamu." noindex>
  <main class="relative flex flex-1 flex-col justify-center px-5 py-10">
    <div class="mx-auto flex w-full max-w-md flex-col gap-6">
      <a href="/" aria-label="Ruang Materi, beranda" class="w-fit">
        <Logo />
      </a>
      <div class="rounded-[32px] bg-tile-lavender p-6 sm:p-8">
        <SignIn className="size-20" />
        <h1 class="mt-4 text-4xl font-bold tracking-tight">Masuk</h1>
        <p class="mt-2 text-sm text-zinc-300">Pakai kata sandi, atau kosongkan dan kami kirim tautan masuk ke email kamu.</p>
      </div>
      <div class="rounded-[32px] bg-zinc-900 p-6 shadow-soft sm:p-8">
        <MasukForm client:load next={next} galat={galat} />
      </div>
    </div>
  </main>
</Base>
