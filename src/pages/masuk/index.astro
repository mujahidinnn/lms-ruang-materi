---
import { Award, Check, Flame, Save } from "lucide-react";
import MasukForm from "@/components/auth/MasukForm";
import { sticker } from "@/components/ui/styles";
import { safeNext } from "@/lib/safe-next";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";

const next = safeNext(Astro.url.searchParams.get("next"));
const galat = Astro.url.searchParams.get("galat") === "1";
const PERKS = [
  { Icon: Save, text: "Progres bab, kuis, dan latihan kode tersimpan" },
  { Icon: Award, text: "Sertifikat dengan namamu setelah lulus" },
  { Icon: Flame, text: "Streak harian dan flashcard yang dijadwalkan" },
];
---

<Base title="Masuk" description="Masuk atau daftar ke Ruang Materi dengan email untuk menyimpan progres belajar kamu." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex flex-1 items-center px-5 pb-20 sm:px-10">
      <div class="mx-auto grid w-full max-w-5xl items-stretch gap-6 lg:grid-cols-[1.1fr_1fr]">
        <section class="relative overflow-hidden rounded-[32px] bg-noir p-6 text-on-noir ring-1 ring-zinc-800 sm:p-10">
          <span aria-hidden="true" class={`${sticker} inline-flex -rotate-3 bg-matcha-300 text-noir shadow-[3px_3px_0_0_var(--color-on-noir)]`}>gratis</span>
          <h1 class="mt-5 text-4xl leading-tight font-extrabold sm:text-5xl">Masuk atau daftar</h1>
          <p class="mt-3 max-w-sm text-on-noir/75 sm:pr-24">Satu langkah yang sama. Cukup email, tanpa formulir panjang.</p>
          <ul class="mt-6 grid max-w-sm gap-3 sm:pr-36 lg:pr-32">
            {PERKS.map(({ Icon, text }) => (
              <li class="flex items-center gap-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-matcha-300 text-noir"><Icon aria-hidden className="size-4" /></span>
                <span class="text-sm">{text}</span>
              </li>
            ))}
          </ul>
          <div aria-hidden="true" class="pointer-events-none absolute right-6 -bottom-2 hidden h-56 w-36 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-4 sm:flex">
            <img src="/ilustrasi/kode.svg" alt="" width="890" height="1220" class="h-full w-auto" />
          </div>
        </section>
        <div class="flex flex-col justify-center rounded-[32px] bg-zinc-900 p-6 shadow-soft sm:p-8">
          <MasukForm client:load next={next} galat={galat} />
          <p class="mt-2 flex items-center gap-2 border-t border-zinc-800 pt-4 text-sm text-zinc-400">
            <Check aria-hidden className="size-4 shrink-0 text-accent" />
            <span>Mau lihat-lihat dulu? <a href="/kelas" class="font-semibold text-accent hover:underline">Semua materi bisa dibaca tanpa akun</a>.</span>
          </p>
        </div>
      </div>
    </main>
  </div>
</Base>
