---
import MasukForm from "@/components/auth/MasukForm";
import Logo from "@/components/brand/Logo";
import { Welcome } from "@/components/illustrations";
import { sticker } from "@/components/ui/styles";
import { safeNext } from "@/lib/safe-next";
import Base from "../../layouts/Base.astro";

const next = safeNext(Astro.url.searchParams.get("next"));
const galat = Astro.url.searchParams.get("galat") === "1";
---

<Base title="Masuk" description="Masuk ke Ruang Materi dengan tautan dari email untuk menyimpan progres belajar kamu." noindex>
  <main class="relative flex flex-1 flex-col justify-center px-5 py-10">
    <div class="mx-auto flex w-full max-w-md flex-col gap-6">
      <a href="/" aria-label="Ruang Materi, beranda" class="w-fit">
        <Logo />
      </a>
      <div class="relative overflow-hidden rounded-[32px] bg-noir p-6 pt-20 text-on-noir ring-1 ring-zinc-800 sm:p-8 sm:pt-24">
        <div aria-hidden="true" class="pointer-events-none select-none">
          <span class={`${sticker} absolute top-5 left-5 inline-flex -rotate-6 bg-matcha-300 text-noir shadow-[3px_3px_0_0_var(--color-on-noir)]`}>hai!</span>
          <span class={`${sticker} absolute top-7 left-28 inline-flex rotate-3 bg-matcha-50 text-noir shadow-[3px_3px_0_0_var(--color-on-noir)]`}>yuk belajar</span>
          <span class={`${sticker} absolute top-16 right-24 hidden rotate-6 bg-matcha-600 text-matcha-50 shadow-[3px_3px_0_0_var(--color-on-noir)] sm:inline-flex`}>gratis</span>
          <Welcome className="absolute -top-2 -right-3 size-28 rotate-12" />
        </div>
        <h1 class="relative text-5xl font-extrabold">Masuk</h1>
        <p class="relative mt-2 text-sm text-on-noir/70">Pakai kata sandi, atau kosongkan dan kami kirim tautan masuk ke email kamu.</p>
      </div>
      <div class="rounded-[32px] bg-zinc-900 p-6 shadow-soft sm:p-8">
        <MasukForm client:load next={next} galat={galat} />
      </div>
    </div>
  </main>
</Base>
