---
import Playground from "@/components/code/Playground";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { publicPage } from "../lib/cdn";

publicPage(Astro);
---

<Base title="Playground kode" description="Tulis dan jalankan HTML, CSS, JavaScript, atau Python langsung di browser, tanpa daftar." canonical={`${SITE_URL}/playground`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <h1 class="text-3xl font-extrabold sm:text-5xl">Playground kode</h1>
        <p class="mt-2 max-w-xl text-zinc-400">Coba kode bebas tanpa soal. Pilih bahasa, tulis, lalu jalankan. Kodemu tersimpan di browser ini saja.</p>
        <div class="mt-6"><Playground client:load /></div>
      </div>
    </main>
  </div>
</Base>
