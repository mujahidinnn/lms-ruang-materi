---
import { field } from "@/components/admin/editor";
import { primaryButton, sticker } from "@/components/ui/styles";
import { safeNext } from "@/lib/safe-next";
import { createClient } from "@/lib/supabase/server";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { signedIn } from "../../lib/guard";

// Once after the first sign-in: the name certificates show and the guardian
// consent progress saving needs (require_consent), on one screen, so
// progress is never dropped silently. Dashboard sends learners here.
const user = await signedIn(Astro);
if (user instanceof Response) return user;
const next = safeNext(Astro.url.searchParams.get("next"), "/dasbor");
const db = await createClient();
const { data: me } = await db.from("profiles").select("display_name, guardian_consent, age_group").eq("user_id", user.id).single();
if (me?.display_name?.trim() && me.guardian_consent && me.age_group) return Astro.redirect(next);
const galat = Astro.url.searchParams.get("galat") === "1";
// A Google account already has a name: offer it, editable.
const { data: au } = await db.auth.getUser();
const fromGoogle = ((au.user?.user_metadata?.full_name ?? au.user?.user_metadata?.name) as string | undefined)?.trim().slice(0, 80);
const nama = me?.display_name?.trim() || fromGoogle || "";
---

<Base title="Mulai" description="Isi nama dan persetujuan supaya progres belajarmu tersimpan." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto grid max-w-5xl items-stretch gap-6 lg:grid-cols-2">
        <div class="relative min-h-72 overflow-hidden rounded-[32px] bg-noir p-6 pt-16 text-on-noir ring-1 ring-zinc-800 sm:p-8 sm:pt-20">
          <span aria-hidden="true" class={`${sticker} absolute top-5 left-6 inline-flex -rotate-3 bg-matcha-300 text-noir`}>satu langkah lagi</span>
          <div class="absolute right-6 bottom-0 hidden h-56 w-36 lg:h-72 lg:w-44 items-end justify-center overflow-hidden rounded-t-full bg-matcha-300 pt-3 sm:flex"><img src="/ilustrasi/mulai.svg" alt="" width="1115" height="2949" loading="lazy" decoding="async" class="h-full w-auto" /></div>
          <h1 class="relative text-4xl font-extrabold sm:pr-28">Sebelum mulai</h1>
          <p class="relative mt-2 text-on-noir/75 sm:pr-28">{nama ? "Tinggal pilih usiamu, sekali saja." : "Isi nama dan pilih usiamu, sekali saja."} Setelah itu semua progres, kuis, dan latihan kodemu tersimpan.</p>
        </div>
        <form method="post" action="/rpc/mulai" class="grid content-center gap-5 rounded-[32px] bg-zinc-900 p-6 shadow-soft sm:p-8">
          <input type="hidden" name="next" value={next} />
          {galat && <p role="alert" class="rounded-2xl bg-tile-pink px-4 py-3 text-sm text-noir">Isi nama dan pilih salah satu pilihan usia dulu.</p>}
          <label class="text-sm font-medium text-zinc-300">
            Nama tampilan
            <span class="block text-xs font-normal text-zinc-500">{nama && !me?.display_name?.trim() ? "Dari akun Google-mu. Boleh diubah, misalnya ke nama panggilan." : "Dipakai di sertifikat. Boleh nama panggilan."}</span>
            <input name="display_name" required maxlength="80" value={nama} class={`${field} mt-2`} />
          </label>
          <fieldset class="grid gap-2">
            <legend class="mb-2 text-sm font-medium text-zinc-300">Usia</legend>
            {[
  { value: "dewasa", title: "Saya berusia 18 tahun ke atas", text: "dan setuju dengan Kebijakan Privasi." },
  { value: "anak", title: "Saya di bawah 18 tahun", text: "dan orang tua atau wali saya sudah mengizinkan." },
].map((c) => (
              <label class="flex cursor-pointer items-start gap-3 rounded-2xl border-2 border-transparent bg-zinc-800/60 p-4 text-sm text-zinc-300 has-checked:border-noir has-checked:bg-matcha-100 has-checked:text-noir">
                <input type="radio" name="usia" value={c.value} required checked={me?.age_group === c.value} class="mt-0.5 size-5 shrink-0 accent-(--accent)" />
                <span><span class="block font-semibold">{c.title}</span>{c.text}</span>
              </label>
            ))}
          </fieldset>
          <button class={primaryButton}>Simpan dan mulai belajar</button>
          <p class="text-xs text-zinc-500">Bisa diubah kapan saja di Profil. Data yang disimpan dijelaskan di <a href="/privasi" class="text-accent underline">Kebijakan Privasi</a>.</p>
        </form>
      </div>
    </main>
  </div>
</Base>
