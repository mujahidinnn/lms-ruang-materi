---
import EmptyState from "../components/EmptyState.astro";
import { BookOpen, FileText, Search } from "lucide-react";
import { card } from "@/components/ui/styles";
import { field } from "@/components/admin/editor";
import { cleanQuery, searchContent } from "@/lib/content";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";

const q = cleanQuery(Astro.url.searchParams.get("q") ?? "");
const hits = await searchContent(q);
const kelas = hits.filter((h) => h.kind === "kelas");
const bab = hits.filter((h) => h.kind === "bab");
---

<Base title={q ? `Cari: ${q}` : "Cari"} description="Cari kelas dan bab di Ruang Materi." noindex>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <h1 class="text-3xl font-extrabold sm:text-5xl">Cari materi</h1>
        <form action="/cari" role="search" class="mt-5 flex gap-2">
          <label class="min-w-0 flex-1">
            <span class="sr-only">Kata kunci</span>
            <input name="q" value={q} type="search" maxlength="60" placeholder="Contoh: flexbox, SELECT, git merge" autofocus={!q} class={`${field} w-full`} />
          </label>
          <button class="inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-noir bg-matcha-300 px-5 font-bold text-noir"><Search aria-hidden className="size-4" />Cari</button>
        </form>

        {q.length >= 2 && hits.length === 0 && <EmptyState title={`Tidak ada hasil untuk "${q}"`} class="mt-8">Coba kata lain yang lebih pendek.</EmptyState>}
        {q.length === 1 && <p class="mt-8 text-zinc-400">Ketik minimal 2 huruf.</p>}

        {kelas.length > 0 && (
          <section aria-labelledby="hasil-kelas" class="mt-8">
            <h2 id="hasil-kelas" class="flex items-center gap-2 text-lg font-extrabold"><BookOpen aria-hidden className="size-5" />Kelas ({kelas.length})</h2>
            <ul class="mt-3 grid gap-3">
              {kelas.map((h) => (
                <li><a href={h.href} class={`block p-4 hover:bg-zinc-800 sm:p-5 ${card}`}><span class="font-bold">{h.title}</span>{h.snippet && <span class="mt-1 block text-sm text-zinc-400">{h.snippet}</span>}</a></li>
              ))}
            </ul>
          </section>
        )}
        {bab.length > 0 && (
          <section aria-labelledby="hasil-bab" class="mt-8">
            <h2 id="hasil-bab" class="flex items-center gap-2 text-lg font-extrabold"><FileText aria-hidden className="size-5" />Bab ({bab.length})</h2>
            <ul class="mt-3 grid gap-3">
              {bab.map((h) => (
                <li><a href={h.href} class={`block p-4 hover:bg-zinc-800 sm:p-5 ${card}`}><span class="text-xs font-semibold text-zinc-400">{h.context}</span><span class="block font-bold">{h.title}</span>{h.snippet && <span class="mt-1 block text-sm text-zinc-400">{h.snippet}</span>}</a></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </main>
  </div>
</Base>
