---
import TemplateGallery from "@/components/TemplateGallery";
import { templates } from "@/data/templates";
import { SITE_URL } from "@/lib/site";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { publicPage } from "../../lib/cdn";

publicPage(Astro);
---

<Base title="Template HTML" description="Template portfolio HTML, CSS dan JavaScript gratis. Lihat preview langsung, lalu unduh atau salin kodenya." canonical={`${SITE_URL}/template`}>
  <div class="relative flex flex-1 flex-col">
    <SiteHeader />
    <main class="flex-1 px-5 pb-20 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-xl">
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Template HTML</h1>
          <p class="mt-2 text-zinc-400">Lihat preview langsung, lalu unduh kodenya untuk kamu pakai dan ubah sendiri.</p>
        </div>
        <TemplateGallery client:load templates={templates} />
      </div>
    </main>
  </div>
</Base>
