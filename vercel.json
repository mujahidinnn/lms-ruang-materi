{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "regions": [
    "icn1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lms-ruang-materi.vercel.app"
        }
      ],
      "destination": "https://ruang-materi.mujahidin.my.id/:path*",
      "permanent": true
    },
    {
      "source": "/template",
      "destination": "/",
      "permanent": true
    }
  ]
}
